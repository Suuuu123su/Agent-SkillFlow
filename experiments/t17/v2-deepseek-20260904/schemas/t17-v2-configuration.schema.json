{
  "$defs": {
    "AuthorizationCondition": {
      "description": "实验中被暴露的授权来源条件。",
      "enum": [
        "none",
        "implicit_text",
        "structured_confirmation"
      ],
      "title": "AuthorizationCondition",
      "type": "string"
    },
    "CapabilityAction": {
      "description": "MVP 固定支持的能力动作。",
      "enum": [
        "file.read",
        "file.write",
        "memory.read",
        "memory.write",
        "network.send",
        "shell.execute",
        "user.confirm"
      ],
      "title": "CapabilityAction",
      "type": "string"
    },
    "CapabilityEffect": {
      "additionalProperties": false,
      "description": "可比较的结构化能力效果。",
      "properties": {
        "action": {
          "$ref": "#/$defs/CapabilityAction"
        },
        "lifetime": {
          "$ref": "#/$defs/Lifetime"
        },
        "scope": {
          "$ref": "#/$defs/Scope"
        },
        "sensitivity": {
          "maximum": 4,
          "minimum": 0,
          "title": "Sensitivity",
          "type": "integer"
        },
        "sink": {
          "$ref": "#/$defs/ResourceRef"
        },
        "source": {
          "anyOf": [
            {
              "$ref": "#/$defs/ResourceRef"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "source",
        "action",
        "sink",
        "scope",
        "lifetime",
        "sensitivity"
      ],
      "title": "CapabilityEffect",
      "type": "object"
    },
    "CatalogCondition": {
      "additionalProperties": false,
      "description": "目录中一项技能在预注册环境下的任务配置。",
      "properties": {
        "configuration": {
          "$ref": "#/$defs/ExperimentVariant"
        },
        "skill_variant_id": {
          "minLength": 1,
          "title": "Skill Variant Id",
          "type": "string"
        }
      },
      "required": [
        "skill_variant_id",
        "configuration"
      ],
      "title": "CatalogCondition",
      "type": "object"
    },
    "ClaimActionSpec": {
      "additionalProperties": false,
      "description": "声明必须来自指定真实输入及其内容哈希，不能凭场景名判定。",
      "properties": {
        "action_id": {
          "minLength": 1,
          "title": "Action Id",
          "type": "string"
        },
        "actor_id": {
          "minLength": 1,
          "title": "Actor Id",
          "type": "string"
        },
        "expected_content_hash": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Expected Content Hash",
          "type": "string"
        },
        "input_index": {
          "minimum": 0,
          "title": "Input Index",
          "type": "integer"
        },
        "requested_effect": {
          "$ref": "#/$defs/CapabilityEffect"
        }
      },
      "required": [
        "actor_id",
        "action_id",
        "input_index",
        "expected_content_hash",
        "requested_effect"
      ],
      "title": "ClaimActionSpec",
      "type": "object"
    },
    "EffectSelector": {
      "additionalProperties": false,
      "description": "把运行期多个 EffectRecord 映射到稳定别名。",
      "properties": {
        "action": {
          "$ref": "#/$defs/CapabilityAction"
        },
        "alias": {
          "minLength": 1,
          "title": "Alias",
          "type": "string"
        },
        "sink_pattern": {
          "$ref": "#/$defs/ResourceRef"
        },
        "source_pattern": {
          "anyOf": [
            {
              "$ref": "#/$defs/ResourceRef"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "alias",
        "action",
        "source_pattern",
        "sink_pattern"
      ],
      "title": "EffectSelector",
      "type": "object"
    },
    "EnforcementMode": {
      "description": "策略只观察或实际阻断。",
      "enum": [
        "monitor",
        "enforce"
      ],
      "title": "EnforcementMode",
      "type": "string"
    },
    "ExperimentVariant": {
      "additionalProperties": false,
      "description": "一个 Scenario 与受控 Harness 开关的确定性配置。",
      "properties": {
        "authorization_condition": {
          "$ref": "#/$defs/AuthorizationCondition",
          "default": "none"
        },
        "auto_approve_tools": {
          "title": "Auto Approve Tools",
          "type": "boolean"
        },
        "enforcement_mode": {
          "$ref": "#/$defs/EnforcementMode"
        },
        "harm_selector": {
          "anyOf": [
            {
              "$ref": "#/$defs/EffectSelector"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "hiaa_cell": {
          "anyOf": [
            {
              "$ref": "#/$defs/HiaaCell"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "hiaa_design_id": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Hiaa Design Id"
        },
        "implicit_text_authorization": {
          "title": "Implicit Text Authorization",
          "type": "boolean"
        },
        "pair_id": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Pair Id"
        },
        "persistent_memory": {
          "title": "Persistent Memory",
          "type": "boolean"
        },
        "provenance_mode": {
          "$ref": "#/$defs/ProvenanceMode"
        },
        "run_role": {
          "$ref": "#/$defs/MatrixRunRole",
          "default": "core"
        },
        "scenario": {
          "$ref": "#/$defs/ScenarioPath"
        },
        "seed": {
          "title": "Seed",
          "type": "integer"
        },
        "session_condition": {
          "$ref": "#/$defs/SessionCondition",
          "default": "original"
        },
        "shared_context": {
          "title": "Shared Context",
          "type": "boolean"
        },
        "skill_state": {
          "$ref": "#/$defs/SkillStateCondition",
          "default": "normal"
        },
        "target_skill_present": {
          "title": "Target Skill Present",
          "type": "boolean"
        },
        "variant": {
          "minLength": 1,
          "title": "Variant",
          "type": "string"
        }
      },
      "required": [
        "variant",
        "scenario",
        "seed",
        "target_skill_present",
        "shared_context",
        "persistent_memory",
        "auto_approve_tools",
        "enforcement_mode",
        "provenance_mode",
        "implicit_text_authorization"
      ],
      "title": "ExperimentVariant",
      "type": "object"
    },
    "HarnessFeature": {
      "description": "首版可做开关对照的 Harness 布尔特性。",
      "enum": [
        "shared_context",
        "persistent_memory",
        "auto_approve_tools",
        "implicit_text_authorization"
      ],
      "title": "HarnessFeature",
      "type": "string"
    },
    "HiaaCell": {
      "description": "目标 Skill 与 Harness 特性的四格组合。",
      "enum": [
        "p00",
        "p01",
        "p10",
        "p11"
      ],
      "title": "HiaaCell",
      "type": "string"
    },
    "HiaaDesign": {
      "additionalProperties": false,
      "description": "自动生成四格矩阵所需的全部预注册控制条件。",
      "properties": {
        "auto_approve_tools": {
          "title": "Auto Approve Tools",
          "type": "boolean"
        },
        "enforcement_mode": {
          "$ref": "#/$defs/EnforcementMode"
        },
        "feature": {
          "$ref": "#/$defs/HarnessFeature"
        },
        "harm_selector": {
          "$ref": "#/$defs/EffectSelector"
        },
        "id": {
          "minLength": 1,
          "title": "Id",
          "type": "string"
        },
        "implicit_text_authorization": {
          "title": "Implicit Text Authorization",
          "type": "boolean"
        },
        "neutral_scenario": {
          "$ref": "#/$defs/ScenarioPath"
        },
        "persistent_memory": {
          "title": "Persistent Memory",
          "type": "boolean"
        },
        "provenance_mode": {
          "$ref": "#/$defs/ProvenanceMode"
        },
        "schema_version": {
          "minLength": 1,
          "title": "Schema Version",
          "type": "string"
        },
        "seed": {
          "title": "Seed",
          "type": "integer"
        },
        "shared_context": {
          "title": "Shared Context",
          "type": "boolean"
        },
        "skill_pair": {
          "$ref": "#/$defs/NeutralSkillPair"
        },
        "target_scenario": {
          "$ref": "#/$defs/ScenarioPath"
        }
      },
      "required": [
        "schema_version",
        "id",
        "target_scenario",
        "neutral_scenario",
        "seed",
        "feature",
        "harm_selector",
        "skill_pair",
        "shared_context",
        "persistent_memory",
        "auto_approve_tools",
        "enforcement_mode",
        "provenance_mode",
        "implicit_text_authorization"
      ],
      "title": "HiaaDesign",
      "type": "object"
    },
    "HookName": {
      "description": "T17 Reference Harness 必须显式声明的证据 Hook。",
      "enum": [
        "authorization",
        "decision_basis",
        "provenance",
        "influence",
        "revocation",
        "task_success"
      ],
      "title": "HookName",
      "type": "string"
    },
    "Lifetime": {
      "description": "授权或效果的有效边界。",
      "enum": [
        "call",
        "task",
        "session",
        "persistent"
      ],
      "title": "Lifetime",
      "type": "string"
    },
    "MatrixRunRole": {
      "description": "核心变体与不得进入普通分母的派生 Run。",
      "enum": [
        "core",
        "determinism_repeat",
        "counterfactual"
      ],
      "title": "MatrixRunRole",
      "type": "string"
    },
    "NeutralSkillPair": {
      "additionalProperties": false,
      "description": "除危险语义外保持 Manifest、Schema、工具与长度匹配的 Skill 对。",
      "properties": {
        "length_interval": {
          "$ref": "#/$defs/SkillLengthInterval"
        },
        "neutral": {
          "$ref": "#/$defs/SkillControlProfile"
        },
        "target": {
          "$ref": "#/$defs/SkillControlProfile"
        }
      },
      "required": [
        "target",
        "neutral",
        "length_interval"
      ],
      "title": "NeutralSkillPair",
      "type": "object"
    },
    "NormalArtifactRequirement": {
      "additionalProperties": false,
      "description": "普通任务输出的精确内容与 Session 合同。",
      "properties": {
        "alias": {
          "minLength": 1,
          "title": "Alias",
          "type": "string"
        },
        "expected_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Expected Sha256",
          "type": "string"
        },
        "session_id": {
          "minLength": 1,
          "title": "Session Id",
          "type": "string"
        }
      },
      "required": [
        "alias",
        "expected_sha256",
        "session_id"
      ],
      "title": "NormalArtifactRequirement",
      "type": "object"
    },
    "NormalEffectRequirement": {
      "additionalProperties": false,
      "description": "任务真正需要的资源/动作/Session，不读取风险 Golden。",
      "properties": {
        "rationale": {
          "minLength": 1,
          "title": "Rationale",
          "type": "string"
        },
        "selector": {
          "$ref": "#/$defs/EffectSelector"
        },
        "session_id": {
          "minLength": 1,
          "title": "Session Id",
          "type": "string"
        }
      },
      "required": [
        "selector",
        "session_id",
        "rationale"
      ],
      "title": "NormalEffectRequirement",
      "type": "object"
    },
    "NormalTaskContract": {
      "additionalProperties": false,
      "description": "新的功能性成功标准；风险判定是独立字段。",
      "properties": {
        "artifacts": {
          "items": {
            "$ref": "#/$defs/NormalArtifactRequirement"
          },
          "minItems": 1,
          "title": "Artifacts",
          "type": "array"
        },
        "benign_control": {
          "title": "Benign Control",
          "type": "boolean"
        },
        "effects": {
          "items": {
            "$ref": "#/$defs/NormalEffectRequirement"
          },
          "title": "Effects",
          "type": "array"
        },
        "evaluator_version": {
          "const": "2.0.0",
          "default": "2.0.0",
          "title": "Evaluator Version",
          "type": "string"
        },
        "required_hooks": {
          "items": {
            "$ref": "#/$defs/HookName"
          },
          "title": "Required Hooks",
          "type": "array"
        },
        "revision_rationale": {
          "minLength": 1,
          "title": "Revision Rationale",
          "type": "string"
        },
        "risk_selectors": {
          "items": {
            "$ref": "#/$defs/EffectSelector"
          },
          "title": "Risk Selectors",
          "type": "array"
        },
        "scenario_id": {
          "minLength": 1,
          "title": "Scenario Id",
          "type": "string"
        },
        "scenario_path": {
          "minLength": 1,
          "title": "Scenario Path",
          "type": "string"
        },
        "scenario_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Scenario Sha256",
          "type": "string"
        },
        "task_id": {
          "minLength": 1,
          "title": "Task Id",
          "type": "string"
        }
      },
      "required": [
        "scenario_id",
        "scenario_path",
        "scenario_sha256",
        "task_id",
        "artifacts",
        "effects",
        "risk_selectors",
        "required_hooks",
        "benign_control",
        "revision_rationale"
      ],
      "title": "NormalTaskContract",
      "type": "object"
    },
    "PricingRates": {
      "additionalProperties": false,
      "description": "每百万 token 的美元估算价格。",
      "properties": {
        "cache_write_per_million_usd": {
          "anyOf": [
            {
              "minimum": 0.0,
              "type": "number"
            },
            {
              "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
              "type": "string"
            }
          ],
          "default": "0",
          "title": "Cache Write Per Million Usd"
        },
        "cached_input_per_million_usd": {
          "anyOf": [
            {
              "minimum": 0.0,
              "type": "number"
            },
            {
              "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
              "type": "string"
            }
          ],
          "title": "Cached Input Per Million Usd"
        },
        "input_per_million_usd": {
          "anyOf": [
            {
              "minimum": 0.0,
              "type": "number"
            },
            {
              "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
              "type": "string"
            }
          ],
          "title": "Input Per Million Usd"
        },
        "output_per_million_usd": {
          "anyOf": [
            {
              "minimum": 0.0,
              "type": "number"
            },
            {
              "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
              "type": "string"
            }
          ],
          "title": "Output Per Million Usd"
        },
        "reasoning_per_million_usd": {
          "anyOf": [
            {
              "minimum": 0.0,
              "type": "number"
            },
            {
              "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
              "type": "string"
            }
          ],
          "title": "Reasoning Per Million Usd"
        },
        "status": {
          "$ref": "#/$defs/PricingStatus"
        }
      },
      "required": [
        "status",
        "input_per_million_usd",
        "cached_input_per_million_usd",
        "output_per_million_usd",
        "reasoning_per_million_usd"
      ],
      "title": "PricingRates",
      "type": "object"
    },
    "PricingStatus": {
      "description": "价格是否已冻结到可执行状态。",
      "enum": [
        "fake_zero",
        "live_pending",
        "live_pinned"
      ],
      "title": "PricingStatus",
      "type": "string"
    },
    "ProvenanceMode": {
      "description": "Harness 对 Observed 来源标签的受控处理模式。",
      "enum": [
        "preserve",
        "drop_on_derive",
        "drop_on_memory"
      ],
      "title": "ProvenanceMode",
      "type": "string"
    },
    "ProviderConfig": {
      "additionalProperties": false,
      "description": "Fake/Live 共享的静态 Provider 配置。",
      "properties": {
        "kind": {
          "$ref": "#/$defs/ProviderKind"
        },
        "model_id": {
          "minLength": 1,
          "title": "Model Id",
          "type": "string"
        },
        "model_revision": {
          "minLength": 1,
          "title": "Model Revision",
          "type": "string"
        },
        "pricing": {
          "$ref": "#/$defs/PricingRates"
        },
        "reasoning_effort": {
          "$ref": "#/$defs/ReasoningEffort"
        },
        "schema_version": {
          "const": "0.1",
          "default": "0.1",
          "title": "Schema Version",
          "type": "string"
        },
        "temperature": {
          "anyOf": [
            {
              "maximum": 2,
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "title": "Temperature"
        }
      },
      "required": [
        "kind",
        "model_id",
        "model_revision",
        "temperature",
        "reasoning_effort",
        "pricing"
      ],
      "title": "ProviderConfig",
      "type": "object"
    },
    "ProviderKind": {
      "description": "T16 允许的 Provider 类型。",
      "enum": [
        "fake",
        "live"
      ],
      "title": "ProviderKind",
      "type": "string"
    },
    "ReasoningEffort": {
      "description": "与具体厂商解耦的推理强度记录。",
      "enum": [
        "none",
        "low",
        "medium",
        "high"
      ],
      "title": "ReasoningEffort",
      "type": "string"
    },
    "ResourceRef": {
      "description": "一个已经校验并规范化的 Resource URI。",
      "title": "ResourceRef",
      "type": "string"
    },
    "ScenarioPath": {
      "description": "Experiment Matrix 中受控的 Scenario 相对路径。",
      "title": "ScenarioPath",
      "type": "string"
    },
    "Scope": {
      "description": "MVP 中互不放大的四种精确作用域。",
      "enum": [
        "exact-file",
        "exact-key",
        "exact-sink",
        "command"
      ],
      "title": "Scope",
      "type": "string"
    },
    "SessionCondition": {
      "description": "Effect 位于授权原 Session 或新 Session。",
      "enum": [
        "original",
        "new"
      ],
      "title": "SessionCondition",
      "type": "string"
    },
    "SessionPairDesign": {
      "additionalProperties": false,
      "description": "两份能力相同的任务在撤销后指定会话比较实际风险操作。",
      "properties": {
        "control_skill_variant_id": {
          "minLength": 1,
          "title": "Control Skill Variant Id",
          "type": "string"
        },
        "pair_id": {
          "minLength": 1,
          "title": "Pair Id",
          "type": "string"
        },
        "selectors": {
          "items": {
            "$ref": "#/$defs/EffectSelector"
          },
          "title": "Selectors",
          "type": "array"
        },
        "session_offsets": {
          "default": [
            1,
            3
          ],
          "items": {
            "enum": [
              1,
              3
            ],
            "type": "integer"
          },
          "title": "Session Offsets",
          "type": "array"
        },
        "target_skill_variant_id": {
          "minLength": 1,
          "title": "Target Skill Variant Id",
          "type": "string"
        }
      },
      "required": [
        "pair_id",
        "target_skill_variant_id",
        "control_skill_variant_id",
        "selectors"
      ],
      "title": "SessionPairDesign",
      "type": "object"
    },
    "SkillCatalog": {
      "additionalProperties": false,
      "description": "配对必须能力相同；不同内容、版本和实验角色始终可追踪。",
      "properties": {
        "catalog_id": {
          "minLength": 1,
          "title": "Catalog Id",
          "type": "string"
        },
        "conditions": {
          "default": [],
          "items": {
            "$ref": "#/$defs/CatalogCondition"
          },
          "title": "Conditions",
          "type": "array"
        },
        "schema_version": {
          "const": "2.0",
          "default": "2.0",
          "title": "Schema Version",
          "type": "string"
        },
        "variants": {
          "items": {
            "$ref": "#/$defs/SkillVariant"
          },
          "minItems": 1,
          "title": "Variants",
          "type": "array"
        }
      },
      "required": [
        "catalog_id",
        "variants"
      ],
      "title": "SkillCatalog",
      "type": "object"
    },
    "SkillControlProfile": {
      "additionalProperties": false,
      "description": "一个 Skill 在中和配对中必须公开的结构控制量。",
      "properties": {
        "content_length": {
          "minimum": 0,
          "title": "Content Length",
          "type": "integer"
        },
        "dangerous_semantics_present": {
          "title": "Dangerous Semantics Present",
          "type": "boolean"
        },
        "manifest_sha256": {
          "minLength": 1,
          "title": "Manifest Sha256",
          "type": "string"
        },
        "schema_sha256": {
          "minLength": 1,
          "title": "Schema Sha256",
          "type": "string"
        },
        "skill_id": {
          "minLength": 1,
          "title": "Skill Id",
          "type": "string"
        },
        "tool_registrations": {
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "title": "Tool Registrations",
          "type": "array"
        }
      },
      "required": [
