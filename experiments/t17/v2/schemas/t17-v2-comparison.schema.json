{
  "$defs": {
    "ClusterTerm": {
      "additionalProperties": false,
      "description": "一个统计项在某簇的分子分母，可按簇内重复直接相加。",
      "properties": {
        "cluster": {
          "minLength": 1,
          "title": "Cluster",
          "type": "string"
        },
        "denominator": {
          "minimum": 0,
          "title": "Denominator",
          "type": "number"
        },
        "numerator": {
          "title": "Numerator",
          "type": "number"
        },
        "term": {
          "minLength": 1,
          "title": "Term",
          "type": "string"
        }
      },
      "required": [
        "cluster",
        "term",
        "numerator",
        "denominator"
      ],
      "title": "ClusterTerm",
      "type": "object"
    },
    "EnforcementMode": {
      "description": "策略只观察或实际阻断。",
      "enum": [
        "monitor",
        "enforce"
      ],
      "title": "EnforcementMode",
      "type": "string"
    },
    "Measurement": {
      "additionalProperties": false,
      "description": "沿用四态及分子分母约束，并附该项适用的区间和完整簇数。",
      "properties": {
        "cluster_terms": {
          "default": [],
          "items": {
            "$ref": "#/$defs/ClusterTerm"
          },
          "title": "Cluster Terms",
          "type": "array"
        },
        "complete_clusters": {
          "default": 0,
          "minimum": 0,
          "title": "Complete Clusters",
          "type": "integer"
        },
        "contrast_signs": {
          "additionalProperties": {
            "enum": [
              -1,
              1
            ],
            "type": "integer"
          },
          "propertyNames": {
            "minLength": 1
          },
          "title": "Contrast Signs",
          "type": "object"
        },
        "denominator": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Denominator"
        },
        "denominator_scope": {
          "minLength": 1,
          "title": "Denominator Scope",
          "type": "string"
        },
        "evidence_ids": {
          "default": [],
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "title": "Evidence Ids",
          "type": "array"
        },
        "intervals": {
          "default": [],
          "items": {
            "$ref": "#/$defs/StatisticalInterval"
          },
          "title": "Intervals",
          "type": "array"
        },
        "numerator": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Numerator"
        },
        "reason": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Reason"
        },
        "scheduled_denominator": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Scheduled Denominator"
        },
        "schema_version": {
          "const": "2.0",
          "default": "2.0",
          "title": "Schema Version",
          "type": "string"
        },
        "status": {
          "$ref": "#/$defs/MeasurementStatus"
        },
        "unit": {
          "minLength": 1,
          "title": "Unit",
          "type": "string"
        },
        "value": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Value"
        }
      },
      "required": [
        "status",
        "unit",
        "denominator_scope"
      ],
      "title": "Measurement",
      "type": "object"
    },
    "MeasurementStatus": {
      "description": "T17 把已测、设计不适用、Hook 缺失和阶段不完整分开。",
      "enum": [
        "measured",
        "not_applicable",
        "not_available",
        "incomplete"
      ],
      "title": "MeasurementStatus",
      "type": "string"
    },
    "MetricComparison": {
      "additionalProperties": false,
      "description": "两侧各保留独立分母；方向一致不等于统计等价。",
      "properties": {
        "delta": {
          "$ref": "#/$defs/Measurement"
        },
        "delta_definition": {
          "const": "left_minus_right",
          "default": "left_minus_right",
          "title": "Delta Definition",
          "type": "string"
        },
        "interpretation": {
          "const": "descriptive_not_statistical_equivalence",
          "default": "descriptive_not_statistical_equivalence",
          "title": "Interpretation",
          "type": "string"
        },
        "interval_agreement": {
          "enum": [
            "agreement",
            "disagreement",
            "indeterminate"
          ],
          "title": "Interval Agreement",
          "type": "string"
        },
        "left": {
          "$ref": "#/$defs/Measurement"
        },
        "left_interval_direction": {
          "enum": [
            "negative",
            "zero",
            "positive",
            "indeterminate"
          ],
          "title": "Left Interval Direction",
          "type": "string"
        },
        "left_point_direction": {
          "enum": [
            "negative",
            "zero",
            "positive",
            "indeterminate"
          ],
          "title": "Left Point Direction",
          "type": "string"
        },
        "metric": {
          "minLength": 1,
          "title": "Metric",
          "type": "string"
        },
        "point_agreement": {
          "enum": [
            "agreement",
            "disagreement",
            "indeterminate"
          ],
          "title": "Point Agreement",
          "type": "string"
        },
        "right": {
          "$ref": "#/$defs/Measurement"
        },
        "right_interval_direction": {
          "enum": [
            "negative",
            "zero",
            "positive",
            "indeterminate"
          ],
          "title": "Right Interval Direction",
          "type": "string"
        },
        "right_point_direction": {
          "enum": [
            "negative",
            "zero",
            "positive",
            "indeterminate"
          ],
          "title": "Right Point Direction",
          "type": "string"
        }
      },
      "required": [
        "metric",
        "left",
        "right",
        "delta",
        "left_point_direction",
        "right_point_direction",
        "left_interval_direction",
        "right_interval_direction",
        "point_agreement",
        "interval_agreement"
      ],
      "title": "MetricComparison",
      "type": "object"
    },
    "MetricVectorReport": {
      "additionalProperties": false,
      "description": "一个明确分层的全部原始计数、状态、证据和区间。",
      "properties": {
        "identity": {
          "$ref": "#/$defs/StratumIdentity"
        },
        "independent_review": {
          "const": "REVIEW_UNAVAILABLE",
          "default": "REVIEW_UNAVAILABLE",
          "title": "Independent Review",
          "type": "string"
        },
        "kind": {
          "enum": [
            "stage",
            "condition",
            "mode",
            "skill"
          ],
          "title": "Kind",
          "type": "string"
        },
        "metrics": {
          "additionalProperties": {
            "$ref": "#/$defs/Measurement"
          },
          "propertyNames": {
            "minLength": 1
          },
          "title": "Metrics",
          "type": "object"
        },
        "primary_population": {
          "const": "scheduled",
          "default": "scheduled",
          "title": "Primary Population",
          "type": "string"
        },
        "report_id": {
          "minLength": 1,
          "title": "Report Id",
          "type": "string"
        },
        "required_metrics_complete": {
          "title": "Required Metrics Complete",
          "type": "boolean"
        },
        "scheduled_core": {
          "minimum": 1,
          "title": "Scheduled Core",
          "type": "integer"
        },
        "scheduled_replay": {
          "minimum": 0,
          "title": "Scheduled Replay",
          "type": "integer"
        },
        "schema_version": {
          "const": "2.0",
          "default": "2.0",
          "title": "Schema Version",
          "type": "string"
        }
      },
      "required": [
        "report_id",
        "kind",
        "identity",
        "scheduled_core",
        "scheduled_replay",
        "metrics",
        "required_metrics_complete"
      ],
      "title": "MetricVectorReport",
      "type": "object"
    },
    "StatisticalInterval": {
      "additionalProperties": false,
      "description": "百分位区间只要求下界不大于上界，不强迫包住点估计。",
      "properties": {
        "complete_clusters": {
          "default": 0,
          "minimum": 0,
          "title": "Complete Clusters",
          "type": "integer"
        },
        "confidence": {
          "default": 0.95,
          "maximum": 0.95,
          "minimum": 0.95,
          "title": "Confidence",
          "type": "number"
        },
        "lower": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Lower"
        },
        "method": {
          "enum": [
            "wilson_chain_descriptive",
            "cluster_bootstrap"
          ],
          "title": "Method",
          "type": "string"
        },
        "point": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Point"
        },
        "reason": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Reason"
        },
        "resamples": {
          "anyOf": [
            {
              "const": 10000,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Resamples"
        },
        "seed": {
          "anyOf": [
            {
              "const": 17017,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Seed"
        },
        "status": {
          "$ref": "#/$defs/MeasurementStatus"
        },
        "upper": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Upper"
        }
      },
      "required": [
        "status",
        "method"
      ],
      "title": "StatisticalInterval",
      "type": "object"
    },
    "StratumIdentity": {
      "additionalProperties": false,
      "description": "明确报告包含哪些调度，不能把相同技能的不同版本自动混合。",
      "properties": {
        "condition_ids": {
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "title": "Condition Ids",
          "type": "array"
        },
        "domain": {
          "enum": [
            "scripted",
            "fake_reference",
            "live_reference"
          ],
          "title": "Domain",
          "type": "string"
        },
        "enforcement_modes": {
          "items": {
            "$ref": "#/$defs/EnforcementMode"
          },
          "title": "Enforcement Modes",
          "type": "array"
        },
        "manifest_sha256": {
          "additionalProperties": {
            "pattern": "^[0-9a-f]{64}$",
            "type": "string"
          },
          "propertyNames": {
            "minLength": 1
          },
          "title": "Manifest Sha256",
          "type": "object"
        },
        "matrix_sha256": {
          "items": {
            "pattern": "^[0-9a-f]{64}$",
            "type": "string"
          },
          "title": "Matrix Sha256",
          "type": "array"
        },
        "model_revision": {
          "minLength": 1,
          "title": "Model Revision",
          "type": "string"
        },
        "phase_contract_sha256": {
          "items": {
            "pattern": "^[0-9a-f]{64}$",
            "type": "string"
          },
          "title": "Phase Contract Sha256",
          "type": "array"
        },
        "protocol_id": {
          "minLength": 1,
          "title": "Protocol Id",
          "type": "string"
        },
        "raw_manifest_sha256": {
          "default": [],
          "items": {
            "pattern": "^[0-9a-f]{64}$",
            "type": "string"
          },
          "title": "Raw Manifest Sha256",
          "type": "array"
        },
        "requested_model": {
          "minLength": 1,
          "title": "Requested Model",
          "type": "string"
        },
        "skill_content_sha256": {
          "additionalProperties": {
            "pattern": "^[0-9a-f]{64}$",
            "type": "string"
          },
          "propertyNames": {
            "minLength": 1
          },
          "title": "Skill Content Sha256",
          "type": "object"
        },
        "skill_variant_ids": {
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "title": "Skill Variant Ids",
          "type": "array"
        },
        "stages": {
          "items": {
            "$ref": "#/$defs/T17LiveStage"
          },
          "title": "Stages",
          "type": "array"
        }
      },
      "required": [
        "protocol_id",
        "domain",
        "requested_model",
        "model_revision",
        "stages",
        "condition_ids",
        "skill_variant_ids",
        "enforcement_modes",
        "phase_contract_sha256",
        "matrix_sha256"
      ],
      "title": "StratumIdentity",
      "type": "object"
    },
    "T17LiveStage": {
      "description": "预注册的真实模型执行阶段。",
      "enum": [
        "canary",
        "model1",
        "model2_canary",
        "model2",
        "defense"
      ],
      "title": "T17LiveStage",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "description": "比较一个固定因素，不合并两侧生成模型间总体百分比。",
  "properties": {
    "comparisons": {
      "items": {
        "$ref": "#/$defs/MetricComparison"
      },
      "title": "Comparisons",
      "type": "array"
    },
    "complete": {
      "title": "Complete",
      "type": "boolean"
    },
    "kind": {
      "enum": [
        "model",
        "defense",
        "skill"
      ],
      "title": "Kind",
      "type": "string"
    },
    "left": {
      "$ref": "#/$defs/MetricVectorReport"
    },
    "named_deltas": {
      "additionalProperties": {
        "$ref": "#/$defs/Measurement"
      },
      "propertyNames": {
        "minLength": 1
      },
      "title": "Named Deltas",
      "type": "object"
    },
    "report_id": {
      "minLength": 1,
      "title": "Report Id",
      "type": "string"
    },
    "right": {
      "$ref": "#/$defs/MetricVectorReport"
    },
    "schema_version": {
      "const": "2.0",
      "default": "2.0",
      "title": "Schema Version",
      "type": "string"
    }
  },
  "required": [
    "report_id",
    "kind",
    "left",
    "right",
    "comparisons",
    "complete"
  ],
  "title": "ComparisonReport",
  "type": "object"
}
