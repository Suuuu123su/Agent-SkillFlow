{
  "$defs": {
    "CapabilityAction": {
      "description": "MVP 固定支持的能力动作。",
      "enum": [
        "file.read",
        "file.write",
        "memory.read",
        "memory.write",
        "network.send",
        "shell.execute",
        "user.confirm"
      ],
      "title": "CapabilityAction",
      "type": "string"
    },
    "CapabilityEffect": {
      "additionalProperties": false,
      "description": "可比较的结构化能力效果。",
      "properties": {
        "action": {
          "$ref": "#/$defs/CapabilityAction"
        },
        "lifetime": {
          "$ref": "#/$defs/Lifetime"
        },
        "scope": {
          "$ref": "#/$defs/Scope"
        },
        "sensitivity": {
          "maximum": 4,
          "minimum": 0,
          "title": "Sensitivity",
          "type": "integer"
        },
        "sink": {
          "$ref": "#/$defs/ResourceRef"
        },
        "source": {
          "anyOf": [
            {
              "$ref": "#/$defs/ResourceRef"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "source",
        "action",
        "sink",
        "scope",
        "lifetime",
        "sensitivity"
      ],
      "title": "CapabilityEffect",
      "type": "object"
    },
    "EffectRecord": {
      "additionalProperties": false,
      "description": "一次运行中的效果请求与执行结果。",
      "properties": {
        "decision_id": {
          "minLength": 1,
          "title": "Decision Id",
          "type": "string"
        },
        "effect": {
          "$ref": "#/$defs/CapabilityEffect"
        },
        "effect_alias": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Effect Alias"
        },
        "effect_id": {
          "minLength": 1,
          "title": "Effect Id",
          "type": "string"
        },
        "executed": {
          "title": "Executed",
          "type": "boolean"
        },
        "request_event_id": {
          "minLength": 1,
          "title": "Request Event Id",
          "type": "string"
        },
        "result_event_id": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Result Event Id"
        },
        "tool_receipt_id": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Tool Receipt Id"
        }
      },
      "required": [
        "effect_id",
        "effect",
        "request_event_id",
        "decision_id",
        "executed"
      ],
      "title": "EffectRecord",
      "type": "object"
    },
    "EnforcementMode": {
      "description": "策略只观察或实际阻断。",
      "enum": [
        "monitor",
        "enforce"
      ],
      "title": "EnforcementMode",
      "type": "string"
    },
    "Lifetime": {
      "description": "授权或效果的有效边界。",
      "enum": [
        "call",
        "task",
        "session",
        "persistent"
      ],
      "title": "Lifetime",
      "type": "string"
    },
    "MockToolName": {
      "description": "安全 Mock Tool 白名单。",
      "enum": [
        "read_file",
        "write_memory",
        "read_memory",
        "http_send",
        "shell_exec"
      ],
      "title": "MockToolName",
      "type": "string"
    },
    "ResourceRef": {
      "description": "一个已经校验并规范化的 Resource URI。",
      "title": "ResourceRef",
      "type": "string"
    },
    "Scope": {
      "description": "MVP 中互不放大的四种精确作用域。",
      "enum": [
        "exact-file",
        "exact-key",
        "exact-sink",
        "command"
      ],
      "title": "Scope",
      "type": "string"
    },
    "T17LiveStage": {
      "description": "预注册的真实模型执行阶段。",
      "enum": [
        "canary",
        "model1",
        "model2_canary",
        "model2",
        "defense"
      ],
      "title": "T17LiveStage",
      "type": "string"
    },
    "ToolReceiptDraft": {
      "description": "Mock Tool Adapter 内部使用的 Receipt 数据。",
      "properties": {
        "action_id": {
          "title": "Action Id",
          "type": "string"
        },
        "actor_id": {
          "title": "Actor Id",
          "type": "string"
        },
        "argument_artifact_id": {
          "title": "Argument Artifact Id",
          "type": "string"
        },
        "call_id": {
          "title": "Call Id",
          "type": "string"
        },
        "decision_id": {
          "title": "Decision Id",
          "type": "string"
        },
        "effect_id": {
          "title": "Effect Id",
          "type": "string"
        },
        "output_artifact_ids": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Output Artifact Ids",
          "type": "array"
        },
        "receipt_artifact_id": {
          "title": "Receipt Artifact Id",
          "type": "string"
        },
        "receipt_id": {
          "title": "Receipt Id",
          "type": "string"
        },
        "request_event_id": {
          "title": "Request Event Id",
          "type": "string"
        },
        "result_event_id": {
          "title": "Result Event Id",
          "type": "string"
        },
        "timestamp": {
          "format": "date-time",
          "title": "Timestamp",
          "type": "string"
        },
        "tool": {
          "$ref": "#/$defs/MockToolName"
        }
      },
      "required": [
        "receipt_id",
        "tool",
        "effect_id",
        "request_event_id",
        "result_event_id",
        "decision_id",
        "actor_id",
        "call_id",
        "action_id",
        "argument_artifact_id",
        "receipt_artifact_id",
        "timestamp"
      ],
      "title": "ToolReceiptDraft",
      "type": "object"
    },
    "UnitIdentity": {
      "additionalProperties": false,
      "description": "每条公开记录的任务、技能、模型、防御与统计簇身份。",
      "properties": {
        "condition_id": {
          "minLength": 1,
          "title": "Condition Id",
          "type": "string"
        },
        "defense_base_id": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Defense Base Id",
          "type": "string"
        },
        "domain": {
          "enum": [
            "scripted",
            "fake_reference",
            "live_reference"
          ],
          "title": "Domain",
          "type": "string"
        },
        "enforcement_mode": {
          "$ref": "#/$defs/EnforcementMode"
        },
        "manifest_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Manifest Sha256",
          "type": "string"
        },
        "matrix_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Matrix Sha256",
          "type": "string"
        },
        "model_revision": {
          "minLength": 1,
          "title": "Model Revision",
          "type": "string"
        },
        "phase_contract_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Phase Contract Sha256",
          "type": "string"
        },
        "protocol_id": {
          "minLength": 1,
          "title": "Protocol Id",
          "type": "string"
        },
        "repeat_index": {
          "minimum": 1,
          "title": "Repeat Index",
          "type": "integer"
        },
        "requested_model": {
          "minLength": 1,
          "title": "Requested Model",
          "type": "string"
        },
        "semantic_instance_id": {
          "minLength": 1,
          "title": "Semantic Instance Id",
          "type": "string"
        },
        "semantic_template_id": {
          "minLength": 1,
          "title": "Semantic Template Id",
          "type": "string"
        },
        "skill_content_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Skill Content Sha256",
          "type": "string"
        },
        "skill_variant_id": {
          "minLength": 1,
          "title": "Skill Variant Id",
          "type": "string"
        },
        "source_variant": {
          "minLength": 1,
          "title": "Source Variant",
          "type": "string"
        },
        "stage": {
          "$ref": "#/$defs/T17LiveStage"
        },
        "task_contract_id": {
          "minLength": 1,
          "title": "Task Contract Id",
          "type": "string"
        },
        "task_contract_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Task Contract Sha256",
          "type": "string"
        },
        "trial_id": {
          "minLength": 1,
          "title": "Trial Id",
          "type": "string"
        },
        "unit_id": {
          "minLength": 1,
          "title": "Unit Id",
          "type": "string"
        }
      },
      "required": [
        "protocol_id",
        "stage",
        "domain",
        "phase_contract_sha256",
        "matrix_sha256",
        "unit_id",
        "trial_id",
        "condition_id",
        "source_variant",
        "skill_variant_id",
        "skill_content_sha256",
        "manifest_sha256",
        "task_contract_id",
        "task_contract_sha256",
        "semantic_template_id",
        "semantic_instance_id",
        "repeat_index",
        "defense_base_id",
        "enforcement_mode",
        "requested_model",
        "model_revision"
      ],
      "title": "UnitIdentity",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "逐操作保留事件绑定及回执；分支前缀不能再次当独立效果计数。",
  "properties": {
    "branch": {
      "enum": [
        "core",
        "original",
        "neutral"
      ],
      "title": "Branch",
      "type": "string"
    },
    "effect": {
      "$ref": "#/$defs/EffectRecord"
    },
    "identity": {
      "$ref": "#/$defs/UnitIdentity"
    },
    "in_replay_prefix": {
      "title": "In Replay Prefix",
      "type": "boolean"
    },
    "receipt": {
      "$ref": "#/$defs/ToolReceiptDraft"
    },
    "run_id": {
      "minLength": 1,
      "title": "Run Id",
      "type": "string"
    },
    "session_id": {
      "minLength": 1,
      "title": "Session Id",
      "type": "string"
    }
  },
  "required": [
    "identity",
    "run_id",
    "session_id",
    "branch",
    "in_replay_prefix",
    "effect",
    "receipt"
  ],
  "title": "EffectReceiptRow",
  "type": "object"
}
