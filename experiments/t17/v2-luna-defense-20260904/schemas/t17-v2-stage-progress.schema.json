{
  "$defs": {
    "T17LiveStage": {
      "description": "预注册的真实模型执行阶段。",
      "enum": [
        "canary",
        "model1",
        "model2_canary",
        "model2",
        "defense"
      ],
      "title": "T17LiveStage",
      "type": "string"
    },
    "UnitUsage": {
      "additionalProperties": false,
      "description": "实际返回用量与保守占用分开；费用始终是估算，不冒充账单。",
      "properties": {
        "api_calls": {
          "default": 0,
          "minimum": 0,
          "title": "Api Calls",
          "type": "integer"
        },
        "cache_write_tokens": {
          "default": 0,
          "minimum": 0,
          "title": "Cache Write Tokens",
          "type": "integer"
        },
        "cached_input_tokens": {
          "default": 0,
          "minimum": 0,
          "title": "Cached Input Tokens",
          "type": "integer"
        },
        "complete": {
          "default": true,
          "title": "Complete",
          "type": "boolean"
        },
        "estimated_cost_usd": {
          "anyOf": [
            {
              "minimum": 0.0,
              "type": "number"
            },
            {
              "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
              "type": "string"
            }
          ],
          "default": "0",
          "title": "Estimated Cost Usd"
        },
        "input_tokens": {
          "default": 0,
          "minimum": 0,
          "title": "Input Tokens",
          "type": "integer"
        },
        "latency_ms": {
          "default": 0,
          "minimum": 0,
          "title": "Latency Ms",
          "type": "number"
        },
        "missing_reason": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Missing Reason"
        },
        "output_tokens": {
          "default": 0,
          "minimum": 0,
          "title": "Output Tokens",
          "type": "integer"
        },
        "reasoning_tokens": {
          "default": 0,
          "minimum": 0,
          "title": "Reasoning Tokens",
          "type": "integer"
        },
        "reserved_cost_usd": {
          "anyOf": [
            {
              "minimum": 0.0,
              "type": "number"
            },
            {
              "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
              "type": "string"
            }
          ],
          "default": "0",
          "title": "Reserved Cost Usd"
        },
        "response_ids": {
          "default": [],
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "title": "Response Ids",
          "type": "array"
        },
        "responses": {
          "default": 0,
          "minimum": 0,
          "title": "Responses",
          "type": "integer"
        }
      },
      "title": "UnitUsage",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "可显示的进度只含数量和用量，没有模型正文或凭据。",
  "properties": {
    "failed_units": {
      "minimum": 0,
      "title": "Failed Units",
      "type": "integer"
    },
    "model_failures": {
      "minimum": 0,
      "title": "Model Failures",
      "type": "integer"
    },
    "scheduled_core": {
      "minimum": 0,
      "title": "Scheduled Core",
      "type": "integer"
    },
    "scheduled_replay": {
      "minimum": 0,
      "title": "Scheduled Replay",
      "type": "integer"
    },
    "stage": {
      "$ref": "#/$defs/T17LiveStage"
    },
    "terminal_core": {
      "minimum": 0,
      "title": "Terminal Core",
      "type": "integer"
    },
    "terminal_replay": {
      "minimum": 0,
      "title": "Terminal Replay",
      "type": "integer"
    },
    "usage": {
      "$ref": "#/$defs/UnitUsage"
    }
  },
  "required": [
    "stage",
    "scheduled_core",
    "scheduled_replay",
    "terminal_core",
    "terminal_replay",
    "failed_units",
    "model_failures",
    "usage"
  ],
  "title": "StageProgress",
  "type": "object"
}
