{
  "$defs": {
    "BootstrapEstimate": {
      "additionalProperties": false,
      "description": "点估计及以语义实例为 cluster 的区间。",
      "properties": {
        "cluster_count": {
          "title": "Cluster Count",
          "type": "integer"
        },
        "interval": {
          "$ref": "#/$defs/ConfidenceInterval"
        },
        "point_estimate": {
          "title": "Point Estimate",
          "type": "number"
        },
        "resamples": {
          "title": "Resamples",
          "type": "integer"
        },
        "seed": {
          "title": "Seed",
          "type": "integer"
        }
      },
      "required": [
        "point_estimate",
        "interval",
        "cluster_count",
        "resamples",
        "seed"
      ],
      "title": "BootstrapEstimate",
      "type": "object"
    },
    "ConfidenceInterval": {
      "additionalProperties": false,
      "description": "固定 95% 双侧区间。",
      "properties": {
        "confidence_level": {
          "default": 0.95,
          "maximum": 0.95,
          "minimum": 0.95,
          "title": "Confidence Level",
          "type": "number"
        },
        "lower": {
          "title": "Lower",
          "type": "number"
        },
        "method": {
          "enum": [
            "cluster_percentile_bootstrap",
            "wilson_score"
          ],
          "title": "Method",
          "type": "string"
        },
        "upper": {
          "title": "Upper",
          "type": "number"
        }
      },
      "required": [
        "lower",
        "upper",
        "method"
      ],
      "title": "ConfidenceInterval",
      "type": "object"
    },
    "T16D2ConditionReport": {
      "additionalProperties": false,
      "description": "单条件的三值 task success 与独立 Effect 计数。",
      "properties": {
        "condition_id": {
          "minLength": 1,
          "title": "Condition Id",
          "type": "string"
        },
        "estimated_cost_usd": {
          "anyOf": [
            {
              "minimum": 0.0,
              "type": "number"
            },
            {
              "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
              "type": "string"
            }
          ],
          "title": "Estimated Cost Usd"
        },
        "infrastructure_invalid": {
          "minimum": 0,
          "title": "Infrastructure Invalid",
          "type": "integer"
        },
        "latency_ms": {
          "minimum": 0,
          "title": "Latency Ms",
          "type": "integer"
        },
        "no_call": {
          "minimum": 0,
          "title": "No Call",
          "type": "integer"
        },
        "observed": {
          "minimum": 0,
          "title": "Observed",
          "type": "integer"
        },
        "refusal": {
          "minimum": 0,
          "title": "Refusal",
          "type": "integer"
        },
        "scheduled": {
          "minimum": 0,
          "title": "Scheduled",
          "type": "integer"
        },
        "schema_rejection": {
          "minimum": 0,
          "title": "Schema Rejection",
          "type": "integer"
        },
        "target_effect_executed": {
          "minimum": 0,
          "title": "Target Effect Executed",
          "type": "integer"
        },
        "target_effect_wilson_95": {
          "anyOf": [
            {
              "$ref": "#/$defs/ConfidenceInterval"
            },
            {
              "type": "null"
            }
          ]
        },
        "task_success_false": {
          "minimum": 0,
          "title": "Task Success False",
          "type": "integer"
        },
        "task_success_na": {
          "minimum": 0,
          "title": "Task Success Na",
          "type": "integer"
        },
        "task_success_true": {
          "minimum": 0,
          "title": "Task Success True",
          "type": "integer"
        },
        "task_success_wilson_95": {
          "anyOf": [
            {
              "$ref": "#/$defs/ConfidenceInterval"
            },
            {
              "type": "null"
            }
          ]
        },
        "token_usage": {
          "$ref": "#/$defs/TokenUsage"
        }
      },
      "required": [
        "condition_id",
        "scheduled",
        "observed",
        "task_success_true",
        "task_success_false",
        "task_success_na",
        "target_effect_executed",
        "refusal",
        "no_call",
        "schema_rejection",
        "infrastructure_invalid",
        "token_usage",
        "latency_ms",
        "estimated_cost_usd",
        "task_success_wilson_95",
        "target_effect_wilson_95"
      ],
      "title": "T16D2ConditionReport",
      "type": "object"
    },
    "T16D2JointOutcome": {
      "additionalProperties": false,
      "description": "task success 与目标 Effect 的二维结果。",
      "properties": {
        "task_false_effect_false": {
          "minimum": 0,
          "title": "Task False Effect False",
          "type": "integer"
        },
        "task_false_effect_true": {
          "minimum": 0,
          "title": "Task False Effect True",
          "type": "integer"
        },
        "task_na_effect_false": {
          "minimum": 0,
          "title": "Task Na Effect False",
          "type": "integer"
        },
        "task_na_effect_true": {
          "minimum": 0,
          "title": "Task Na Effect True",
          "type": "integer"
        },
        "task_true_effect_false": {
          "minimum": 0,
          "title": "Task True Effect False",
          "type": "integer"
        },
        "task_true_effect_true": {
          "minimum": 0,
          "title": "Task True Effect True",
          "type": "integer"
        }
      },
      "required": [
        "task_true_effect_true",
        "task_true_effect_false",
        "task_false_effect_true",
        "task_false_effect_false",
        "task_na_effect_true",
        "task_na_effect_false"
      ],
      "title": "T16D2JointOutcome",
      "type": "object"
    },
    "T16D2PairedEffectAnalysis": {
      "additionalProperties": false,
      "description": "两个条件或时序点的配对 Effect 差。",
      "properties": {
        "control_successes": {
          "minimum": 0,
          "title": "Control Successes",
          "type": "integer"
        },
        "control_total": {
          "minimum": 0,
          "title": "Control Total",
          "type": "integer"
        },
        "estimate": {
          "anyOf": [
            {
              "$ref": "#/$defs/BootstrapEstimate"
            },
            {
              "type": "null"
            }
          ]
        },
        "target_successes": {
          "minimum": 0,
          "title": "Target Successes",
          "type": "integer"
        },
        "target_total": {
          "minimum": 0,
          "title": "Target Total",
          "type": "integer"
        }
      },
      "required": [
        "target_successes",
        "target_total",
        "control_successes",
        "control_total",
        "estimate"
      ],
      "title": "T16D2PairedEffectAnalysis",
      "type": "object"
    },
    "TokenUsage": {
      "additionalProperties": false,
      "description": "TrialResult 所需的生成、缓存读写与推理 token 计数。",
      "properties": {
        "cache_write_tokens": {
          "default": 0,
          "minimum": 0,
          "title": "Cache Write Tokens",
          "type": "integer"
        },
        "cached_input_tokens": {
          "minimum": 0,
          "title": "Cached Input Tokens",
          "type": "integer"
        },
        "input_tokens": {
          "minimum": 0,
          "title": "Input Tokens",
          "type": "integer"
        },
        "output_tokens": {
          "minimum": 0,
          "title": "Output Tokens",
          "type": "integer"
        },
        "reasoning_tokens": {
          "minimum": 0,
          "title": "Reasoning Tokens",
          "type": "integer"
        }
      },
      "required": [
        "input_tokens",
        "cached_input_tokens",
        "output_tokens",
        "reasoning_tokens"
      ],
      "title": "TokenUsage",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "明确不与 v2 合并、也不是论文主实验的真实 bridge 报告。",
  "properties": {
    "a1_claim_minus_neutralized": {
      "anyOf": [
        {
          "$ref": "#/$defs/T16D2PairedEffectAnalysis"
        },
        {
          "type": "null"
        }
      ]
    },
    "api_call_count": {
      "minimum": 0,
      "title": "Api Call Count",
      "type": "integer"
    },
    "c1_hiaa": {
      "anyOf": [
        {
          "$ref": "#/$defs/BootstrapEstimate"
        },
        {
          "type": "null"
        }
      ]
    },
    "condition_reports": {
      "items": {
        "$ref": "#/$defs/T16D2ConditionReport"
      },
      "title": "Condition Reports",
      "type": "array"
    },
    "formal_main_experiment": {
      "const": false,
      "default": false,
      "title": "Formal Main Experiment",
      "type": "boolean"
    },
    "formal_metrics": {
      "additionalProperties": {
        "const": "N/A",
        "type": "string"
      },
      "propertyNames": {
        "minLength": 1
      },
      "title": "Formal Metrics",
      "type": "object"
    },
    "joint_outcomes": {
      "$ref": "#/$defs/T16D2JointOutcome"
    },
    "m2_session_1": {
      "anyOf": [
        {
          "$ref": "#/$defs/T16D2PairedEffectAnalysis"
        },
        {
          "type": "null"
        }
      ]
    },
    "m2_session_3": {
      "anyOf": [
        {
          "$ref": "#/$defs/T16D2PairedEffectAnalysis"
        },
        {
          "type": "null"
        }
      ]
    },
    "mean_cost_usd": {
      "anyOf": [
        {
          "minimum": 0.0,
          "type": "number"
        },
        {
          "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
          "type": "string"
        }
      ],
      "title": "Mean Cost Usd"
    },
    "model_id": {
      "const": "gpt-5.6-luna",
      "default": "gpt-5.6-luna",
      "title": "Model Id",
      "type": "string"
    },
    "observed": {
      "minimum": 0,
      "title": "Observed",
      "type": "integer"
    },
    "old_v2_mergeable": {
      "const": false,
      "default": false,
      "title": "Old V2 Mergeable",
      "type": "boolean"
    },
    "p50_cost_usd": {
      "anyOf": [
        {
          "minimum": 0.0,
          "type": "number"
        },
        {
          "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
          "type": "string"
        }
      ],
      "title": "P50 Cost Usd"
    },
    "p95_cost_usd": {
      "anyOf": [
        {
          "minimum": 0.0,
          "type": "number"
        },
        {
          "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
          "type": "string"
        }
      ],
      "title": "P95 Cost Usd"
    },
    "provider": {
      "const": "openai",
      "default": "openai",
      "title": "Provider",
      "type": "string"
    },
    "provider_model_revisions": {
      "items": {
        "minLength": 1,
        "type": "string"
      },
      "title": "Provider Model Revisions",
      "type": "array"
    },
    "scheduled": {
      "const": 48,
      "default": 48,
      "title": "Scheduled",
      "type": "integer"
    },
    "schema_version": {
      "const": "0.1",
      "default": "0.1",
      "title": "Schema Version",
      "type": "string"
    },
    "simulation_only": {
      "const": false,
      "default": false,
      "title": "Simulation Only",
      "type": "boolean"
    },
    "study_role": {
      "const": "bridge_calibration",
      "default": "bridge_calibration",
      "title": "Study Role",
      "type": "string"
    },
    "t16_e_recommendation": {
      "enum": [
        "YES",
        "NO",
        "BLOCKED"
      ],
      "title": "T16 E Recommendation",
      "type": "string"
    },
    "t16d2_status": {
      "enum": [
        "PASSED",
        "BLOCKED"
      ],
      "title": "T16D2 Status",
      "type": "string"
    },
    "t16d_v2_evidence_acceptance": {
      "const": "BLOCKED",
      "default": "BLOCKED",
      "title": "T16D V2 Evidence Acceptance",
      "type": "string"
    },
    "token_usage": {
      "$ref": "#/$defs/TokenUsage"
    },
    "total_estimated_cost_usd": {
      "anyOf": [
        {
          "minimum": 0.0,
          "type": "number"
        },
        {
          "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
          "type": "string"
        }
      ],
      "title": "Total Estimated Cost Usd"
    }
  },
  "required": [
    "provider_model_revisions",
    "observed",
    "condition_reports",
    "joint_outcomes",
    "c1_hiaa",
    "m2_session_1",
    "m2_session_3",
    "a1_claim_minus_neutralized",
    "formal_metrics",
    "token_usage",
    "api_call_count",
    "total_estimated_cost_usd",
    "mean_cost_usd",
    "p50_cost_usd",
    "p95_cost_usd",
    "t16d2_status",
    "t16_e_recommendation"
  ],
  "title": "T16D2BridgeReport",
  "type": "object"
}
