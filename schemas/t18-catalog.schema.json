{
  "$defs": {
    "ArtifactAliasRef": {
      "description": "Scenario 内已声明 Artifact output 的引用。",
      "title": "ArtifactAliasRef",
      "type": "string"
    },
    "ArtifactSha256Assertion": {
      "additionalProperties": false,
      "description": "用内容摘要验证一个声明式输出。",
      "properties": {
        "expected_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Expected Sha256",
          "type": "string"
        },
        "kind": {
          "const": "artifact_sha256",
          "title": "Kind",
          "type": "string"
        },
        "target": {
          "$ref": "#/$defs/ArtifactAliasRef"
        }
      },
      "required": [
        "kind",
        "target",
        "expected_sha256"
      ],
      "title": "ArtifactSha256Assertion",
      "type": "object"
    },
    "AssetSpec": {
      "additionalProperties": false,
      "description": "每次 Run 复制到隔离 workspace 的输入资产。",
      "properties": {
        "id": {
          "minLength": 1,
          "title": "Id",
          "type": "string"
        },
        "marker": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Marker"
        },
        "sensitivity": {
          "default": 0,
          "maximum": 4,
          "minimum": 0,
          "title": "Sensitivity",
          "type": "integer"
        },
        "trust": {
          "$ref": "#/$defs/TrustLevel"
        },
        "uri": {
          "$ref": "#/$defs/ResourceRef"
        }
      },
      "required": [
        "id",
        "uri",
        "trust"
      ],
      "title": "AssetSpec",
      "type": "object"
    },
    "AuthorizationClaimBinding": {
      "description": "仅当固定输入摘要匹配时，把其 ID 声明为低可信授权文本。",
      "properties": {
        "expected_content_hash": {
          "title": "Expected Content Hash",
          "type": "string"
        },
        "input_index": {
          "title": "Input Index",
          "type": "integer"
        }
      },
      "required": [
        "input_index",
        "expected_content_hash"
      ],
      "title": "AuthorizationClaimBinding",
      "type": "object"
    },
    "AuthorizationGrant": {
      "additionalProperties": false,
      "description": "由用户或可信策略签发的能力授权。",
      "properties": {
        "action": {
          "$ref": "#/$defs/CapabilityAction"
        },
        "call_id": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Call Id"
        },
        "expires_at": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Expires At"
        },
        "grant_id": {
          "minLength": 1,
          "title": "Grant Id",
          "type": "string"
        },
        "grantee_id": {
          "minLength": 1,
          "title": "Grantee Id",
          "type": "string"
        },
        "issuer_id": {
          "minLength": 1,
          "title": "Issuer Id",
          "type": "string"
        },
        "issuer_type": {
          "enum": [
            "user",
            "trusted_policy"
          ],
          "title": "Issuer Type",
          "type": "string"
        },
        "lifetime": {
          "$ref": "#/$defs/Lifetime"
        },
        "scope": {
          "$ref": "#/$defs/Scope"
        },
        "session_id": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Session Id"
        },
        "sink_pattern": {
          "$ref": "#/$defs/ResourceRef"
        },
        "source_pattern": {
          "anyOf": [
            {
              "$ref": "#/$defs/ResourceRef"
            },
            {
              "type": "null"
            }
          ]
        },
        "task_id": {
          "minLength": 1,
          "title": "Task Id",
          "type": "string"
        },
        "valid_from": {
          "format": "date-time",
          "title": "Valid From",
          "type": "string"
        }
      },
      "required": [
        "grant_id",
        "issuer_id",
        "issuer_type",
        "grantee_id",
        "action",
        "source_pattern",
        "sink_pattern",
        "scope",
        "lifetime",
        "task_id",
        "valid_from"
      ],
      "title": "AuthorizationGrant",
      "type": "object"
    },
    "CanarySpec": {
      "additionalProperties": false,
      "description": "只以 ID 与摘要引用测试 Canary，不把正文写入报告合同。",
      "properties": {
        "asset_id": {
          "minLength": 1,
          "title": "Asset Id",
          "type": "string"
        },
        "id": {
          "minLength": 1,
          "title": "Id",
          "type": "string"
        },
        "sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Sha256",
          "type": "string"
        }
      },
      "required": [
        "id",
        "asset_id",
        "sha256"
      ],
      "title": "CanarySpec",
      "type": "object"
    },
    "CapabilityAction": {
      "description": "MVP 固定支持的能力动作。",
      "enum": [
        "file.read",
        "file.write",
        "memory.read",
        "memory.write",
        "network.send",
        "shell.execute",
        "user.confirm"
      ],
      "title": "CapabilityAction",
      "type": "string"
    },
    "CapabilityEffect": {
      "additionalProperties": false,
      "description": "可比较的结构化能力效果。",
      "properties": {
        "action": {
          "$ref": "#/$defs/CapabilityAction"
        },
        "lifetime": {
          "$ref": "#/$defs/Lifetime"
        },
        "scope": {
          "$ref": "#/$defs/Scope"
        },
        "sensitivity": {
          "maximum": 4,
          "minimum": 0,
          "title": "Sensitivity",
          "type": "integer"
        },
        "sink": {
          "$ref": "#/$defs/ResourceRef"
        },
        "source": {
          "anyOf": [
            {
              "$ref": "#/$defs/ResourceRef"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "source",
        "action",
        "sink",
        "scope",
        "lifetime",
        "sensitivity"
      ],
      "title": "CapabilityEffect",
      "type": "object"
    },
    "ClockSpec": {
      "additionalProperties": false,
      "description": "确定性虚拟时钟。",
      "properties": {
        "start": {
          "format": "date-time",
          "title": "Start",
          "type": "string"
        }
      },
      "required": [
        "start"
      ],
      "title": "ClockSpec",
      "type": "object"
    },
    "CounterfactualSpec": {
      "additionalProperties": false,
      "description": "中和一个 Artifact 后观察 Effect 的反事实重放声明。",
      "properties": {
        "intervention": {
          "const": "neutralize",
          "title": "Intervention",
          "type": "string"
        },
        "observe": {
          "$ref": "#/$defs/EffectSelectorRef"
        },
        "target": {
          "$ref": "#/$defs/ArtifactAliasRef"
        }
      },
      "required": [
        "target",
        "intervention",
        "observe"
      ],
      "title": "CounterfactualSpec",
      "type": "object"
    },
    "Decision": {
      "description": "Harness 或策略的结构化决策。",
      "enum": [
        "allow",
        "deny",
        "confirm"
      ],
      "title": "Decision",
      "type": "string"
    },
    "EffectReceiptedAssertion": {
      "additionalProperties": false,
      "description": "验证 selector 是否命中带真实 Receipt 的已执行 Effect。",
      "properties": {
        "expected": {
          "title": "Expected",
          "type": "boolean"
        },
        "kind": {
          "const": "effect_receipted",
          "title": "Kind",
          "type": "string"
        },
        "target": {
          "$ref": "#/$defs/EffectSelectorRef"
        }
      },
      "required": [
        "kind",
        "target",
        "expected"
      ],
      "title": "EffectReceiptedAssertion",
      "type": "object"
    },
    "EffectSelector": {
      "additionalProperties": false,
      "description": "把运行期多个 EffectRecord 映射到稳定别名。",
      "properties": {
        "action": {
          "$ref": "#/$defs/CapabilityAction"
        },
        "alias": {
          "minLength": 1,
          "title": "Alias",
          "type": "string"
        },
        "sink_pattern": {
          "$ref": "#/$defs/ResourceRef"
        },
        "source_pattern": {
          "anyOf": [
            {
              "$ref": "#/$defs/ResourceRef"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "alias",
        "action",
        "source_pattern",
        "sink_pattern"
      ],
      "title": "EffectSelector",
      "type": "object"
    },
    "EffectSelectorRef": {
      "description": "Scenario 内已声明 effect selector 的引用。",
      "title": "EffectSelectorRef",
      "type": "string"
    },
    "EnforcementMode": {
      "description": "策略只观察或实际阻断。",
      "enum": [
        "monitor",
        "enforce"
      ],
      "title": "EnforcementMode",
      "type": "string"
    },
    "ExecutionConfig": {
      "additionalProperties": false,
      "description": "运行期只观察或实际阻断。",
      "properties": {
        "mode": {
          "$ref": "#/$defs/EnforcementMode"
        }
      },
      "required": [
        "mode"
      ],
      "title": "ExecutionConfig",
      "type": "object"
    },
    "ExpectedInfluence": {
      "additionalProperties": false,
      "description": "Artifact 到目标 Effect 的预注册因果预期。",
      "properties": {
        "expectation": {
          "$ref": "#/$defs/InfluenceExpectationKind"
        },
        "source": {
          "$ref": "#/$defs/ArtifactAliasRef"
        },
        "target": {
          "$ref": "#/$defs/EffectSelectorRef"
        }
      },
      "required": [
        "source",
        "target",
        "expectation"
      ],
      "title": "ExpectedInfluence",
      "type": "object"
    },
    "ExpectedMetric": {
      "additionalProperties": false,
      "description": "一个指标的方向预期或带理由的结构化 N/A。",
      "properties": {
        "expectation": {
          "$ref": "#/$defs/MetricExpectationKind"
        },
        "metric": {
          "$ref": "#/$defs/ExpectedMetricName"
        },
        "reason": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Reason"
        }
      },
      "required": [
        "metric",
        "expectation"
      ],
      "title": "ExpectedMetric",
      "type": "object"
    },
    "ExpectedMetricName": {
      "description": "T12 场景可以预注册的研究输出。",
      "enum": [
        "UEA",
        "causal_impact",
        "HIAA_run",
        "ALR",
        "RIR_1",
        "RIR_3"
      ],
      "title": "ExpectedMetricName",
      "type": "string"
    },
    "ExpectedOrigins": {
      "additionalProperties": false,
      "description": "Artifact 或 Effect 必须保留的来源集合。",
      "properties": {
        "origins": {
          "items": {
            "$ref": "#/$defs/OriginRef"
          },
          "minItems": 1,
          "title": "Origins",
          "type": "array"
        },
        "target": {
          "$ref": "#/$defs/ScenarioTargetRef"
        }
      },
      "required": [
        "target",
        "origins"
      ],
      "title": "ExpectedOrigins",
      "type": "object"
    },
    "ExpectedPersistence": {
      "additionalProperties": false,
      "description": "撤销后指定会话偏移上的持续影响预期。",
      "properties": {
        "check_offsets": {
          "items": {
            "minimum": 1,
            "type": "integer"
          },
          "minItems": 1,
          "title": "Check Offsets",
          "type": "array"
        },
        "revoked_skill": {
          "minLength": 1,
          "title": "Revoked Skill",
          "type": "string"
        }
      },
      "required": [
        "revoked_skill",
        "check_offsets"
      ],
      "title": "ExpectedPersistence",
      "type": "object"
    },
    "FixtureImplementationRef": {
      "description": "只能由固定 fixture registry 解析的实现引用。",
      "title": "FixtureImplementationRef",
      "type": "string"
    },
    "FixtureScript": {
      "description": "一个固定 fixture 的动作与返回值。",
      "properties": {
        "actions": {
          "default": [],
          "items": {
            "$ref": "#/$defs/ToolScriptAction"
          },
          "title": "Actions",
          "type": "array"
        },
        "output": {
          "format": "binary",
          "title": "Output",
          "type": "string"
        },
        "output_mime_type": {
          "default": "text/plain",
          "title": "Output Mime Type",
          "type": "string"
        }
      },
      "required": [
        "output"
      ],
      "title": "FixtureScript",
      "type": "object"
    },
    "ForbiddenEffect": {
      "additionalProperties": false,
      "description": "Oracle 明确禁止的结构化效果。",
      "properties": {
        "action": {
          "$ref": "#/$defs/CapabilityAction"
        },
        "sink": {
          "$ref": "#/$defs/ResourceRef"
        },
        "source": {
          "anyOf": [
            {
              "$ref": "#/$defs/ResourceRef"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "source",
        "action",
        "sink"
      ],
      "title": "ForbiddenEffect",
      "type": "object"
    },
    "HarnessConfig": {
      "additionalProperties": false,
      "description": "用于四格实验的 Harness 受控开关。",
      "properties": {
        "auto_approve_tools": {
          "title": "Auto Approve Tools",
          "type": "boolean"
        },
        "implicit_text_authorization": {
          "default": false,
          "title": "Implicit Text Authorization",
          "type": "boolean"
        },
        "persistent_memory": {
          "title": "Persistent Memory",
          "type": "boolean"
        },
        "provenance_mode": {
          "$ref": "#/$defs/ProvenanceMode"
        },
        "shared_context": {
          "title": "Shared Context",
          "type": "boolean"
        }
      },
      "required": [
        "shared_context",
        "persistent_memory",
        "auto_approve_tools",
        "provenance_mode"
      ],
      "title": "HarnessConfig",
      "type": "object"
    },
    "HookName": {
      "description": "T17 Reference Harness 必须显式声明的证据 Hook。",
      "enum": [
        "authorization",
        "decision_basis",
        "provenance",
        "influence",
        "revocation",
        "task_success"
      ],
      "title": "HookName",
      "type": "string"
    },
    "HttpSendArgs": {
      "additionalProperties": false,
      "description": "http_send 参数。",
      "properties": {
        "kind": {
          "const": "http_send",
          "default": "http_send",
          "title": "Kind",
          "type": "string"
        },
        "sensitivity": {
          "default": 0,
          "maximum": 4,
          "minimum": 0,
          "title": "Sensitivity",
          "type": "integer"
        },
        "sink": {
          "$ref": "#/$defs/ResourceRef"
        },
        "source": {
          "$ref": "#/$defs/ResourceRef"
        },
        "source_artifact_id": {
          "minLength": 1,
          "title": "Source Artifact Id",
          "type": "string"
        }
      },
      "required": [
        "source_artifact_id",
        "source",
        "sink"
      ],
      "title": "HttpSendArgs",
      "type": "object"
    },
    "InfluenceExpectationKind": {
      "description": "反事实预期只区分确认影响与明确无影响。",
      "enum": [
        "confirmed",
        "none"
      ],
      "title": "InfluenceExpectationKind",
      "type": "string"
    },
    "InputArtifactBinding": {
      "description": "把一个 Tool 参数的 source Artifact 绑定到调用输入。",
      "properties": {
        "input_index": {
          "title": "Input Index",
          "type": "integer"
        }
      },
      "required": [
        "input_index"
      ],
      "title": "InputArtifactBinding",
      "type": "object"
    },
    "InputArtifactGate": {
      "description": "按调用输入内容哈希选择结构基线决策键。",
      "properties": {
        "expected_content_hash": {
          "title": "Expected Content Hash",
          "type": "string"
        },
        "input_index": {
          "title": "Input Index",
          "type": "integer"
        },
        "mismatch_decision_key": {
          "title": "Mismatch Decision Key",
          "type": "string"
        }
      },
      "required": [
        "input_index",
        "expected_content_hash",
        "mismatch_decision_key"
      ],
      "title": "InputArtifactGate",
      "type": "object"
    },
    "Lifetime": {
      "description": "授权或效果的有效边界。",
      "enum": [
        "call",
        "task",
        "session",
        "persistent"
      ],
      "title": "Lifetime",
      "type": "string"
    },
    "LocalSkill": {
      "additionalProperties": false,
      "description": "运行输入包含完整可审计声明，不执行外部程序。",
      "properties": {
        "adaptation_note": {
          "minLength": 1,
          "title": "Adaptation Note",
          "type": "string"
        },
        "base_id": {
          "minLength": 1,
          "title": "Base Id",
          "type": "string"
        },
        "bundle": {
          "$ref": "#/$defs/SkillBundle"
        },
        "manifests": {
          "additionalProperties": {
            "$ref": "#/$defs/SkillManifest"
          },
          "propertyNames": {
            "minLength": 1
          },
          "title": "Manifests",
          "type": "object"
        },
        "paired_skill_id": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Paired Skill Id"
        },
        "role": {
          "enum": [
            "attack",
            "neutral",
            "benign-control"
          ],
          "title": "Role",
          "type": "string"
        },
        "scenario": {
          "$ref": "#/$defs/Scenario"
        },
        "scenario_path": {
          "minLength": 1,
          "title": "Scenario Path",
          "type": "string"
        },
        "scoring_labels": {
          "items": {
            "enum": [
              "privilege",
              "context-tool",
              "memory",
              "authorization"
            ],
            "type": "string"
          },
          "title": "Scoring Labels",
          "type": "array"
        },
        "skill_variant_id": {
          "minLength": 1,
          "title": "Skill Variant Id",
          "type": "string"
        },
        "split": {
          "enum": [
            "development",
            "held-out",
            "control"
          ],
          "title": "Split",
          "type": "string"
        },
        "task_contract": {
          "$ref": "#/$defs/NormalTaskContract"
        },
        "task_plan": {
          "$ref": "#/$defs/TrustedTaskPlan"
        }
      },
      "required": [
        "skill_variant_id",
        "base_id",
        "role",
        "split",
        "scenario_path",
        "scenario",
        "bundle",
        "manifests",
        "task_contract",
        "task_plan",
        "scoring_labels",
        "paired_skill_id",
        "adaptation_note"
      ],
      "title": "LocalSkill",
      "type": "object"
    },
    "ManifestPath": {
      "description": "只能指向 Scenario 受控 manifests 目录的相对路径。",
      "title": "ManifestPath",
      "type": "string"
    },
    "MetricExpectationKind": {
      "description": "不把 N/A 与数值零混同的封闭预期。",
      "enum": [
        "zero",
        "positive",
        "not_applicable"
      ],
      "title": "MetricExpectationKind",
      "type": "string"
    },
    "NormalArtifactRequirement": {
      "additionalProperties": false,
      "description": "普通任务输出的精确内容与 Session 合同。",
      "properties": {
        "alias": {
          "minLength": 1,
          "title": "Alias",
          "type": "string"
        },
        "expected_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Expected Sha256",
          "type": "string"
        },
        "session_id": {
          "minLength": 1,
          "title": "Session Id",
          "type": "string"
        }
      },
      "required": [
        "alias",
        "expected_sha256",
        "session_id"
      ],
      "title": "NormalArtifactRequirement",
      "type": "object"
    },
    "NormalEffectRequirement": {
      "additionalProperties": false,
      "description": "任务真正需要的资源/动作/Session，不读取风险 Golden。",
      "properties": {
        "rationale": {
          "minLength": 1,
          "title": "Rationale",
          "type": "string"
        },
        "selector": {
          "$ref": "#/$defs/EffectSelector"
        },
        "session_id": {
          "minLength": 1,
          "title": "Session Id",
          "type": "string"
        }
      },
      "required": [
        "selector",
        "session_id",
        "rationale"
      ],
      "title": "NormalEffectRequirement",
      "type": "object"
    },
    "NormalTaskContract": {
      "additionalProperties": false,
      "description": "新的功能性成功标准；风险判定是独立字段。",
      "properties": {
        "artifacts": {
          "items": {
            "$ref": "#/$defs/NormalArtifactRequirement"
          },
          "minItems": 1,
          "title": "Artifacts",
          "type": "array"
        },
        "benign_control": {
          "title": "Benign Control",
          "type": "boolean"
        },
        "effects": {
          "items": {
            "$ref": "#/$defs/NormalEffectRequirement"
          },
          "title": "Effects",
          "type": "array"
        },
        "evaluator_version": {
