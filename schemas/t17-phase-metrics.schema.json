{
  "$defs": {
    "AuthorizationAttemptClass": {
      "description": "不可信授权声明暴露的互斥分类。",
      "enum": [
        "authorization_laundering",
        "plain_authorization_bypass",
        "other_exposure",
        "not_exposed"
      ],
      "title": "AuthorizationAttemptClass",
      "type": "string"
    },
    "AuthorizationAttemptResult": {
      "additionalProperties": false,
      "description": "一次不可信授权声明暴露的分类证据。",
      "properties": {
        "authorization_request_id": {
          "minLength": 1,
          "title": "Authorization Request Id",
          "type": "string"
        },
        "classification": {
          "$ref": "#/$defs/AuthorizationAttemptClass"
        },
        "evidence_ids": {
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "title": "Evidence Ids",
          "type": "array"
        }
      },
      "required": [
        "authorization_request_id",
        "classification",
        "evidence_ids"
      ],
      "title": "AuthorizationAttemptResult",
      "type": "object"
    },
    "CanonicalEffectKey": {
      "additionalProperties": false,
      "description": "UEA 类型去重使用的规范化五元组。",
      "properties": {
        "action": {
          "$ref": "#/$defs/CapabilityAction"
        },
        "lifetime": {
          "$ref": "#/$defs/Lifetime"
        },
        "scope": {
          "$ref": "#/$defs/Scope"
        },
        "sink": {
          "$ref": "#/$defs/ResourceRef"
        },
        "source": {
          "anyOf": [
            {
              "$ref": "#/$defs/ResourceRef"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "source",
        "action",
        "sink",
        "scope",
        "lifetime"
      ],
      "title": "CanonicalEffectKey",
      "type": "object"
    },
    "CapabilityAction": {
      "description": "MVP 固定支持的能力动作。",
      "enum": [
        "file.read",
        "file.write",
        "memory.read",
        "memory.write",
        "network.send",
        "shell.execute",
        "user.confirm"
      ],
      "title": "CapabilityAction",
      "type": "string"
    },
    "DerivedMetric": {
      "additionalProperties": false,
      "description": "无单一整数分母的派生指标或结构化 N/A。",
      "properties": {
        "evidence_ids": {
          "default": [],
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "title": "Evidence Ids",
          "type": "array"
        },
        "status": {
          "$ref": "#/$defs/MetricStatus"
        },
        "value": {
          "anyOf": [
            {
              "maximum": 2.0,
              "minimum": -2.0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "title": "Value"
        }
      },
      "required": [
        "value",
        "status"
      ],
      "title": "DerivedMetric",
      "type": "object"
    },
    "EffectSelector": {
      "additionalProperties": false,
      "description": "把运行期多个 EffectRecord 映射到稳定别名。",
      "properties": {
        "action": {
          "$ref": "#/$defs/CapabilityAction"
        },
        "alias": {
          "minLength": 1,
          "title": "Alias",
          "type": "string"
        },
        "sink_pattern": {
          "$ref": "#/$defs/ResourceRef"
        },
        "source_pattern": {
          "anyOf": [
            {
              "$ref": "#/$defs/ResourceRef"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "alias",
        "action",
        "source_pattern",
        "sink_pattern"
      ],
      "title": "EffectSelector",
      "type": "object"
    },
    "EvidenceDomain": {
      "additionalProperties": false,
      "description": "一次可聚合实验的协议、Harness 与模型身份。",
      "properties": {
        "domain_id": {
          "minLength": 1,
          "title": "Domain Id",
          "type": "string"
        },
        "external_effects_simulated": {
          "title": "External Effects Simulated",
          "type": "boolean"
        },
        "kind": {
          "$ref": "#/$defs/EvidenceDomainKind"
        },
        "model_id": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Model Id"
        },
        "model_revision": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Model Revision"
        },
        "protocol_id": {
          "minLength": 1,
          "title": "Protocol Id",
          "type": "string"
        },
        "provider": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Provider"
        },
        "simulation_only": {
          "title": "Simulation Only",
          "type": "boolean"
        }
      },
      "required": [
        "domain_id",
        "kind",
        "protocol_id",
        "simulation_only",
        "external_effects_simulated"
      ],
      "title": "EvidenceDomain",
      "type": "object"
    },
    "EvidenceDomainKind": {
      "description": "禁止直接 micro 聚合的实验执行域。",
      "enum": [
        "contract",
        "scripted",
        "fake_provider",
        "direct_prompt",
        "reference_harness",
        "openclaw"
      ],
      "title": "EvidenceDomainKind",
      "type": "string"
    },
    "ExperimentRiskReport": {
      "additionalProperties": false,
      "description": "Experiment 层的原始四格、洗白和撤销残余聚合报告。",
      "properties": {
        "ALR": {
          "$ref": "#/$defs/RatioMetric"
        },
        "HIAA_pot": {
          "$ref": "#/$defs/HiaaPotentialMetric"
        },
        "HIAA_run": {
          "$ref": "#/$defs/DerivedMetric"
        },
        "RIR_1": {
          "$ref": "#/$defs/RatioMetric"
        },
        "RIR_3": {
          "$ref": "#/$defs/RatioMetric"
        },
        "authorization_attempts": {
          "items": {
            "$ref": "#/$defs/AuthorizationAttemptResult"
          },
          "title": "Authorization Attempts",
          "type": "array"
        },
        "authorization_laundering_request_ids": {
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "title": "Authorization Laundering Request Ids",
          "type": "array"
        },
        "experiment_id": {
          "minLength": 1,
          "title": "Experiment Id",
          "type": "string"
        },
        "harm_selector": {
          "$ref": "#/$defs/EffectSelector"
        },
        "hiaa_designs": {
          "default": [],
          "items": {
            "$ref": "#/$defs/HiaaDesignResult"
          },
          "title": "Hiaa Designs",
          "type": "array"
        },
        "p00": {
          "$ref": "#/$defs/MatrixCellMetric"
        },
        "p01": {
          "$ref": "#/$defs/MatrixCellMetric"
        },
        "p10": {
          "$ref": "#/$defs/MatrixCellMetric"
        },
        "p11": {
          "$ref": "#/$defs/MatrixCellMetric"
        },
        "plain_authorization_bypass_request_ids": {
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "title": "Plain Authorization Bypass Request Ids",
          "type": "array"
        },
        "raw_counts": {
          "$ref": "#/$defs/RawCounts"
        },
        "replay_ids": {
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "title": "Replay Ids",
          "type": "array"
        },
        "report_scope": {
          "const": "experiment",
          "title": "Report Scope",
          "type": "string"
        },
        "revocation": {
          "anyOf": [
            {
              "$ref": "#/$defs/SkillRevocationRecord"
            },
            {
              "type": "null"
            }
          ]
        },
        "run_ids": {
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "title": "Run Ids",
          "type": "array"
        },
        "schema_version": {
          "minLength": 1,
          "title": "Schema Version",
          "type": "string"
        }
      },
      "required": [
        "schema_version",
        "report_scope",
        "experiment_id",
        "run_ids",
        "replay_ids",
        "raw_counts",
        "harm_selector",
        "p00",
        "p01",
        "p10",
        "p11",
        "HIAA_pot",
        "HIAA_run",
        "ALR",
        "authorization_attempts",
        "authorization_laundering_request_ids",
        "plain_authorization_bypass_request_ids",
        "revocation",
        "RIR_1",
        "RIR_3"
      ],
      "title": "ExperimentRiskReport",
      "type": "object"
    },
    "HiaaCell": {
      "description": "目标 Skill 与 Harness 特性的四格组合。",
      "enum": [
        "p00",
        "p01",
        "p10",
        "p11"
      ],
      "title": "HiaaCell",
      "type": "string"
    },
    "HiaaDesignResult": {
      "additionalProperties": false,
      "description": "一套绑定同一 harm_selector 的完整 HIAA 四格结果。",
      "properties": {
        "HIAA_pot": {
          "$ref": "#/$defs/HiaaPotentialMetric"
        },
        "HIAA_run": {
          "$ref": "#/$defs/DerivedMetric"
        },
        "design_id": {
          "minLength": 1,
          "title": "Design Id",
          "type": "string"
        },
        "harm_selector": {
          "$ref": "#/$defs/EffectSelector"
        },
        "p00": {
          "$ref": "#/$defs/MatrixCellMetric"
        },
        "p01": {
          "$ref": "#/$defs/MatrixCellMetric"
        },
        "p10": {
          "$ref": "#/$defs/MatrixCellMetric"
        },
        "p11": {
          "$ref": "#/$defs/MatrixCellMetric"
        }
      },
      "required": [
        "design_id",
        "harm_selector",
        "p00",
        "p01",
        "p10",
        "p11",
        "HIAA_pot",
        "HIAA_run"
      ],
      "title": "HiaaDesignResult",
      "type": "object"
    },
    "HiaaPotentialMetric": {
      "additionalProperties": false,
      "description": "Harness 开启后新增可达未授权 Effect 集合的权重。",
      "properties": {
        "added_effect_keys": {
          "items": {
            "$ref": "#/$defs/CanonicalEffectKey"
          },
          "title": "Added Effect Keys",
          "type": "array"
        },
        "evidence_ids": {
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "title": "Evidence Ids",
          "type": "array"
        },
        "value": {
          "minimum": 0.0,
          "title": "Value",
          "type": "number"
        }
      },
      "required": [
        "value",
        "added_effect_keys",
        "evidence_ids"
      ],
      "title": "HiaaPotentialMetric",
      "type": "object"
    },
    "HookCapability": {
      "additionalProperties": false,
      "description": "一个场景对单项受信 Hook 的需求与实际可用性。",
      "properties": {
        "available": {
          "title": "Available",
          "type": "boolean"
        },
        "evidence_ids": {
          "default": [],
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "title": "Evidence Ids",
          "type": "array"
        },
        "hook": {
          "$ref": "#/$defs/HookName"
        },
        "reason": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Reason"
        },
        "required": {
          "title": "Required",
          "type": "boolean"
        },
        "status": {
          "$ref": "#/$defs/MeasurementStatus"
        }
      },
      "required": [
        "hook",
        "required",
        "available",
        "status"
      ],
      "title": "HookCapability",
      "type": "object"
    },
    "HookName": {
      "description": "T17 Reference Harness 必须显式声明的证据 Hook。",
      "enum": [
        "authorization",
        "decision_basis",
        "provenance",
        "influence",
        "revocation",
        "task_success"
      ],
      "title": "HookName",
      "type": "string"
    },
    "Lifetime": {
      "description": "授权或效果的有效边界。",
      "enum": [
        "call",
        "task",
        "session",
        "persistent"
      ],
      "title": "Lifetime",
      "type": "string"
    },
    "MatrixCellMetric": {
      "additionalProperties": false,
      "description": "一个 HIAA 单元格的原始 outcome、计数和发生率。",
      "properties": {
        "cell": {
          "$ref": "#/$defs/HiaaCell"
        },
        "effect_ids": {
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "title": "Effect Ids",
          "type": "array"
        },
        "executed_count": {
          "minimum": 0,
          "title": "Executed Count",
          "type": "integer"
        },
        "outcomes": {
          "items": {
            "type": "boolean"
          },
          "title": "Outcomes",
          "type": "array"
        },
        "rate": {
          "$ref": "#/$defs/RatioMetric"
        },
        "receipt_ids": {
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "title": "Receipt Ids",
          "type": "array"
        },
        "run_count": {
          "minimum": 0,
          "title": "Run Count",
          "type": "integer"
        },
        "run_ids": {
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "title": "Run Ids",
          "type": "array"
        }
      },
      "required": [
        "cell",
        "run_ids",
        "outcomes",
        "effect_ids",
        "receipt_ids",
        "executed_count",
        "run_count",
        "rate"
      ],
      "title": "MatrixCellMetric",
      "type": "object"
    },
    "MeasurementStatus": {
      "description": "T17 把已测、设计不适用、Hook 缺失和阶段不完整分开。",
      "enum": [
        "measured",
        "not_applicable",
        "not_available",
        "incomplete"
      ],
      "title": "MeasurementStatus",
      "type": "string"
    },
    "MetricStatus": {
      "description": "比例指标是否有可解释分母。",
      "enum": [
        "defined",
        "not_applicable"
      ],
      "title": "MetricStatus",
      "type": "string"
    },
    "ProvenanceAggregateSummary": {
      "additionalProperties": false,
      "description": "24 个核心 Run 的来源 micro 汇总。",
      "properties": {
        "by_boundary_depth": {
          "items": {
            "$ref": "#/$defs/ProvenanceDepthSummary"
          },
          "title": "By Boundary Depth",
          "type": "array"
        },
        "f1": {
          "$ref": "#/$defs/RatioMeasurement"
        },
        "fn": {
          "minimum": 0,
          "title": "Fn",
          "type": "integer"
        },
        "fp": {
          "minimum": 0,
          "title": "Fp",
          "type": "integer"
        },
        "precision": {
          "$ref": "#/$defs/RatioMeasurement"
        },
        "recall": {
          "$ref": "#/$defs/RatioMeasurement"
        },
        "tp": {
          "minimum": 0,
          "title": "Tp",
          "type": "integer"
        }
      },
      "required": [
        "tp",
        "fp",
        "fn",
        "precision",
        "recall",
        "f1",
        "by_boundary_depth"
      ],
      "title": "ProvenanceAggregateSummary",
      "type": "object"
    },
    "ProvenanceDepthSummary": {
      "additionalProperties": false,
      "description": "一个边界深度的 micro 来源计数、比例和相邻衰减。",
      "properties": {
        "boundary_depth": {
          "minimum": 0,
          "title": "Boundary Depth",
          "type": "integer"
        },
        "decay_status": {
          "$ref": "#/$defs/MeasurementStatus"
        },
        "decay_value": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Decay Value"
        },
        "f1": {
          "$ref": "#/$defs/RatioMeasurement"
        },
        "fn": {
          "minimum": 0,
          "title": "Fn",
          "type": "integer"
        },
        "fp": {
          "minimum": 0,
          "title": "Fp",
          "type": "integer"
        },
        "precision": {
          "$ref": "#/$defs/RatioMeasurement"
        },
        "recall": {
          "$ref": "#/$defs/RatioMeasurement"
        },
        "tp": {
          "minimum": 0,
          "title": "Tp",
          "type": "integer"
        }
      },
      "required": [
        "boundary_depth",
        "tp",
        "fp",
        "fn",
        "precision",
        "recall",
        "f1",
        "decay_status"
      ],
      "title": "ProvenanceDepthSummary",
      "type": "object"
    },
    "RatioMeasurement": {
      "additionalProperties": false,
      "description": "保留 scheduled/observed 计数且禁止把缺失证据伪装为零。",
      "properties": {
        "denominator": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Denominator"
        },
        "evidence_ids": {
          "default": [],
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "title": "Evidence Ids",
          "type": "array"
        },
        "numerator": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Numerator"
        },
        "reason": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Reason"
        },
        "scheduled_denominator": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Scheduled Denominator"
        },
        "status": {
          "$ref": "#/$defs/MeasurementStatus"
        },
        "value": {
          "anyOf": [
            {
              "maximum": 1.0,
              "minimum": 0.0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Value"
        }
      },
      "required": [
        "status"
      ],
      "title": "RatioMeasurement",
      "type": "object"
    },
    "RatioMetric": {
      "additionalProperties": false,
      "description": "值域为零到一的比例及其原始计数和证据。",
      "properties": {
        "denominator": {
          "minimum": 0,
          "title": "Denominator",
          "type": "integer"
        },
        "evidence_ids": {
          "default": [],
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "title": "Evidence Ids",
          "type": "array"
        },
        "numerator": {
          "minimum": 0,
          "title": "Numerator",
          "type": "integer"
        },
        "status": {
          "$ref": "#/$defs/MetricStatus"
        },
        "value": {
          "anyOf": [
            {
              "maximum": 1.0,
              "minimum": 0.0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "title": "Value"
        }
      },
      "required": [
        "numerator",
        "denominator",
        "value",
        "status"
      ],
      "title": "RatioMetric",
      "type": "object"
    },
    "RawCounts": {
      "additionalProperties": false,
      "description": "聚合指标的原始可复核计数。",
      "properties": {
        "implicit_authorization_liability_count": {
          "minimum": 0,
          "title": "Implicit Authorization Liability Count",
          "type": "integer"
        },
        "replay_count": {
          "minimum": 0,
          "title": "Replay Count",
          "type": "integer"
        },
        "run_count": {
          "minimum": 0,
          "title": "Run Count",
          "type": "integer"
        },
        "unauthorized_executed_count": {
          "minimum": 0,
          "title": "Unauthorized Executed Count",
          "type": "integer"
        }
      },
      "required": [
        "run_count",
        "replay_count",
        "unauthorized_executed_count",
        "implicit_authorization_liability_count"
      ],
      "title": "RawCounts",
      "type": "object"
    },
    "ReferenceLiveTelemetry": {
      "additionalProperties": false,
      "description": "一条 Reference Trial 的实际调用、Token、延迟和费用。",
      "properties": {
        "agent_step_count": {
          "title": "Agent Step Count",
          "type": "integer"
        },
        "api_call_count": {
          "title": "Api Call Count",
          "type": "integer"
        },
        "conservative_reserved_usd": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
              "type": "string"
            }
          ],
          "title": "Conservative Reserved Usd"
        },
        "estimated_cost_usd": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
              "type": "string"
            }
          ],
          "title": "Estimated Cost Usd"
        },
        "latency_ms": {
          "title": "Latency Ms",
          "type": "integer"
        },
        "no_call_count": {
          "title": "No Call Count",
          "type": "integer"
        },
        "refusal_count": {
          "title": "Refusal Count",
          "type": "integer"
        },
        "response_count": {
          "title": "Response Count",
          "type": "integer"
        },
        "retry_count": {
          "title": "Retry Count",
          "type": "integer"
        },
        "token_usage": {
          "$ref": "#/$defs/TokenUsage"
        }
      },
