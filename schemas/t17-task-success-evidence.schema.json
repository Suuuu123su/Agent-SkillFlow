{
  "$defs": {
    "TaskArtifactEvidence": {
      "additionalProperties": false,
      "description": "一个 required task alias 的存在性与内容 commitment。",
      "properties": {
        "alias": {
          "minLength": 1,
          "title": "Alias",
          "type": "string"
        },
        "artifact_id": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Artifact Id"
        },
        "content_sha256": {
          "anyOf": [
            {
              "pattern": "^[0-9a-f]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Content Sha256"
        },
        "expected_content_sha256": {
          "anyOf": [
            {
              "pattern": "^[0-9a-f]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Expected Content Sha256"
        },
        "matches_expected": {
          "title": "Matches Expected",
          "type": "boolean"
        },
        "present": {
          "title": "Present",
          "type": "boolean"
        },
        "session_id": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Session Id"
        }
      },
      "required": [
        "alias",
        "present",
        "matches_expected"
      ],
      "title": "TaskArtifactEvidence",
      "type": "object"
    },
    "TaskEffectEvidence": {
      "additionalProperties": false,
      "description": "一个 required task Effect 的执行与 Receipt 绑定。",
      "properties": {
        "effect_id": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Effect Id"
        },
        "present": {
          "title": "Present",
          "type": "boolean"
        },
        "receipt_id": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Receipt Id"
        },
        "selector_alias": {
          "minLength": 1,
          "title": "Selector Alias",
          "type": "string"
        },
        "session_id": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Session Id"
        }
      },
      "required": [
        "selector_alias",
        "present"
      ],
      "title": "TaskEffectEvidence",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "确定性 evaluator 的完整任务证据，而不是调用方裸布尔值。",
  "properties": {
    "artifacts": {
      "items": {
        "$ref": "#/$defs/TaskArtifactEvidence"
      },
      "minItems": 1,
      "title": "Artifacts",
      "type": "array"
    },
    "effects": {
      "items": {
        "$ref": "#/$defs/TaskEffectEvidence"
      },
      "title": "Effects",
      "type": "array"
    },
    "evaluator_id": {
      "const": "skillflow-t17-task-success-evaluator",
      "default": "skillflow-t17-task-success-evaluator",
      "title": "Evaluator Id",
      "type": "string"
    },
    "evaluator_version": {
      "const": "1.0.0",
      "default": "1.0.0",
      "title": "Evaluator Version",
      "type": "string"
    },
    "evidence_ids": {
      "items": {
        "minLength": 1,
        "type": "string"
      },
      "minItems": 1,
      "title": "Evidence Ids",
      "type": "array"
    },
    "reached_session_ids": {
      "items": {
        "minLength": 1,
        "type": "string"
      },
      "minItems": 1,
      "title": "Reached Session Ids",
      "type": "array"
    },
    "required_artifact_aliases": {
      "items": {
        "minLength": 1,
        "type": "string"
      },
      "minItems": 1,
      "title": "Required Artifact Aliases",
      "type": "array"
    },
    "required_effect_aliases": {
      "items": {
        "minLength": 1,
        "type": "string"
      },
      "title": "Required Effect Aliases",
      "type": "array"
    },
    "run_id": {
      "minLength": 1,
      "title": "Run Id",
      "type": "string"
    },
    "scenario_id": {
      "minLength": 1,
      "title": "Scenario Id",
      "type": "string"
    },
    "schema_version": {
      "const": "0.1",
      "default": "0.1",
      "title": "Schema Version",
      "type": "string"
    },
    "task_success": {
      "title": "Task Success",
      "type": "boolean"
    }
  },
  "required": [
    "run_id",
    "scenario_id",
    "task_success",
    "required_artifact_aliases",
    "required_effect_aliases",
    "artifacts",
    "effects",
    "reached_session_ids",
    "evidence_ids"
  ],
  "title": "T17TaskSuccessEvidence",
  "type": "object"
}
