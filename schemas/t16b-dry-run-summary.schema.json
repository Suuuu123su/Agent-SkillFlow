{
  "$defs": {
    "BudgetLimit": {
      "description": "立即停止的封闭预算边界。",
      "enum": [
        "live_disabled",
        "total_cost",
        "run_cost",
        "agent_turns",
        "output_tokens",
        "retries"
      ],
      "title": "BudgetLimit",
      "type": "string"
    },
    "BudgetStopEvidence": {
      "additionalProperties": false,
      "description": "达到预算后停止且保留既有 JSONL 的证据。",
      "properties": {
        "attempted_result_count": {
          "minimum": 1,
          "title": "Attempted Result Count",
          "type": "integer"
        },
        "existing_results_saved": {
          "title": "Existing Results Saved",
          "type": "boolean"
        },
        "limit": {
          "$ref": "#/$defs/BudgetLimit"
        },
        "saved_result_count": {
          "minimum": 1,
          "title": "Saved Result Count",
          "type": "integer"
        },
        "saved_results_sha256": {
          "minLength": 1,
          "title": "Saved Results Sha256",
          "type": "string"
        }
      },
      "required": [
        "limit",
        "attempted_result_count",
        "saved_result_count",
        "existing_results_saved",
        "saved_results_sha256"
      ],
      "title": "BudgetStopEvidence",
      "type": "object"
    },
    "CostCaseResult": {
      "additionalProperties": false,
      "description": "一个链长和费用边界的机械估算。",
      "properties": {
        "api_call_count": {
          "minimum": 1,
          "title": "Api Call Count",
          "type": "integer"
        },
        "estimated_cost_usd": {
          "anyOf": [
            {
              "minimum": 0.0,
              "type": "number"
            },
            {
              "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
              "type": "string"
            }
          ],
          "title": "Estimated Cost Usd"
        },
        "mode": {
          "$ref": "#/$defs/CostMode"
        },
        "profile": {
          "$ref": "#/$defs/CostChainProfile"
        },
        "token_usage": {
          "$ref": "#/$defs/TokenUsage"
        }
      },
      "required": [
        "profile",
        "mode",
        "token_usage",
        "api_call_count",
        "estimated_cost_usd"
      ],
      "title": "CostCaseResult",
      "type": "object"
    },
    "CostChainProfile": {
      "description": "费用演练的三种链长。",
      "enum": [
        "short",
        "normal",
        "m2_multi_session"
      ],
      "title": "CostChainProfile",
      "type": "string"
    },
    "CostMode": {
      "description": "模拟费用的两个边界。",
      "enum": [
        "normal",
        "worst_case"
      ],
      "title": "CostMode",
      "type": "string"
    },
    "CostSimulationReport": {
      "additionalProperties": false,
      "description": "不代表真实账单的模拟 Token 与费用保护报告。",
      "properties": {
        "agent_step_limit_blocked": {
          "title": "Agent Step Limit Blocked",
          "type": "boolean"
        },
        "cases": {
          "items": {
            "$ref": "#/$defs/CostCaseResult"
          },
          "title": "Cases",
          "type": "array"
        },
        "fake_provider_billed_cost_usd": {
          "anyOf": [
            {
              "minimum": 0.0,
              "type": "number"
            },
            {
              "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
              "type": "string"
            }
          ],
          "default": "0",
          "title": "Fake Provider Billed Cost Usd"
        },
        "partial_save": {
          "$ref": "#/$defs/BudgetStopEvidence"
        },
        "pricing": {
          "$ref": "#/$defs/PricingRates"
        },
        "rates_are_hypothetical": {
          "const": true,
          "default": true,
          "title": "Rates Are Hypothetical",
          "type": "boolean"
        },
        "retry_limit_blocked": {
          "title": "Retry Limit Blocked",
          "type": "boolean"
        },
        "schema_version": {
          "const": "0.1",
          "default": "0.1",
          "title": "Schema Version",
          "type": "string"
        },
        "simulation_only": {
          "const": true,
          "default": true,
          "title": "Simulation Only",
          "type": "boolean"
        },
        "single_run_limit_blocked": {
          "title": "Single Run Limit Blocked",
          "type": "boolean"
        },
        "total_limit_blocked": {
          "title": "Total Limit Blocked",
          "type": "boolean"
        }
      },
      "required": [
        "pricing",
        "cases",
        "single_run_limit_blocked",
        "total_limit_blocked",
        "agent_step_limit_blocked",
        "retry_limit_blocked",
        "partial_save"
      ],
      "title": "CostSimulationReport",
      "type": "object"
    },
    "DuplicateHandling": {
      "description": "重复链进入统计前的处理策略。",
      "enum": [
        "reject_duplicate_trial_id"
      ],
      "title": "DuplicateHandling",
      "type": "string"
    },
    "FailureInjectionKind": {
      "description": "T16-B 必须覆盖的失败及分类对照。",
      "enum": [
        "provider_timeout",
        "rate_limit",
        "gateway_crash",
        "missing_receipt",
        "usage_metadata_missing",
        "run_cost",
        "total_cost",
        "agent_steps",
        "retry_limit",
        "unexpected_network",
        "refusal",
        "no_call"
      ],
      "title": "FailureInjectionKind",
      "type": "string"
    },
    "FailureInjectionReport": {
      "additionalProperties": false,
      "description": "全部故障与分类对照的汇总。",
      "properties": {
        "all_blocked": {
          "title": "All Blocked",
          "type": "boolean"
        },
        "classifications_are_distinct": {
          "title": "Classifications Are Distinct",
          "type": "boolean"
        },
        "results": {
          "items": {
            "$ref": "#/$defs/FailureInjectionResult"
          },
          "title": "Results",
          "type": "array"
        },
        "schema_version": {
          "const": "0.1",
          "default": "0.1",
          "title": "Schema Version",
          "type": "string"
        },
        "simulation_only": {
          "const": true,
          "default": true,
          "title": "Simulation Only",
          "type": "boolean"
        }
      },
      "required": [
        "results",
        "all_blocked",
        "classifications_are_distinct"
      ],
      "title": "FailureInjectionReport",
      "type": "object"
    },
    "FailureInjectionResult": {
      "additionalProperties": false,
      "description": "一次本地失败注入的可审计结果。",
      "properties": {
        "blocked": {
          "title": "Blocked",
          "type": "boolean"
        },
        "disposition": {
          "$ref": "#/$defs/OperationalDisposition"
        },
        "kind": {
          "$ref": "#/$defs/FailureInjectionKind"
        },
        "observed_signal": {
          "minLength": 1,
          "title": "Observed Signal",
          "type": "string"
        }
      },
      "required": [
        "kind",
        "blocked",
        "observed_signal",
        "disposition"
      ],
      "title": "FailureInjectionResult",
      "type": "object"
    },
    "MatrixIntegrityReport": {
      "additionalProperties": false,
      "description": "720 链的机械完整性报告。",
      "properties": {
        "a1_neutralization_exact": {
          "title": "A1 Neutralization Exact",
          "type": "boolean"
        },
        "condition_count": {
          "minimum": 1,
          "title": "Condition Count",
          "type": "integer"
        },
        "denominators": {
          "$ref": "#/$defs/StatisticalDenominators"
        },
        "duplicate_handling": {
          "$ref": "#/$defs/DuplicateHandling"
        },
        "expected_trial_count": {
          "minimum": 1,
          "title": "Expected Trial Count",
          "type": "integer"
        },
        "hiaa_shared_harm_selector": {
          "title": "Hiaa Shared Harm Selector",
          "type": "boolean"
        },
        "m2_sessions_exact": {
          "title": "M2 Sessions Exact",
          "type": "boolean"
        },
        "operational_counts": {
          "$ref": "#/$defs/OperationalCounts"
        },
        "repeats_per_instance": {
          "minimum": 1,
          "title": "Repeats Per Instance",
          "type": "integer"
        },
        "scheduled_trial_count": {
          "minimum": 1,
          "title": "Scheduled Trial Count",
          "type": "integer"
        },
        "schema_version": {
          "const": "0.1",
          "default": "0.1",
          "title": "Schema Version",
          "type": "string"
        },
        "semantic_instances_per_condition": {
          "minimum": 1,
          "title": "Semantic Instances Per Condition",
          "type": "integer"
        },
        "simulation_only": {
          "const": true,
          "default": true,
          "title": "Simulation Only",
          "type": "boolean"
        },
        "slot_count": {
          "minimum": 1,
          "title": "Slot Count",
          "type": "integer"
        },
        "target_neutral_pair_ids_aligned": {
          "title": "Target Neutral Pair Ids Aligned",
          "type": "boolean"
        },
        "unique_trial_id_count": {
          "minimum": 1,
          "title": "Unique Trial Id Count",
          "type": "integer"
        }
      },
      "required": [
        "expected_trial_count",
        "scheduled_trial_count",
        "unique_trial_id_count",
        "slot_count",
        "condition_count",
        "semantic_instances_per_condition",
        "repeats_per_instance",
        "target_neutral_pair_ids_aligned",
        "hiaa_shared_harm_selector",
        "m2_sessions_exact",
        "a1_neutralization_exact",
        "duplicate_handling",
        "denominators",
        "operational_counts"
      ],
      "title": "MatrixIntegrityReport",
      "type": "object"
    },
    "OperationalCounts": {
      "additionalProperties": false,
      "description": "仅用于管线检查、不能视为现实 ASR 的计数。",
      "properties": {
        "completed_without_harm": {
          "minimum": 0,
          "title": "Completed Without Harm",
          "type": "integer"
        },
        "harm": {
          "minimum": 0,
          "title": "Harm",
          "type": "integer"
        },
        "invalid_other": {
          "minimum": 0,
          "title": "Invalid Other",
          "type": "integer"
        },
        "no_call": {
          "minimum": 0,
          "title": "No Call",
          "type": "integer"
        },
        "refusal": {
          "minimum": 0,
          "title": "Refusal",
          "type": "integer"
        }
      },
      "required": [
        "harm",
        "completed_without_harm",
        "refusal",
        "no_call",
        "invalid_other"
      ],
      "title": "OperationalCounts",
      "type": "object"
    },
    "OperationalDisposition": {
      "description": "不改变三分类定义的操作性细分。",
      "enum": [
        "harm",
        "completed_without_harm",
        "refusal",
        "no_call",
        "invalid_other"
      ],
      "title": "OperationalDisposition",
      "type": "string"
    },
    "PricingRates": {
      "additionalProperties": false,
      "description": "每百万 token 的美元估算价格。",
      "properties": {
        "cache_write_per_million_usd": {
          "anyOf": [
            {
              "minimum": 0.0,
              "type": "number"
            },
            {
              "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
              "type": "string"
            }
          ],
          "default": "0",
          "title": "Cache Write Per Million Usd"
        },
        "cached_input_per_million_usd": {
          "anyOf": [
            {
              "minimum": 0.0,
              "type": "number"
            },
            {
              "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
              "type": "string"
            }
          ],
          "title": "Cached Input Per Million Usd"
        },
        "input_per_million_usd": {
          "anyOf": [
            {
              "minimum": 0.0,
              "type": "number"
            },
            {
              "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
              "type": "string"
            }
          ],
          "title": "Input Per Million Usd"
        },
        "output_per_million_usd": {
          "anyOf": [
            {
              "minimum": 0.0,
              "type": "number"
            },
            {
              "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
              "type": "string"
            }
          ],
          "title": "Output Per Million Usd"
        },
        "reasoning_per_million_usd": {
          "anyOf": [
            {
              "minimum": 0.0,
              "type": "number"
            },
            {
              "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
              "type": "string"
            }
          ],
          "title": "Reasoning Per Million Usd"
        },
        "status": {
          "$ref": "#/$defs/PricingStatus"
        }
      },
      "required": [
        "status",
        "input_per_million_usd",
        "cached_input_per_million_usd",
        "output_per_million_usd",
        "reasoning_per_million_usd"
      ],
      "title": "PricingRates",
      "type": "object"
    },
    "PricingStatus": {
      "description": "价格是否已冻结到可执行状态。",
      "enum": [
        "fake_zero",
        "live_pending",
        "live_pinned"
      ],
      "title": "PricingStatus",
      "type": "string"
    },
    "StatisticalDenominators": {
      "additionalProperties": false,
      "description": "忽略 Fake Slot 与 repeat 的唯一预注册单位。",
      "properties": {
        "fake_repeats_are_independent_samples": {
          "const": false,
          "default": false,
          "title": "Fake Repeats Are Independent Samples",
          "type": "boolean"
        },
        "unique_condition_instances": {
          "minimum": 1,
          "title": "Unique Condition Instances",
          "type": "integer"
        },
        "unique_pair_instances": {
          "minimum": 1,
          "title": "Unique Pair Instances",
          "type": "integer"
        }
      },
      "required": [
        "unique_condition_instances",
        "unique_pair_instances"
      ],
      "title": "StatisticalDenominators",
      "type": "object"
    },
    "TokenUsage": {
      "additionalProperties": false,
      "description": "TrialResult 所需的生成、缓存读写与推理 token 计数。",
      "properties": {
        "cache_write_tokens": {
          "default": 0,
          "minimum": 0,
          "title": "Cache Write Tokens",
          "type": "integer"
        },
        "cached_input_tokens": {
          "minimum": 0,
          "title": "Cached Input Tokens",
          "type": "integer"
        },
        "input_tokens": {
          "minimum": 0,
          "title": "Input Tokens",
          "type": "integer"
        },
        "output_tokens": {
          "minimum": 0,
          "title": "Output Tokens",
          "type": "integer"
        },
        "reasoning_tokens": {
          "minimum": 0,
          "title": "Reasoning Tokens",
          "type": "integer"
        }
      },
      "required": [
        "input_tokens",
        "cached_input_tokens",
        "output_tokens",
        "reasoning_tokens"
      ],
      "title": "TokenUsage",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "可提交的 T16-B 总报告；明确排除现实安全结论。",
  "properties": {
    "cost_simulation": {
      "$ref": "#/$defs/CostSimulationReport"
    },
    "external_review_status": {
      "const": "review_unavailable",
      "title": "External Review Status",
      "type": "string"
    },
    "failure_injection": {
      "$ref": "#/$defs/FailureInjectionReport"
    },
    "fake_repeats_are_independent_samples": {
      "const": false,
      "default": false,
      "title": "Fake Repeats Are Independent Samples",
      "type": "boolean"
    },
    "id": {
      "minLength": 1,
      "title": "Id",
      "type": "string"
    },
    "matrix_integrity": {
      "$ref": "#/$defs/MatrixIntegrityReport"
    },
    "model_slots": {
      "maxItems": 2,
      "minItems": 2,
      "prefixItems": [
        {
          "minLength": 1,
          "type": "string"
        },
        {
          "minLength": 1,
          "type": "string"
        }
      ],
      "title": "Model Slots",
      "type": "array"
    },
    "real_attack_success_rate_status": {
      "const": "not_applicable",
      "title": "Real Attack Success Rate Status",
      "type": "string"
    },
    "real_model_safety_conclusion_supported": {
      "const": false,
      "default": false,
      "title": "Real Model Safety Conclusion Supported",
      "type": "boolean"
    },
    "schema_version": {
      "const": "0.1",
      "default": "0.1",
      "title": "Schema Version",
      "type": "string"
    },
    "simulation_only": {
      "const": true,
      "default": true,
      "title": "Simulation Only",
      "type": "boolean"
    },
    "trial_results_artifact": {
      "minLength": 1,
      "title": "Trial Results Artifact",
      "type": "string"
    },
    "trial_results_sha256": {
      "minLength": 1,
      "title": "Trial Results Sha256",
      "type": "string"
    }
  },
  "required": [
    "id",
    "real_attack_success_rate_status",
    "external_review_status",
    "model_slots",
    "trial_results_artifact",
    "trial_results_sha256",
    "matrix_integrity",
    "failure_injection",
    "cost_simulation"
  ],
  "title": "T16BDryRunSummary",
  "type": "object"
}
