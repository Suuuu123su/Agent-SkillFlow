{
  "$defs": {
    "Artifact": {
      "additionalProperties": false,
      "description": "一个不可变的数据版本。",
      "properties": {
        "artifact_id": {
          "minLength": 1,
          "title": "Artifact Id",
          "type": "string"
        },
        "artifact_type": {
          "$ref": "#/$defs/ArtifactType"
        },
        "content_hash": {
          "minLength": 1,
          "title": "Content Hash",
          "type": "string"
        },
        "content_length": {
          "minimum": 0,
          "title": "Content Length",
          "type": "integer"
        },
        "created_by_event_id": {
          "minLength": 1,
          "title": "Created By Event Id",
          "type": "string"
        },
        "mime_type": {
          "minLength": 1,
          "title": "Mime Type",
          "type": "string"
        },
        "observed_label": {
          "$ref": "#/$defs/SecurityLabel"
        }
      },
      "required": [
        "artifact_id",
        "artifact_type",
        "content_hash",
        "content_length",
        "mime_type",
        "created_by_event_id",
        "observed_label"
      ],
      "title": "Artifact",
      "type": "object"
    },
    "ArtifactType": {
      "description": "不可变数据版本的类别。",
      "enum": [
        "context",
        "memory",
        "file",
        "skill_output",
        "tool_arg",
        "tool_return"
      ],
      "title": "ArtifactType",
      "type": "string"
    },
    "AuthorizationGrant": {
      "additionalProperties": false,
      "description": "由用户或可信策略签发的能力授权。",
      "properties": {
        "action": {
          "$ref": "#/$defs/CapabilityAction"
        },
        "call_id": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Call Id"
        },
        "expires_at": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Expires At"
        },
        "grant_id": {
          "minLength": 1,
          "title": "Grant Id",
          "type": "string"
        },
        "grantee_id": {
          "minLength": 1,
          "title": "Grantee Id",
          "type": "string"
        },
        "issuer_id": {
          "minLength": 1,
          "title": "Issuer Id",
          "type": "string"
        },
        "issuer_type": {
          "enum": [
            "user",
            "trusted_policy"
          ],
          "title": "Issuer Type",
          "type": "string"
        },
        "lifetime": {
          "$ref": "#/$defs/Lifetime"
        },
        "scope": {
          "$ref": "#/$defs/Scope"
        },
        "session_id": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Session Id"
        },
        "sink_pattern": {
          "$ref": "#/$defs/ResourceRef"
        },
        "source_pattern": {
          "anyOf": [
            {
              "$ref": "#/$defs/ResourceRef"
            },
            {
              "type": "null"
            }
          ]
        },
        "task_id": {
          "minLength": 1,
          "title": "Task Id",
          "type": "string"
        },
        "valid_from": {
          "format": "date-time",
          "title": "Valid From",
          "type": "string"
        }
      },
      "required": [
        "grant_id",
        "issuer_id",
        "issuer_type",
        "grantee_id",
        "action",
        "source_pattern",
        "sink_pattern",
        "scope",
        "lifetime",
        "task_id",
        "valid_from"
      ],
      "title": "AuthorizationGrant",
      "type": "object"
    },
    "CapabilityAction": {
      "description": "MVP 固定支持的能力动作。",
      "enum": [
        "file.read",
        "file.write",
        "memory.read",
        "memory.write",
        "network.send",
        "shell.execute",
        "user.confirm"
      ],
      "title": "CapabilityAction",
      "type": "string"
    },
    "CapabilityEffect": {
      "additionalProperties": false,
      "description": "可比较的结构化能力效果。",
      "properties": {
        "action": {
          "$ref": "#/$defs/CapabilityAction"
        },
        "lifetime": {
          "$ref": "#/$defs/Lifetime"
        },
        "scope": {
          "$ref": "#/$defs/Scope"
        },
        "sensitivity": {
          "maximum": 4,
          "minimum": 0,
          "title": "Sensitivity",
          "type": "integer"
        },
        "sink": {
          "$ref": "#/$defs/ResourceRef"
        },
        "source": {
          "anyOf": [
            {
              "$ref": "#/$defs/ResourceRef"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "source",
        "action",
        "sink",
        "scope",
        "lifetime",
        "sensitivity"
      ],
      "title": "CapabilityEffect",
      "type": "object"
    },
    "Decision": {
      "description": "Harness 或策略的结构化决策。",
      "enum": [
        "allow",
        "deny",
        "confirm"
      ],
      "title": "Decision",
      "type": "string"
    },
    "DecisionFact": {
      "additionalProperties": false,
      "description": "动作选择记录；没有权限、来源和回执自报字段。",
      "properties": {
        "allowed_action_ids": {
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "title": "Allowed Action Ids",
          "type": "array"
        },
        "behavior": {
          "enum": [
            "normal",
            "refusal",
            "no_call",
            "schema_rejection"
          ],
          "title": "Behavior",
          "type": "string"
        },
        "call_id": {
          "minLength": 1,
          "title": "Call Id",
          "type": "string"
        },
        "implementation": {
          "minLength": 1,
          "title": "Implementation",
          "type": "string"
        },
        "run_id": {
          "minLength": 1,
          "title": "Run Id",
          "type": "string"
        },
        "schema_valid": {
          "title": "Schema Valid",
          "type": "boolean"
        },
        "selected_action_ids": {
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "title": "Selected Action Ids",
          "type": "array"
        },
        "session_id": {
          "minLength": 1,
          "title": "Session Id",
          "type": "string"
        },
        "step_id": {
          "minLength": 1,
          "title": "Step Id",
          "type": "string"
        }
      },
      "required": [
        "run_id",
        "session_id",
        "step_id",
        "call_id",
        "implementation",
        "allowed_action_ids",
        "selected_action_ids",
        "behavior",
        "schema_valid"
      ],
      "title": "DecisionFact",
      "type": "object"
    },
    "DecisionRecord": {
      "additionalProperties": false,
      "description": "同时保留基线、策略、授权和执行四个事实。",
      "properties": {
        "authorized": {
          "title": "Authorized",
          "type": "boolean"
        },
        "baseline_result": {
          "$ref": "#/$defs/Decision"
        },
        "decision_basis_artifact_ids": {
          "default": [],
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "title": "Decision Basis Artifact Ids",
          "type": "array"
        },
        "decision_id": {
          "minLength": 1,
          "title": "Decision Id",
          "type": "string"
        },
        "enforcement_mode": {
          "$ref": "#/$defs/EnforcementMode"
        },
        "executed": {
          "title": "Executed",
          "type": "boolean"
        },
        "manifest_id": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Manifest Id"
        },
        "matched_grant_ids": {
          "default": [],
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "title": "Matched Grant Ids",
          "type": "array"
        },
        "policy_result": {
          "$ref": "#/$defs/Decision"
        },
        "reason_codes": {
          "default": [],
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "title": "Reason Codes",
          "type": "array"
        },
        "request_event_id": {
          "minLength": 1,
          "title": "Request Event Id",
          "type": "string"
        }
      },
      "required": [
        "decision_id",
        "request_event_id",
        "enforcement_mode",
        "baseline_result",
        "policy_result",
        "authorized",
        "executed"
      ],
      "title": "DecisionRecord",
      "type": "object"
    },
    "EffectRecord": {
      "additionalProperties": false,
      "description": "一次运行中的效果请求与执行结果。",
      "properties": {
        "decision_id": {
          "minLength": 1,
          "title": "Decision Id",
          "type": "string"
        },
        "effect": {
          "$ref": "#/$defs/CapabilityEffect"
        },
        "effect_alias": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Effect Alias"
        },
        "effect_id": {
          "minLength": 1,
          "title": "Effect Id",
          "type": "string"
        },
        "executed": {
          "title": "Executed",
          "type": "boolean"
        },
        "request_event_id": {
          "minLength": 1,
          "title": "Request Event Id",
          "type": "string"
        },
        "result_event_id": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Result Event Id"
        },
        "tool_receipt_id": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Tool Receipt Id"
        }
      },
      "required": [
        "effect_id",
        "effect",
        "request_event_id",
        "decision_id",
        "executed"
      ],
      "title": "EffectRecord",
      "type": "object"
    },
    "EffectSelector": {
      "additionalProperties": false,
      "description": "把运行期多个 EffectRecord 映射到稳定别名。",
      "properties": {
        "action": {
          "$ref": "#/$defs/CapabilityAction"
        },
        "alias": {
          "minLength": 1,
          "title": "Alias",
          "type": "string"
        },
        "sink_pattern": {
          "$ref": "#/$defs/ResourceRef"
        },
        "source_pattern": {
          "anyOf": [
            {
              "$ref": "#/$defs/ResourceRef"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "alias",
        "action",
        "source_pattern",
        "sink_pattern"
      ],
      "title": "EffectSelector",
      "type": "object"
    },
    "EnforcementMode": {
      "description": "策略只观察或实际阻断。",
      "enum": [
        "monitor",
        "enforce"
      ],
      "title": "EnforcementMode",
      "type": "string"
    },
    "EventType": {
      "description": "追加式安全事件类别。",
      "enum": [
        "run_start",
        "run_end",
        "session_start",
        "session_end",
        "skill_install",
        "skill_load",
        "skill_invoke",
        "skill_return",
        "skill_revoke",
        "skill_unload",
        "context_add",
        "context_read",
        "context_summarize",
        "memory_write",
        "memory_read",
        "memory_delete",
        "file_read",
        "file_write",
        "tool_call_request",
        "tool_call_allow",
        "tool_call_deny",
        "tool_call_result",
        "auth_claim_observed",
        "auth_grant",
        "auth_revoke",
        "artifact_register",
        "artifact_derive",
        "sensitive_effect"
      ],
      "title": "EventType",
      "type": "string"
    },
    "ExecutionIssue": {
      "additionalProperties": false,
      "description": "受信步骤编排器记录的输入缺失，不冒充基础设施错误。",
      "properties": {
        "reason": {
          "enum": [
            "missing_input",
            "memory_not_present"
          ],
          "title": "Reason",
          "type": "string"
        },
        "references": {
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "title": "References",
          "type": "array"
        },
        "run_id": {
          "minLength": 1,
          "title": "Run Id",
          "type": "string"
        },
        "session_id": {
          "minLength": 1,
          "title": "Session Id",
          "type": "string"
        },
        "step_id": {
          "minLength": 1,
          "title": "Step Id",
          "type": "string"
        }
      },
      "required": [
        "run_id",
        "session_id",
        "step_id",
        "reason",
        "references"
      ],
      "title": "ExecutionIssue",
      "type": "object"
    },
    "FrozenFile": {
      "additionalProperties": false,
      "description": "单个已存在文件的哈希、长度及可选逐行记录数。",
      "properties": {
        "records": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Records"
        },
        "sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Sha256",
          "type": "string"
        },
        "size_bytes": {
          "minimum": 0,
          "title": "Size Bytes",
          "type": "integer"
        }
      },
      "required": [
        "sha256",
        "size_bytes"
      ],
      "title": "FrozenFile",
      "type": "object"
    },
    "JsonValue": {},
    "Lifetime": {
      "description": "授权或效果的有效边界。",
      "enum": [
        "call",
        "task",
        "session",
        "persistent"
      ],
      "title": "Lifetime",
      "type": "string"
    },
    "MockToolName": {
      "description": "安全 Mock Tool 白名单。",
      "enum": [
        "read_file",
        "write_memory",
        "read_memory",
        "http_send",
        "shell_exec"
      ],
      "title": "MockToolName",
      "type": "string"
    },
    "PortableRun": {
      "additionalProperties": false,
      "description": "从一个运行的事件库和回执恢复；不含 Blob 内容。",
      "properties": {
        "artifacts": {
          "items": {
            "$ref": "#/$defs/Artifact"
          },
          "title": "Artifacts",
          "type": "array"
        },
        "decisions": {
          "items": {
            "$ref": "#/$defs/DecisionRecord"
          },
          "title": "Decisions",
          "type": "array"
        },
        "effects": {
          "items": {
            "$ref": "#/$defs/EffectRecord"
          },
          "title": "Effects",
          "type": "array"
        },
        "events": {
          "items": {
            "$ref": "#/$defs/SecurityEvent"
          },
          "title": "Events",
          "type": "array"
        },
        "grants": {
          "items": {
            "$ref": "#/$defs/AuthorizationGrant"
          },
          "title": "Grants",
          "type": "array"
        },
        "receipts": {
          "items": {
            "$ref": "#/$defs/ToolReceiptDraft"
          },
          "title": "Receipts",
          "type": "array"
        },
        "revocations": {
          "items": {
            "$ref": "#/$defs/RevocationRecord"
          },
          "title": "Revocations",
          "type": "array"
        },
        "run_id": {
          "minLength": 1,
          "title": "Run Id",
          "type": "string"
        },
        "schema_version": {
          "const": "2.0",
          "default": "2.0",
          "title": "Schema Version",
          "type": "string"
        }
      },
      "required": [
        "run_id",
        "events",
        "artifacts",
        "decisions",
        "effects",
        "grants",
        "revocations",
        "receipts"
      ],
      "title": "PortableRun",
      "type": "object"
    },
    "ReplayControlEvidence": {
      "additionalProperties": false,
      "description": "证明两分支共享运行条件的一组规范化摘要。",
      "properties": {
        "checkpoint_state_hash": {
          "minLength": 1,
          "title": "Checkpoint State Hash",
          "type": "string"
        },
        "clock_start": {
          "minLength": 1,
          "title": "Clock Start",
          "type": "string"
        },
        "decisions_hash": {
          "minLength": 1,
          "title": "Decisions Hash",
          "type": "string"
        },
        "grants_hash": {
          "minLength": 1,
          "title": "Grants Hash",
          "type": "string"
        },
        "manifests_hash": {
          "minLength": 1,
          "title": "Manifests Hash",
          "type": "string"
        },
        "same_other_inputs": {
          "const": true,
          "default": true,
          "title": "Same Other Inputs",
          "type": "boolean"
        },
        "same_permissions": {
          "const": true,
          "default": true,
          "title": "Same Permissions",
          "type": "boolean"
        },
        "same_seed": {
          "const": true,
          "default": true,
          "title": "Same Seed",
          "type": "boolean"
        },
        "same_time": {
          "const": true,
          "default": true,
          "title": "Same Time",
          "type": "boolean"
        },
        "same_tool_returns": {
          "const": true,
          "default": true,
          "title": "Same Tool Returns",
          "type": "boolean"
        },
        "same_tool_set": {
          "const": true,
          "default": true,
          "title": "Same Tool Set",
          "type": "boolean"
        },
        "scripts_hash": {
          "minLength": 1,
          "title": "Scripts Hash",
          "type": "string"
        },
        "seed_hash": {
          "minLength": 1,
          "title": "Seed Hash",
          "type": "string"
        }
      },
      "required": [
        "seed_hash",
        "scripts_hash",
        "decisions_hash",
        "manifests_hash",
        "grants_hash",
        "clock_start",
        "checkpoint_state_hash"
      ],
      "title": "ReplayControlEvidence",
      "type": "object"
    },
    "ReplayInterventionEvidence": {
      "additionalProperties": false,
      "description": "不包含正文或宿主路径的 Artifact 干预证据。",
      "properties": {
        "artifact_type": {
          "$ref": "#/$defs/ArtifactType"
        },
        "content_hash": {
          "minLength": 1,
          "title": "Content Hash",
          "type": "string"
        },
        "content_length": {
          "minimum": 0,
          "title": "Content Length",
          "type": "integer"
        },
        "derived_artifact_id": {
          "minLength": 1,
          "title": "Derived Artifact Id",
          "type": "string"
        },
        "mime_type": {
          "minLength": 1,
          "title": "Mime Type",
          "type": "string"
        },
        "mode": {
          "enum": [
            "identity",
            "neutral"
          ],
          "title": "Mode",
          "type": "string"
        },
        "schema_preserved": {
          "title": "Schema Preserved",
          "type": "boolean"
        },
        "source_artifact_id": {
          "minLength": 1,
          "title": "Source Artifact Id",
          "type": "string"
        }
      },
      "required": [
        "mode",
        "source_artifact_id",
        "derived_artifact_id",
        "artifact_type",
        "mime_type",
        "content_hash",
        "content_length",
        "schema_preserved"
      ],
      "title": "ReplayInterventionEvidence",
      "type": "object"
    },
    "ReplayPairManifest": {
      "additionalProperties": false,
      "description": "一对恢复分支的确定性、隔离性与结构守恒清单。",
      "properties": {
        "added_effect_ids": {
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "title": "Added Effect Ids",
          "type": "array"
        },
        "checkpoint_id": {
          "minLength": 1,
          "title": "Checkpoint Id",
          "type": "string"
        },
        "checkpoint_prefix_hash": {
          "minLength": 1,
          "title": "Checkpoint Prefix Hash",
          "type": "string"
        },
        "checkpoint_state_hash": {
          "minLength": 1,
          "title": "Checkpoint State Hash",
          "type": "string"
        },
        "controls": {
          "$ref": "#/$defs/ReplayControlEvidence"
        },
        "neutral_effect_ids": {
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "title": "Neutral Effect Ids",
          "type": "array"
        },
        "neutral_intervention": {
          "$ref": "#/$defs/ReplayInterventionEvidence"
        },
        "neutral_prefix_hash": {
          "minLength": 1,
          "title": "Neutral Prefix Hash",
          "type": "string"
        },
        "neutral_restore_state_hash": {
          "minLength": 1,
          "title": "Neutral Restore State Hash",
          "type": "string"
        },
        "neutral_run_id": {
          "minLength": 1,
          "title": "Neutral Run Id",
          "type": "string"
        },
        "original_effect_ids": {
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "title": "Original Effect Ids",
          "type": "array"
        },
        "original_intervention": {
          "$ref": "#/$defs/ReplayInterventionEvidence"
        },
        "original_prefix_hash": {
          "minLength": 1,
          "title": "Original Prefix Hash",
          "type": "string"
        },
        "original_restore_state_hash": {
          "minLength": 1,
          "title": "Original Restore State Hash",
          "type": "string"
        },
        "original_run_id": {
          "minLength": 1,
          "title": "Original Run Id",
          "type": "string"
        },
        "removed_effect_ids": {
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "title": "Removed Effect Ids",
          "type": "array"
        },
        "replay_id": {
          "minLength": 1,
          "title": "Replay Id",
