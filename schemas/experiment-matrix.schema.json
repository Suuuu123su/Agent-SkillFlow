{
  "$defs": {
    "AuthorizationCondition": {
      "description": "实验中被暴露的授权来源条件。",
      "enum": [
        "none",
        "implicit_text",
        "structured_confirmation"
      ],
      "title": "AuthorizationCondition",
      "type": "string"
    },
    "CapabilityAction": {
      "description": "MVP 固定支持的能力动作。",
      "enum": [
        "file.read",
        "file.write",
        "memory.read",
        "memory.write",
        "network.send",
        "shell.execute",
        "user.confirm"
      ],
      "title": "CapabilityAction",
      "type": "string"
    },
    "EffectSelector": {
      "additionalProperties": false,
      "description": "把运行期多个 EffectRecord 映射到稳定别名。",
      "properties": {
        "action": {
          "$ref": "#/$defs/CapabilityAction"
        },
        "alias": {
          "minLength": 1,
          "title": "Alias",
          "type": "string"
        },
        "sink_pattern": {
          "$ref": "#/$defs/ResourceRef"
        },
        "source_pattern": {
          "anyOf": [
            {
              "$ref": "#/$defs/ResourceRef"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "alias",
        "action",
        "source_pattern",
        "sink_pattern"
      ],
      "title": "EffectSelector",
      "type": "object"
    },
    "EnforcementMode": {
      "description": "策略只观察或实际阻断。",
      "enum": [
        "monitor",
        "enforce"
      ],
      "title": "EnforcementMode",
      "type": "string"
    },
    "ExperimentVariant": {
      "additionalProperties": false,
      "description": "一个 Scenario 与受控 Harness 开关的确定性配置。",
      "properties": {
        "authorization_condition": {
          "$ref": "#/$defs/AuthorizationCondition",
          "default": "none"
        },
        "auto_approve_tools": {
          "title": "Auto Approve Tools",
          "type": "boolean"
        },
        "enforcement_mode": {
          "$ref": "#/$defs/EnforcementMode"
        },
        "harm_selector": {
          "anyOf": [
            {
              "$ref": "#/$defs/EffectSelector"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "hiaa_cell": {
          "anyOf": [
            {
              "$ref": "#/$defs/HiaaCell"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "hiaa_design_id": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Hiaa Design Id"
        },
        "implicit_text_authorization": {
          "title": "Implicit Text Authorization",
          "type": "boolean"
        },
        "pair_id": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Pair Id"
        },
        "persistent_memory": {
          "title": "Persistent Memory",
          "type": "boolean"
        },
        "provenance_mode": {
          "$ref": "#/$defs/ProvenanceMode"
        },
        "run_role": {
          "$ref": "#/$defs/MatrixRunRole",
          "default": "core"
        },
        "scenario": {
          "$ref": "#/$defs/ScenarioPath"
        },
        "seed": {
          "title": "Seed",
          "type": "integer"
        },
        "session_condition": {
          "$ref": "#/$defs/SessionCondition",
          "default": "original"
        },
        "shared_context": {
          "title": "Shared Context",
          "type": "boolean"
        },
        "skill_state": {
          "$ref": "#/$defs/SkillStateCondition",
          "default": "normal"
        },
        "target_skill_present": {
          "title": "Target Skill Present",
          "type": "boolean"
        },
        "variant": {
          "minLength": 1,
          "title": "Variant",
          "type": "string"
        }
      },
      "required": [
        "variant",
        "scenario",
        "seed",
        "target_skill_present",
        "shared_context",
        "persistent_memory",
        "auto_approve_tools",
        "enforcement_mode",
        "provenance_mode",
        "implicit_text_authorization"
      ],
      "title": "ExperimentVariant",
      "type": "object"
    },
    "HarnessFeature": {
      "description": "首版可做开关对照的 Harness 布尔特性。",
      "enum": [
        "shared_context",
        "persistent_memory",
        "auto_approve_tools",
        "implicit_text_authorization"
      ],
      "title": "HarnessFeature",
      "type": "string"
    },
    "HiaaCell": {
      "description": "目标 Skill 与 Harness 特性的四格组合。",
      "enum": [
        "p00",
        "p01",
        "p10",
        "p11"
      ],
      "title": "HiaaCell",
      "type": "string"
    },
    "HiaaDesign": {
      "additionalProperties": false,
      "description": "自动生成四格矩阵所需的全部预注册控制条件。",
      "properties": {
        "auto_approve_tools": {
          "title": "Auto Approve Tools",
          "type": "boolean"
        },
        "enforcement_mode": {
          "$ref": "#/$defs/EnforcementMode"
        },
        "feature": {
          "$ref": "#/$defs/HarnessFeature"
        },
        "harm_selector": {
          "$ref": "#/$defs/EffectSelector"
        },
        "id": {
          "minLength": 1,
          "title": "Id",
          "type": "string"
        },
        "implicit_text_authorization": {
          "title": "Implicit Text Authorization",
          "type": "boolean"
        },
        "neutral_scenario": {
          "$ref": "#/$defs/ScenarioPath"
        },
        "persistent_memory": {
          "title": "Persistent Memory",
          "type": "boolean"
        },
        "provenance_mode": {
          "$ref": "#/$defs/ProvenanceMode"
        },
        "schema_version": {
          "minLength": 1,
          "title": "Schema Version",
          "type": "string"
        },
        "seed": {
          "title": "Seed",
          "type": "integer"
        },
        "shared_context": {
          "title": "Shared Context",
          "type": "boolean"
        },
        "skill_pair": {
          "$ref": "#/$defs/NeutralSkillPair"
        },
        "target_scenario": {
          "$ref": "#/$defs/ScenarioPath"
        }
      },
      "required": [
        "schema_version",
        "id",
        "target_scenario",
        "neutral_scenario",
        "seed",
        "feature",
        "harm_selector",
        "skill_pair",
        "shared_context",
        "persistent_memory",
        "auto_approve_tools",
        "enforcement_mode",
        "provenance_mode",
        "implicit_text_authorization"
      ],
      "title": "HiaaDesign",
      "type": "object"
    },
    "MatrixRunRole": {
      "description": "核心变体与不得进入普通分母的派生 Run。",
      "enum": [
        "core",
        "determinism_repeat",
        "counterfactual"
      ],
      "title": "MatrixRunRole",
      "type": "string"
    },
    "NeutralSkillPair": {
      "additionalProperties": false,
      "description": "除危险语义外保持 Manifest、Schema、工具与长度匹配的 Skill 对。",
      "properties": {
        "length_interval": {
          "$ref": "#/$defs/SkillLengthInterval"
        },
        "neutral": {
          "$ref": "#/$defs/SkillControlProfile"
        },
        "target": {
          "$ref": "#/$defs/SkillControlProfile"
        }
      },
      "required": [
        "target",
        "neutral",
        "length_interval"
      ],
      "title": "NeutralSkillPair",
      "type": "object"
    },
    "ProvenanceMode": {
      "description": "Harness 对 Observed 来源标签的受控处理模式。",
      "enum": [
        "preserve",
        "drop_on_derive",
        "drop_on_memory"
      ],
      "title": "ProvenanceMode",
      "type": "string"
    },
    "ResourceRef": {
      "description": "一个已经校验并规范化的 Resource URI。",
      "title": "ResourceRef",
      "type": "string"
    },
    "ScenarioPath": {
      "description": "Experiment Matrix 中受控的 Scenario 相对路径。",
      "title": "ScenarioPath",
      "type": "string"
    },
    "SessionCondition": {
      "description": "Effect 位于授权原 Session 或新 Session。",
      "enum": [
        "original",
        "new"
      ],
      "title": "SessionCondition",
      "type": "string"
    },
    "SkillControlProfile": {
      "additionalProperties": false,
      "description": "一个 Skill 在中和配对中必须公开的结构控制量。",
      "properties": {
        "content_length": {
          "minimum": 0,
          "title": "Content Length",
          "type": "integer"
        },
        "dangerous_semantics_present": {
          "title": "Dangerous Semantics Present",
          "type": "boolean"
        },
        "manifest_sha256": {
          "minLength": 1,
          "title": "Manifest Sha256",
          "type": "string"
        },
        "schema_sha256": {
          "minLength": 1,
          "title": "Schema Sha256",
          "type": "string"
        },
        "skill_id": {
          "minLength": 1,
          "title": "Skill Id",
          "type": "string"
        },
        "tool_registrations": {
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "title": "Tool Registrations",
          "type": "array"
        }
      },
      "required": [
        "skill_id",
        "manifest_sha256",
        "schema_sha256",
        "tool_registrations",
        "content_length",
        "dangerous_semantics_present"
      ],
      "title": "SkillControlProfile",
      "type": "object"
    },
    "SkillLengthInterval": {
      "additionalProperties": false,
      "description": "目标与中性 Skill 必须共同落入的预注册长度区间。",
      "properties": {
        "maximum": {
          "minimum": 0,
          "title": "Maximum",
          "type": "integer"
        },
        "minimum": {
          "minimum": 0,
          "title": "Minimum",
          "type": "integer"
        }
      },
      "required": [
        "minimum",
        "maximum"
      ],
      "title": "SkillLengthInterval",
      "type": "object"
    },
    "SkillStateCondition": {
      "description": "目标 Skill 在核心配置中的状态。",
      "enum": [
        "normal",
        "revoked"
      ],
      "title": "SkillStateCondition",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "description": "一组 ID 唯一的实验配置。",
  "properties": {
    "determinism_repeats": {
      "default": 1,
      "minimum": 1,
      "title": "Determinism Repeats",
      "type": "integer"
    },
    "hiaa_design": {
      "anyOf": [
        {
          "$ref": "#/$defs/HiaaDesign"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "hiaa_designs": {
      "default": [],
      "items": {
        "$ref": "#/$defs/HiaaDesign"
      },
      "title": "Hiaa Designs",
      "type": "array"
    },
    "id": {
      "minLength": 1,
      "title": "Id",
      "type": "string"
    },
    "schema_version": {
      "minLength": 1,
      "title": "Schema Version",
      "type": "string"
    },
    "variants": {
      "items": {
        "$ref": "#/$defs/ExperimentVariant"
      },
      "minItems": 1,
      "title": "Variants",
      "type": "array"
    }
  },
  "required": [
    "schema_version",
    "id",
    "variants"
  ],
  "title": "ExperimentMatrix",
  "type": "object"
}
