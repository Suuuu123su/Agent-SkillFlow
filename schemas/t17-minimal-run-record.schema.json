{
  "$defs": {
    "ArtifactCheck": {
      "additionalProperties": false,
      "description": "存在、内容 commitment 与 Session 同时满足才算通过。",
      "properties": {
        "actual_sha256": {
          "anyOf": [
            {
              "pattern": "^[0-9a-f]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Actual Sha256"
        },
        "artifact_id": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Artifact Id"
        },
        "event_id": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Event Id"
        },
        "present": {
          "title": "Present",
          "type": "boolean"
        },
        "requirement": {
          "$ref": "#/$defs/NormalArtifactRequirement"
        },
        "satisfied": {
          "title": "Satisfied",
          "type": "boolean"
        },
        "session_id": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Session Id"
        }
      },
      "required": [
        "requirement",
        "present",
        "artifact_id",
        "actual_sha256",
        "session_id",
        "event_id",
        "satisfied"
      ],
      "title": "ArtifactCheck",
      "type": "object"
    },
    "AuthorizationGrant": {
      "additionalProperties": false,
      "description": "由用户或可信策略签发的能力授权。",
      "properties": {
        "action": {
          "$ref": "#/$defs/CapabilityAction"
        },
        "call_id": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Call Id"
        },
        "expires_at": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Expires At"
        },
        "grant_id": {
          "minLength": 1,
          "title": "Grant Id",
          "type": "string"
        },
        "grantee_id": {
          "minLength": 1,
          "title": "Grantee Id",
          "type": "string"
        },
        "issuer_id": {
          "minLength": 1,
          "title": "Issuer Id",
          "type": "string"
        },
        "issuer_type": {
          "enum": [
            "user",
            "trusted_policy"
          ],
          "title": "Issuer Type",
          "type": "string"
        },
        "lifetime": {
          "$ref": "#/$defs/Lifetime"
        },
        "scope": {
          "$ref": "#/$defs/Scope"
        },
        "session_id": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Session Id"
        },
        "sink_pattern": {
          "$ref": "#/$defs/ResourceRef"
        },
        "source_pattern": {
          "anyOf": [
            {
              "$ref": "#/$defs/ResourceRef"
            },
            {
              "type": "null"
            }
          ]
        },
        "task_id": {
          "minLength": 1,
          "title": "Task Id",
          "type": "string"
        },
        "valid_from": {
          "format": "date-time",
          "title": "Valid From",
          "type": "string"
        }
      },
      "required": [
        "grant_id",
        "issuer_id",
        "issuer_type",
        "grantee_id",
        "action",
        "source_pattern",
        "sink_pattern",
        "scope",
        "lifetime",
        "task_id",
        "valid_from"
      ],
      "title": "AuthorizationGrant",
      "type": "object"
    },
    "AuthorizationObservation": {
      "additionalProperties": false,
      "description": "结构化 Grant 及其签发/撤销事实。",
      "properties": {
        "grant": {
          "$ref": "#/$defs/AuthorizationGrant"
        },
        "grant_event_id": {
          "minLength": 1,
          "title": "Grant Event Id",
          "type": "string"
        },
        "revoke_event_id": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Revoke Event Id"
        },
        "revoked": {
          "title": "Revoked",
          "type": "boolean"
        }
      },
      "required": [
        "grant",
        "grant_event_id",
        "revoked"
      ],
      "title": "AuthorizationObservation",
      "type": "object"
    },
    "CapabilityAction": {
      "description": "MVP 固定支持的能力动作。",
      "enum": [
        "file.read",
        "file.write",
        "memory.read",
        "memory.write",
        "network.send",
        "shell.execute",
        "user.confirm"
      ],
      "title": "CapabilityAction",
      "type": "string"
    },
    "CapabilityEffect": {
      "additionalProperties": false,
      "description": "可比较的结构化能力效果。",
      "properties": {
        "action": {
          "$ref": "#/$defs/CapabilityAction"
        },
        "lifetime": {
          "$ref": "#/$defs/Lifetime"
        },
        "scope": {
          "$ref": "#/$defs/Scope"
        },
        "sensitivity": {
          "maximum": 4,
          "minimum": 0,
          "title": "Sensitivity",
          "type": "integer"
        },
        "sink": {
          "$ref": "#/$defs/ResourceRef"
        },
        "source": {
          "anyOf": [
            {
              "$ref": "#/$defs/ResourceRef"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "source",
        "action",
        "sink",
        "scope",
        "lifetime",
        "sensitivity"
      ],
      "title": "CapabilityEffect",
      "type": "object"
    },
    "Decision": {
      "description": "Harness 或策略的结构化决策。",
      "enum": [
        "allow",
        "deny",
        "confirm"
      ],
      "title": "Decision",
      "type": "string"
    },
    "DecisionBasisObservation": {
      "additionalProperties": false,
      "description": "一次 Tool 决策真正读取的 Artifact 与授权事实。",
      "properties": {
        "authorized": {
          "title": "Authorized",
          "type": "boolean"
        },
        "baseline_result": {
          "$ref": "#/$defs/Decision"
        },
        "decision_basis_artifact_ids": {
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "title": "Decision Basis Artifact Ids",
          "type": "array"
        },
        "decision_id": {
          "minLength": 1,
          "title": "Decision Id",
          "type": "string"
        },
        "enforcement_mode": {
          "$ref": "#/$defs/EnforcementMode"
        },
        "executed": {
          "title": "Executed",
          "type": "boolean"
        },
        "matched_grant_ids": {
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "title": "Matched Grant Ids",
          "type": "array"
        },
        "policy_result": {
          "$ref": "#/$defs/Decision"
        },
        "reason_codes": {
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "title": "Reason Codes",
          "type": "array"
        },
        "request_event_id": {
          "minLength": 1,
          "title": "Request Event Id",
          "type": "string"
        }
      },
      "required": [
        "decision_id",
        "request_event_id",
        "enforcement_mode",
        "baseline_result",
        "policy_result",
        "authorized",
        "executed",
        "decision_basis_artifact_ids",
        "matched_grant_ids",
        "reason_codes"
      ],
      "title": "DecisionBasisObservation",
      "type": "object"
    },
    "EffectCheck": {
      "additionalProperties": false,
      "description": "匹配精确任务 selector 与 Session 的同 Run Receipt 集合。",
      "properties": {
        "effect_ids": {
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "title": "Effect Ids",
          "type": "array"
        },
        "receipt_ids": {
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "title": "Receipt Ids",
          "type": "array"
        },
        "requirement": {
          "$ref": "#/$defs/NormalEffectRequirement"
        },
        "satisfied": {
          "title": "Satisfied",
          "type": "boolean"
        },
        "session_ids": {
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "title": "Session Ids",
          "type": "array"
        }
      },
      "required": [
        "requirement",
        "effect_ids",
        "receipt_ids",
        "session_ids",
        "satisfied"
      ],
      "title": "EffectCheck",
      "type": "object"
    },
    "EffectObservation": {
      "additionalProperties": false,
      "description": "结构化 Tool 请求、决策、执行和同 Run Receipt。",
      "properties": {
        "accepted": {
          "const": true,
          "default": true,
          "title": "Accepted",
          "type": "boolean"
        },
        "decision_id": {
          "minLength": 1,
          "title": "Decision Id",
          "type": "string"
        },
        "effect_id": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Effect Id"
        },
        "executed": {
          "title": "Executed",
          "type": "boolean"
        },
        "receipt_id": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Receipt Id"
        },
        "request_event_id": {
          "minLength": 1,
          "title": "Request Event Id",
          "type": "string"
        },
        "requested_effect": {
          "$ref": "#/$defs/CapabilityEffect"
        }
      },
      "required": [
        "request_event_id",
        "decision_id",
        "requested_effect",
        "executed"
      ],
      "title": "EffectObservation",
      "type": "object"
    },
    "EffectSelector": {
      "additionalProperties": false,
      "description": "把运行期多个 EffectRecord 映射到稳定别名。",
      "properties": {
        "action": {
          "$ref": "#/$defs/CapabilityAction"
        },
        "alias": {
          "minLength": 1,
          "title": "Alias",
          "type": "string"
        },
        "sink_pattern": {
          "$ref": "#/$defs/ResourceRef"
        },
        "source_pattern": {
          "anyOf": [
            {
              "$ref": "#/$defs/ResourceRef"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "alias",
        "action",
        "source_pattern",
        "sink_pattern"
      ],
      "title": "EffectSelector",
      "type": "object"
    },
    "EnforcementMode": {
      "description": "策略只观察或实际阻断。",
      "enum": [
        "monitor",
        "enforce"
      ],
      "title": "EnforcementMode",
      "type": "string"
    },
    "FakeDecisionRecord": {
      "additionalProperties": false,
      "description": "无正文的 Fake 决策日志；不冒充真实 API 响应或 Token。",
      "properties": {
        "allowed_action_ids": {
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "title": "Allowed Action Ids",
          "type": "array"
        },
        "behavior": {
          "enum": [
            "normal",
            "refusal",
            "no_call",
            "schema_rejection",
            "infrastructure_invalid"
          ],
          "title": "Behavior",
          "type": "string"
        },
        "schema_valid": {
          "title": "Schema Valid",
          "type": "boolean"
        },
        "selected_action_ids": {
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "title": "Selected Action Ids",
          "type": "array"
        },
        "sequence": {
          "minimum": 1,
          "title": "Sequence",
          "type": "integer"
        }
      },
      "required": [
        "sequence",
        "allowed_action_ids",
        "selected_action_ids",
        "behavior",
        "schema_valid"
      ],
      "title": "FakeDecisionRecord",
      "type": "object"
    },
    "HookCapability": {
      "additionalProperties": false,
      "description": "一个场景对单项受信 Hook 的需求与实际可用性。",
      "properties": {
        "available": {
          "title": "Available",
          "type": "boolean"
        },
        "evidence_ids": {
          "default": [],
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "title": "Evidence Ids",
          "type": "array"
        },
        "hook": {
          "$ref": "#/$defs/HookName"
        },
        "reason": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Reason"
        },
        "required": {
          "title": "Required",
          "type": "boolean"
        },
        "status": {
          "$ref": "#/$defs/MeasurementStatus"
        }
      },
      "required": [
        "hook",
        "required",
        "available",
        "status"
      ],
      "title": "HookCapability",
      "type": "object"
    },
    "HookName": {
      "description": "T17 Reference Harness 必须显式声明的证据 Hook。",
      "enum": [
        "authorization",
        "decision_basis",
        "provenance",
        "influence",
        "revocation",
        "task_success"
      ],
      "title": "HookName",
      "type": "string"
    },
    "InfluenceObservation": {
      "additionalProperties": false,
      "description": "一对 original/neutral 分支的 CI 与确认影响边。",
      "properties": {
        "ci": {
          "enum": [
            -1,
            0,
            1
          ],
          "title": "Ci",
          "type": "integer"
        },
        "evidence_ids": {
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "minItems": 1,
          "title": "Evidence Ids",
          "type": "array"
        },
        "replay_id": {
          "minLength": 1,
          "title": "Replay Id",
          "type": "string"
        },
        "source_artifact_id": {
          "minLength": 1,
          "title": "Source Artifact Id",
          "type": "string"
        },
        "target_effect_ids": {
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "title": "Target Effect Ids",
          "type": "array"
        }
      },
      "required": [
        "replay_id",
        "ci",
        "source_artifact_id",
        "target_effect_ids",
        "evidence_ids"
      ],
      "title": "InfluenceObservation",
      "type": "object"
    },
    "Lifetime": {
      "description": "授权或效果的有效边界。",
      "enum": [
        "call",
        "task",
        "session",
        "persistent"
      ],
      "title": "Lifetime",
      "type": "string"
    },
    "MeasurementStatus": {
      "description": "T17 把已测、设计不适用、Hook 缺失和阶段不完整分开。",
      "enum": [
        "measured",
        "not_applicable",
        "not_available",
        "incomplete"
      ],
      "title": "MeasurementStatus",
      "type": "string"
    },
    "NormalArtifactRequirement": {
      "additionalProperties": false,
      "description": "普通任务输出的精确内容与 Session 合同。",
      "properties": {
        "alias": {
          "minLength": 1,
          "title": "Alias",
          "type": "string"
        },
        "expected_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Expected Sha256",
          "type": "string"
        },
        "session_id": {
          "minLength": 1,
          "title": "Session Id",
          "type": "string"
        }
      },
      "required": [
        "alias",
        "expected_sha256",
        "session_id"
      ],
      "title": "NormalArtifactRequirement",
      "type": "object"
    },
    "NormalEffectRequirement": {
      "additionalProperties": false,
      "description": "任务真正需要的资源/动作/Session，不读取风险 Golden。",
      "properties": {
        "rationale": {
          "minLength": 1,
          "title": "Rationale",
          "type": "string"
        },
        "selector": {
          "$ref": "#/$defs/EffectSelector"
        },
        "session_id": {
          "minLength": 1,
          "title": "Session Id",
          "type": "string"
        }
      },
      "required": [
        "selector",
        "session_id",
        "rationale"
      ],
      "title": "NormalEffectRequirement",
      "type": "object"
    },
    "NormalTaskEvidence": {
      "additionalProperties": false,
      "description": "只评价新 Run；历史 Task Success 仅旁列，绝不回填。",
      "properties": {
        "artifacts": {
          "items": {
            "$ref": "#/$defs/ArtifactCheck"
          },
          "minItems": 1,
          "title": "Artifacts",
          "type": "array"
        },
        "completed_session_ids": {
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "minItems": 1,
          "title": "Completed Session Ids",
          "type": "array"
        },
        "effects": {
          "items": {
            "$ref": "#/$defs/EffectCheck"
          },
          "title": "Effects",
          "type": "array"
        },
        "evaluator_id": {
          "const": "skillflow-normal-task",
          "default": "skillflow-normal-task",
          "title": "Evaluator Id",
          "type": "string"
        },
        "evaluator_version": {
          "const": "2.0.0",
          "default": "2.0.0",
          "title": "Evaluator Version",
          "type": "string"
        },
        "evidence_ids": {
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "minItems": 1,
          "title": "Evidence Ids",
          "type": "array"
        },
        "legacy_task_success": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "title": "Legacy Task Success"
        },
        "risk_effect_ids": {
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "title": "Risk Effect Ids",
          "type": "array"
        },
        "risk_receipt_ids": {
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "title": "Risk Receipt Ids",
          "type": "array"
        },
        "run_id": {
          "minLength": 1,
          "title": "Run Id",
          "type": "string"
        },
        "safe_task_success": {
          "title": "Safe Task Success",
          "type": "boolean"
        },
        "scenario_id": {
          "minLength": 1,
          "title": "Scenario Id",
          "type": "string"
        },
        "schema_version": {
          "const": "1.0",
          "default": "1.0",
          "title": "Schema Version",
          "type": "string"
        },
        "status": {
          "const": "measured",
          "default": "measured",
          "title": "Status",
          "type": "string"
        },
        "task_contract_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Task Contract Sha256",
          "type": "string"
        },
        "task_success": {
          "title": "Task Success",
          "type": "boolean"
        }
      },
      "required": [
        "run_id",
        "scenario_id",
        "task_contract_sha256",
        "artifacts",
        "effects",
        "completed_session_ids",
        "risk_effect_ids",
        "risk_receipt_ids",
        "task_success",
        "safe_task_success",
        "legacy_task_success",
        "evidence_ids"
      ],
      "title": "NormalTaskEvidence",
      "type": "object"
    },
    "ProvenanceObservation": {
      "additionalProperties": false,
      "description": "一个 Runtime Artifact 的父边、来源与撤销来源。",
      "properties": {
        "artifact_id": {
          "minLength": 1,
          "title": "Artifact Id",
          "type": "string"
        },
        "created_by_event_id": {
          "minLength": 1,
          "title": "Created By Event Id",
          "type": "string"
        },
        "created_session_id": {
          "minLength": 1,
          "title": "Created Session Id",
          "type": "string"
        },
        "origins": {
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "title": "Origins",
          "type": "array",
          "uniqueItems": true
        },
        "parent_artifact_ids": {
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "title": "Parent Artifact Ids",
          "type": "array",
          "uniqueItems": true
        },
        "revoked_origins": {
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "title": "Revoked Origins",
          "type": "array",
          "uniqueItems": true
        },
        "trust": {
          "$ref": "#/$defs/TrustLevel"
        }
      },
      "required": [
        "artifact_id",
        "created_by_event_id",
        "created_session_id",
        "parent_artifact_ids",
        "origins",
        "revoked_origins",
        "trust"
      ],
      "title": "ProvenanceObservation",
      "type": "object"
    },
    "ReferenceObservationSnapshot": {
      "additionalProperties": false,
      "description": "一条 Reference Harness Run 的六类 Hook 投影。",
      "properties": {
        "authorizations": {
          "items": {
            "$ref": "#/$defs/AuthorizationObservation"
          },
          "title": "Authorizations",
          "type": "array"
        },
        "decisions": {
          "items": {
            "$ref": "#/$defs/DecisionBasisObservation"
          },
          "title": "Decisions",
          "type": "array"
        },
        "effects": {
          "items": {
            "$ref": "#/$defs/EffectObservation"
          },
          "title": "Effects",
          "type": "array"
        },
        "hooks": {
          "items": {
            "$ref": "#/$defs/HookCapability"
          },
          "maxItems": 6,
          "minItems": 6,
          "title": "Hooks",
          "type": "array"
        },
        "influences": {
          "items": {
