{
  "$defs": {
    "ArtifactCheck": {
      "additionalProperties": false,
      "description": "存在、内容 commitment 与 Session 同时满足才算通过。",
      "properties": {
        "actual_sha256": {
          "anyOf": [
            {
              "pattern": "^[0-9a-f]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Actual Sha256"
        },
        "artifact_id": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Artifact Id"
        },
        "event_id": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Event Id"
        },
        "present": {
          "title": "Present",
          "type": "boolean"
        },
        "requirement": {
          "$ref": "#/$defs/NormalArtifactRequirement"
        },
        "satisfied": {
          "title": "Satisfied",
          "type": "boolean"
        },
        "session_id": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Session Id"
        }
      },
      "required": [
        "requirement",
        "present",
        "artifact_id",
        "actual_sha256",
        "session_id",
        "event_id",
        "satisfied"
      ],
      "title": "ArtifactCheck",
      "type": "object"
    },
    "CapabilityAction": {
      "description": "MVP 固定支持的能力动作。",
      "enum": [
        "file.read",
        "file.write",
        "memory.read",
        "memory.write",
        "network.send",
        "shell.execute",
        "user.confirm"
      ],
      "title": "CapabilityAction",
      "type": "string"
    },
    "EffectCheck": {
      "additionalProperties": false,
      "description": "匹配精确任务 selector 与 Session 的同 Run Receipt 集合。",
      "properties": {
        "effect_ids": {
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "title": "Effect Ids",
          "type": "array"
        },
        "receipt_ids": {
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "title": "Receipt Ids",
          "type": "array"
        },
        "requirement": {
          "$ref": "#/$defs/NormalEffectRequirement"
        },
        "satisfied": {
          "title": "Satisfied",
          "type": "boolean"
        },
        "session_ids": {
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "title": "Session Ids",
          "type": "array"
        }
      },
      "required": [
        "requirement",
        "effect_ids",
        "receipt_ids",
        "session_ids",
        "satisfied"
      ],
      "title": "EffectCheck",
      "type": "object"
    },
    "EffectSelector": {
      "additionalProperties": false,
      "description": "把运行期多个 EffectRecord 映射到稳定别名。",
      "properties": {
        "action": {
          "$ref": "#/$defs/CapabilityAction"
        },
        "alias": {
          "minLength": 1,
          "title": "Alias",
          "type": "string"
        },
        "sink_pattern": {
          "$ref": "#/$defs/ResourceRef"
        },
        "source_pattern": {
          "anyOf": [
            {
              "$ref": "#/$defs/ResourceRef"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "alias",
        "action",
        "source_pattern",
        "sink_pattern"
      ],
      "title": "EffectSelector",
      "type": "object"
    },
    "NormalArtifactRequirement": {
      "additionalProperties": false,
      "description": "普通任务输出的精确内容与 Session 合同。",
      "properties": {
        "alias": {
          "minLength": 1,
          "title": "Alias",
          "type": "string"
        },
        "expected_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Expected Sha256",
          "type": "string"
        },
        "session_id": {
          "minLength": 1,
          "title": "Session Id",
          "type": "string"
        }
      },
      "required": [
        "alias",
        "expected_sha256",
        "session_id"
      ],
      "title": "NormalArtifactRequirement",
      "type": "object"
    },
    "NormalEffectRequirement": {
      "additionalProperties": false,
      "description": "任务真正需要的资源/动作/Session，不读取风险 Golden。",
      "properties": {
        "rationale": {
          "minLength": 1,
          "title": "Rationale",
          "type": "string"
        },
        "selector": {
          "$ref": "#/$defs/EffectSelector"
        },
        "session_id": {
          "minLength": 1,
          "title": "Session Id",
          "type": "string"
        }
      },
      "required": [
        "selector",
        "session_id",
        "rationale"
      ],
      "title": "NormalEffectRequirement",
      "type": "object"
    },
    "ResourceRef": {
      "description": "一个已经校验并规范化的 Resource URI。",
      "title": "ResourceRef",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "description": "只评价新 Run；历史 Task Success 仅旁列，绝不回填。",
  "properties": {
    "artifacts": {
      "items": {
        "$ref": "#/$defs/ArtifactCheck"
      },
      "minItems": 1,
      "title": "Artifacts",
      "type": "array"
    },
    "completed_session_ids": {
      "items": {
        "minLength": 1,
        "type": "string"
      },
      "minItems": 1,
      "title": "Completed Session Ids",
      "type": "array"
    },
    "effects": {
      "items": {
        "$ref": "#/$defs/EffectCheck"
      },
      "title": "Effects",
      "type": "array"
    },
    "evaluator_id": {
      "const": "skillflow-normal-task",
      "default": "skillflow-normal-task",
      "title": "Evaluator Id",
      "type": "string"
    },
    "evaluator_version": {
      "const": "2.0.0",
      "default": "2.0.0",
      "title": "Evaluator Version",
      "type": "string"
    },
    "evidence_ids": {
      "items": {
        "minLength": 1,
        "type": "string"
      },
      "minItems": 1,
      "title": "Evidence Ids",
      "type": "array"
    },
    "legacy_task_success": {
      "anyOf": [
        {
          "type": "boolean"
        },
        {
          "type": "null"
        }
      ],
      "title": "Legacy Task Success"
    },
    "risk_effect_ids": {
      "items": {
        "minLength": 1,
        "type": "string"
      },
      "title": "Risk Effect Ids",
      "type": "array"
    },
    "risk_receipt_ids": {
      "items": {
        "minLength": 1,
        "type": "string"
      },
      "title": "Risk Receipt Ids",
      "type": "array"
    },
    "run_id": {
      "minLength": 1,
      "title": "Run Id",
      "type": "string"
    },
    "safe_task_success": {
      "title": "Safe Task Success",
      "type": "boolean"
    },
    "scenario_id": {
      "minLength": 1,
      "title": "Scenario Id",
      "type": "string"
    },
    "schema_version": {
      "const": "1.0",
      "default": "1.0",
      "title": "Schema Version",
      "type": "string"
    },
    "status": {
      "const": "measured",
      "default": "measured",
      "title": "Status",
      "type": "string"
    },
    "task_contract_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Task Contract Sha256",
      "type": "string"
    },
    "task_success": {
      "title": "Task Success",
      "type": "boolean"
    }
  },
  "required": [
    "run_id",
    "scenario_id",
    "task_contract_sha256",
    "artifacts",
    "effects",
    "completed_session_ids",
    "risk_effect_ids",
    "risk_receipt_ids",
    "task_success",
    "safe_task_success",
    "legacy_task_success",
    "evidence_ids"
  ],
  "title": "NormalTaskEvidence",
  "type": "object"
}
