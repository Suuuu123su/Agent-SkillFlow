{
  "$defs": {
    "ArtifactAliasEvidence": {
      "additionalProperties": false,
      "description": "反事实目标 alias 与当前 Run Artifact 的脱敏绑定。",
      "properties": {
        "alias": {
          "minLength": 1,
          "title": "Alias",
          "type": "string"
        },
        "artifact_id": {
          "minLength": 1,
          "title": "Artifact Id",
          "type": "string"
        },
        "trust": {
          "$ref": "#/$defs/TrustLevel"
        }
      },
      "required": [
        "alias",
        "artifact_id",
        "trust"
      ],
      "title": "ArtifactAliasEvidence",
      "type": "object"
    },
    "AuthorizationAttemptClass": {
      "description": "不可信授权声明暴露的互斥分类。",
      "enum": [
        "authorization_laundering",
        "plain_authorization_bypass",
        "other_exposure",
        "not_exposed"
      ],
      "title": "AuthorizationAttemptClass",
      "type": "string"
    },
    "AuthorizationAttemptResult": {
      "additionalProperties": false,
      "description": "一次不可信授权声明暴露的分类证据。",
      "properties": {
        "authorization_request_id": {
          "minLength": 1,
          "title": "Authorization Request Id",
          "type": "string"
        },
        "classification": {
          "$ref": "#/$defs/AuthorizationAttemptClass"
        },
        "evidence_ids": {
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "title": "Evidence Ids",
          "type": "array"
        }
      },
      "required": [
        "authorization_request_id",
        "classification",
        "evidence_ids"
      ],
      "title": "AuthorizationAttemptResult",
      "type": "object"
    },
    "AuthorizationCondition": {
      "description": "实验中被暴露的授权来源条件。",
      "enum": [
        "none",
        "implicit_text",
        "structured_confirmation"
      ],
      "title": "AuthorizationCondition",
      "type": "string"
    },
    "BoundaryDepth": {
      "additionalProperties": false,
      "description": "五类边界及总深度计数。",
      "properties": {
        "context": {
          "minimum": 0,
          "title": "Context",
          "type": "integer"
        },
        "memory": {
          "minimum": 0,
          "title": "Memory",
          "type": "integer"
        },
        "session": {
          "minimum": 0,
          "title": "Session",
          "type": "integer"
        },
        "skill": {
          "minimum": 0,
          "title": "Skill",
          "type": "integer"
        },
        "tool": {
          "minimum": 0,
          "title": "Tool",
          "type": "integer"
        },
        "total": {
          "minimum": 0,
          "title": "Total",
          "type": "integer"
        }
      },
      "required": [
        "context",
        "memory",
        "session",
        "skill",
        "tool",
        "total"
      ],
      "title": "BoundaryDepth",
      "type": "object"
    },
    "CanonicalEffectKey": {
      "additionalProperties": false,
      "description": "UEA 类型去重使用的规范化五元组。",
      "properties": {
        "action": {
          "$ref": "#/$defs/CapabilityAction"
        },
        "lifetime": {
          "$ref": "#/$defs/Lifetime"
        },
        "scope": {
          "$ref": "#/$defs/Scope"
        },
        "sink": {
          "$ref": "#/$defs/ResourceRef"
        },
        "source": {
          "anyOf": [
            {
              "$ref": "#/$defs/ResourceRef"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "source",
        "action",
        "sink",
        "scope",
        "lifetime"
      ],
      "title": "CanonicalEffectKey",
      "type": "object"
    },
    "CapabilityAction": {
      "description": "MVP 固定支持的能力动作。",
      "enum": [
        "file.read",
        "file.write",
        "memory.read",
        "memory.write",
        "network.send",
        "shell.execute",
        "user.confirm"
      ],
      "title": "CapabilityAction",
      "type": "string"
    },
    "CapabilityEffect": {
      "additionalProperties": false,
      "description": "可比较的结构化能力效果。",
      "properties": {
        "action": {
          "$ref": "#/$defs/CapabilityAction"
        },
        "lifetime": {
          "$ref": "#/$defs/Lifetime"
        },
        "scope": {
          "$ref": "#/$defs/Scope"
        },
        "sensitivity": {
          "maximum": 4,
          "minimum": 0,
          "title": "Sensitivity",
          "type": "integer"
        },
        "sink": {
          "$ref": "#/$defs/ResourceRef"
        },
        "source": {
          "anyOf": [
            {
              "$ref": "#/$defs/ResourceRef"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "source",
        "action",
        "sink",
        "scope",
        "lifetime",
        "sensitivity"
      ],
      "title": "CapabilityEffect",
      "type": "object"
    },
    "ConfirmedInfluenceEdge": {
      "additionalProperties": false,
      "description": "仅由成对反事实证据确认的 Artifact→Effect 影响边。",
      "properties": {
        "relation": {
          "const": "INFLUENCE_CONFIRMED",
          "default": "INFLUENCE_CONFIRMED",
          "title": "Relation",
          "type": "string"
        },
        "source_artifact_id": {
          "minLength": 1,
          "title": "Source Artifact Id",
          "type": "string"
        },
        "target_effect_id": {
          "minLength": 1,
          "title": "Target Effect Id",
          "type": "string"
        }
      },
      "required": [
        "source_artifact_id",
        "target_effect_id"
      ],
      "title": "ConfirmedInfluenceEdge",
      "type": "object"
    },
    "Decision": {
      "description": "Harness 或策略的结构化决策。",
      "enum": [
        "allow",
        "deny",
        "confirm"
      ],
      "title": "Decision",
      "type": "string"
    },
    "DecisionBasisArtifact": {
      "additionalProperties": false,
      "description": "一个进入 Decision 依据的脱敏 Artifact。",
      "properties": {
        "aliases": {
          "default": [],
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "title": "Aliases",
          "type": "array"
        },
        "artifact_id": {
          "minLength": 1,
          "title": "Artifact Id",
          "type": "string"
        },
        "trust": {
          "$ref": "#/$defs/TrustLevel"
        }
      },
      "required": [
        "artifact_id",
        "trust"
      ],
      "title": "DecisionBasisArtifact",
      "type": "object"
    },
    "DerivedMetric": {
      "additionalProperties": false,
      "description": "无单一整数分母的派生指标或结构化 N/A。",
      "properties": {
        "evidence_ids": {
          "default": [],
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "title": "Evidence Ids",
          "type": "array"
        },
        "status": {
          "$ref": "#/$defs/MetricStatus"
        },
        "value": {
          "anyOf": [
            {
              "maximum": 2.0,
              "minimum": -2.0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "title": "Value"
        }
      },
      "required": [
        "value",
        "status"
      ],
      "title": "DerivedMetric",
      "type": "object"
    },
    "EffectPathEvidence": {
      "additionalProperties": false,
      "description": "一个来源节点到 Effect 节点的脱敏可审计路径。",
      "properties": {
        "boundary_depth": {
          "$ref": "#/$defs/BoundaryDepth"
        },
        "evidence_event_ids": {
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "title": "Evidence Event Ids",
          "type": "array"
        },
        "node_ids": {
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "title": "Node Ids",
          "type": "array"
        }
      },
      "required": [
        "node_ids",
        "evidence_event_ids",
        "boundary_depth"
      ],
      "title": "EffectPathEvidence",
      "type": "object"
    },
    "EffectSelector": {
      "additionalProperties": false,
      "description": "把运行期多个 EffectRecord 映射到稳定别名。",
      "properties": {
        "action": {
          "$ref": "#/$defs/CapabilityAction"
        },
        "alias": {
          "minLength": 1,
          "title": "Alias",
          "type": "string"
        },
        "sink_pattern": {
          "$ref": "#/$defs/ResourceRef"
        },
        "source_pattern": {
          "anyOf": [
            {
              "$ref": "#/$defs/ResourceRef"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "alias",
        "action",
        "source_pattern",
        "sink_pattern"
      ],
      "title": "EffectSelector",
      "type": "object"
    },
    "EnforcementMode": {
      "description": "策略只观察或实际阻断。",
      "enum": [
        "monitor",
        "enforce"
      ],
      "title": "EnforcementMode",
      "type": "string"
    },
    "ExperimentRiskReport": {
      "additionalProperties": false,
      "description": "Experiment 层的原始四格、洗白和撤销残余聚合报告。",
      "properties": {
        "ALR": {
          "$ref": "#/$defs/RatioMetric"
        },
        "HIAA_pot": {
          "$ref": "#/$defs/HiaaPotentialMetric"
        },
        "HIAA_run": {
          "$ref": "#/$defs/DerivedMetric"
        },
        "RIR_1": {
          "$ref": "#/$defs/RatioMetric"
        },
        "RIR_3": {
          "$ref": "#/$defs/RatioMetric"
        },
        "authorization_attempts": {
          "items": {
            "$ref": "#/$defs/AuthorizationAttemptResult"
          },
          "title": "Authorization Attempts",
          "type": "array"
        },
        "authorization_laundering_request_ids": {
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "title": "Authorization Laundering Request Ids",
          "type": "array"
        },
        "experiment_id": {
          "minLength": 1,
          "title": "Experiment Id",
          "type": "string"
        },
        "harm_selector": {
          "$ref": "#/$defs/EffectSelector"
        },
        "hiaa_designs": {
          "default": [],
          "items": {
            "$ref": "#/$defs/HiaaDesignResult"
          },
          "title": "Hiaa Designs",
          "type": "array"
        },
        "p00": {
          "$ref": "#/$defs/MatrixCellMetric"
        },
        "p01": {
          "$ref": "#/$defs/MatrixCellMetric"
        },
        "p10": {
          "$ref": "#/$defs/MatrixCellMetric"
        },
        "p11": {
          "$ref": "#/$defs/MatrixCellMetric"
        },
        "plain_authorization_bypass_request_ids": {
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "title": "Plain Authorization Bypass Request Ids",
          "type": "array"
        },
        "raw_counts": {
          "$ref": "#/$defs/RawCounts"
        },
        "replay_ids": {
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "title": "Replay Ids",
          "type": "array"
        },
        "report_scope": {
          "const": "experiment",
          "title": "Report Scope",
          "type": "string"
        },
        "revocation": {
          "anyOf": [
            {
              "$ref": "#/$defs/SkillRevocationRecord"
            },
            {
              "type": "null"
            }
          ]
        },
        "run_ids": {
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "title": "Run Ids",
          "type": "array"
        },
        "schema_version": {
          "minLength": 1,
          "title": "Schema Version",
          "type": "string"
        }
      },
      "required": [
        "schema_version",
        "report_scope",
        "experiment_id",
        "run_ids",
        "replay_ids",
        "raw_counts",
        "harm_selector",
        "p00",
        "p01",
        "p10",
        "p11",
        "HIAA_pot",
        "HIAA_run",
        "ALR",
        "authorization_attempts",
        "authorization_laundering_request_ids",
        "plain_authorization_bypass_request_ids",
        "revocation",
        "RIR_1",
        "RIR_3"
      ],
      "title": "ExperimentRiskReport",
      "type": "object"
    },
    "HiaaCell": {
      "description": "目标 Skill 与 Harness 特性的四格组合。",
      "enum": [
        "p00",
        "p01",
        "p10",
        "p11"
      ],
      "title": "HiaaCell",
      "type": "string"
    },
    "HiaaDesignResult": {
      "additionalProperties": false,
      "description": "一套绑定同一 harm_selector 的完整 HIAA 四格结果。",
      "properties": {
        "HIAA_pot": {
          "$ref": "#/$defs/HiaaPotentialMetric"
        },
        "HIAA_run": {
          "$ref": "#/$defs/DerivedMetric"
        },
        "design_id": {
          "minLength": 1,
          "title": "Design Id",
          "type": "string"
        },
        "harm_selector": {
          "$ref": "#/$defs/EffectSelector"
        },
        "p00": {
          "$ref": "#/$defs/MatrixCellMetric"
        },
        "p01": {
          "$ref": "#/$defs/MatrixCellMetric"
        },
        "p10": {
          "$ref": "#/$defs/MatrixCellMetric"
        },
        "p11": {
          "$ref": "#/$defs/MatrixCellMetric"
        }
      },
      "required": [
        "design_id",
        "harm_selector",
        "p00",
        "p01",
        "p10",
        "p11",
        "HIAA_pot",
        "HIAA_run"
      ],
      "title": "HiaaDesignResult",
      "type": "object"
    },
    "HiaaPotentialMetric": {
      "additionalProperties": false,
      "description": "Harness 开启后新增可达未授权 Effect 集合的权重。",
      "properties": {
        "added_effect_keys": {
          "items": {
            "$ref": "#/$defs/CanonicalEffectKey"
          },
          "title": "Added Effect Keys",
          "type": "array"
        },
        "evidence_ids": {
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "title": "Evidence Ids",
          "type": "array"
        },
        "value": {
          "minimum": 0.0,
          "title": "Value",
          "type": "number"
        }
      },
      "required": [
        "value",
        "added_effect_keys",
        "evidence_ids"
      ],
      "title": "HiaaPotentialMetric",
      "type": "object"
    },
    "Lifetime": {
      "description": "授权或效果的有效边界。",
      "enum": [
        "call",
        "task",
        "session",
        "persistent"
      ],
      "title": "Lifetime",
      "type": "string"
    },
    "MatrixCellMetric": {
      "additionalProperties": false,
      "description": "一个 HIAA 单元格的原始 outcome、计数和发生率。",
      "properties": {
        "cell": {
          "$ref": "#/$defs/HiaaCell"
        },
        "effect_ids": {
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "title": "Effect Ids",
          "type": "array"
        },
        "executed_count": {
          "minimum": 0,
          "title": "Executed Count",
          "type": "integer"
        },
        "outcomes": {
          "items": {
            "type": "boolean"
          },
          "title": "Outcomes",
          "type": "array"
        },
        "rate": {
          "$ref": "#/$defs/RatioMetric"
        },
        "receipt_ids": {
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "title": "Receipt Ids",
          "type": "array"
        },
        "run_count": {
          "minimum": 0,
          "title": "Run Count",
          "type": "integer"
        },
        "run_ids": {
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "title": "Run Ids",
          "type": "array"
        }
      },
      "required": [
        "cell",
        "run_ids",
        "outcomes",
        "effect_ids",
        "receipt_ids",
        "executed_count",
        "run_count",
        "rate"
      ],
      "title": "MatrixCellMetric",
      "type": "object"
    },
    "MatrixRunRole": {
      "description": "核心变体与不得进入普通分母的派生 Run。",
      "enum": [
        "core",
        "determinism_repeat",
        "counterfactual"
      ],
      "title": "MatrixRunRole",
      "type": "string"
    },
    "MetricStatus": {
      "description": "比例指标是否有可解释分母。",
      "enum": [
        "defined",
        "not_applicable"
      ],
      "title": "MetricStatus",
      "type": "string"
    },
    "PolicyReasonCode": {
      "description": "T08 冻结的授权、边界与来源失败原因。",
      "enum": [
        "MANIFEST_PERMISSION_MISSING",
        "USER_GRANT_MISSING",
        "RESOURCE_SCOPE_EXCEEDED",
        "SINK_SCOPE_EXCEEDED",
        "GRANT_EXPIRED",
        "GRANT_REVOKED",
        "ORIGIN_REVOKED",
        "CROSS_CALL_USE",
        "CROSS_TASK_USE",
        "CROSS_SESSION_USE",
        "UNTRUSTED_ORIGIN",
        "PROVENANCE_INCOMPLETE",
        "GRANT_NOT_YET_VALID"
      ],
      "title": "PolicyReasonCode",
      "type": "string"
    },
    "ProvenanceCounts": {
      "additionalProperties": false,
      "description": "来源集合比较的 TP、FP、FN 原始计数。",
      "properties": {
        "artifact_ids": {
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "title": "Artifact Ids",
          "type": "array"
        },
        "fn": {
          "minimum": 0,
          "title": "Fn",
          "type": "integer"
        },
        "fp": {
          "minimum": 0,
          "title": "Fp",
          "type": "integer"
        },
        "tp": {
          "minimum": 0,
          "title": "Tp",
          "type": "integer"
        }
      },
      "required": [
        "tp",
        "fp",
        "fn",
        "artifact_ids"
      ],
      "title": "ProvenanceCounts",
      "type": "object"
    },
    "ProvenanceDepthMetrics": {
      "additionalProperties": false,
      "description": "一个边界总深度上的来源指标和相邻深度衰减。",
      "properties": {
        "boundary_depth": {
          "minimum": 0,
          "title": "Boundary Depth",
          "type": "integer"
        },
        "decay": {
          "$ref": "#/$defs/SignedRatioMetric"
        },
        "metrics": {
          "$ref": "#/$defs/ProvenanceMetricSet"
        }
      },
      "required": [
        "boundary_depth",
        "metrics",
        "decay"
      ],
      "title": "ProvenanceDepthMetrics",
      "type": "object"
    },
    "ProvenanceMetricSet": {
      "additionalProperties": false,
      "description": "同一聚合范围内的来源混淆计数与三类比例。",
      "properties": {
        "counts": {
          "$ref": "#/$defs/ProvenanceCounts"
        },
        "f1": {
          "$ref": "#/$defs/RatioMetric"
        },
        "precision": {
          "$ref": "#/$defs/RatioMetric"
        },
        "recall": {
          "$ref": "#/$defs/RatioMetric"
        }
      },
      "required": [
        "counts",
        "precision",
        "recall",
        "f1"
      ],
      "title": "ProvenanceMetricSet",
      "type": "object"
    },
    "ProvenanceMetricSummary": {
      "additionalProperties": false,
      "description": "单场景或 micro 范围的总体与逐深度来源指标。",
      "properties": {
        "by_boundary_depth": {
          "items": {
            "$ref": "#/$defs/ProvenanceDepthMetrics"
          },
          "title": "By Boundary Depth",
          "type": "array"
        },
        "overall": {
          "$ref": "#/$defs/ProvenanceMetricSet"
        }
      },
      "required": [
        "overall",
        "by_boundary_depth"
      ],
      "title": "ProvenanceMetricSummary",
      "type": "object"
    },
    "ProvenanceMode": {
      "description": "Harness 对 Observed 来源标签的受控处理模式。",
      "enum": [
        "preserve",
        "drop_on_derive",
        "drop_on_memory"
      ],
      "title": "ProvenanceMode",
      "type": "string"
    },
    "RatioMetric": {
      "additionalProperties": false,
      "description": "值域为零到一的比例及其原始计数和证据。",
      "properties": {
        "denominator": {
          "minimum": 0,
          "title": "Denominator",
          "type": "integer"
        },
        "evidence_ids": {
          "default": [],
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "title": "Evidence Ids",
          "type": "array"
        },
        "numerator": {
          "minimum": 0,
          "title": "Numerator",
          "type": "integer"
        },
        "status": {
          "$ref": "#/$defs/MetricStatus"
        },
        "value": {
          "anyOf": [
            {
              "maximum": 1.0,
              "minimum": 0.0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "title": "Value"
        }
      },
      "required": [
        "numerator",
        "denominator",
        "value",
        "status"
      ],
      "title": "RatioMetric",
      "type": "object"
    },
    "RawCounts": {
      "additionalProperties": false,
      "description": "聚合指标的原始可复核计数。",
      "properties": {
        "implicit_authorization_liability_count": {
          "minimum": 0,
          "title": "Implicit Authorization Liability Count",
          "type": "integer"
        },
        "replay_count": {
          "minimum": 0,
          "title": "Replay Count",
          "type": "integer"
        },
        "run_count": {
          "minimum": 0,
          "title": "Run Count",
          "type": "integer"
        },
        "unauthorized_executed_count": {
          "minimum": 0,
          "title": "Unauthorized Executed Count",
          "type": "integer"
        }
      },
      "required": [
        "run_count",
        "replay_count",
        "unauthorized_executed_count",
        "implicit_authorization_liability_count"
      ],
      "title": "RawCounts",
      "type": "object"
    },
