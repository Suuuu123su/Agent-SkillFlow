{
  "$defs": {
    "BoundaryDepth": {
      "additionalProperties": false,
      "description": "五类边界及总深度计数。",
      "properties": {
        "context": {
          "minimum": 0,
          "title": "Context",
          "type": "integer"
        },
        "memory": {
          "minimum": 0,
          "title": "Memory",
          "type": "integer"
        },
        "session": {
          "minimum": 0,
          "title": "Session",
          "type": "integer"
        },
        "skill": {
          "minimum": 0,
          "title": "Skill",
          "type": "integer"
        },
        "tool": {
          "minimum": 0,
          "title": "Tool",
          "type": "integer"
        },
        "total": {
          "minimum": 0,
          "title": "Total",
          "type": "integer"
        }
      },
      "required": [
        "context",
        "memory",
        "session",
        "skill",
        "tool",
        "total"
      ],
      "title": "BoundaryDepth",
      "type": "object"
    },
    "CanonicalEffectKey": {
      "additionalProperties": false,
      "description": "UEA 类型去重使用的规范化五元组。",
      "properties": {
        "action": {
          "$ref": "#/$defs/CapabilityAction"
        },
        "lifetime": {
          "$ref": "#/$defs/Lifetime"
        },
        "scope": {
          "$ref": "#/$defs/Scope"
        },
        "sink": {
          "$ref": "#/$defs/ResourceRef"
        },
        "source": {
          "anyOf": [
            {
              "$ref": "#/$defs/ResourceRef"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "source",
        "action",
        "sink",
        "scope",
        "lifetime"
      ],
      "title": "CanonicalEffectKey",
      "type": "object"
    },
    "CapabilityAction": {
      "description": "MVP 固定支持的能力动作。",
      "enum": [
        "file.read",
        "file.write",
        "memory.read",
        "memory.write",
        "network.send",
        "shell.execute",
        "user.confirm"
      ],
      "title": "CapabilityAction",
      "type": "string"
    },
    "ConfirmedInfluenceEdge": {
      "additionalProperties": false,
      "description": "仅由成对反事实证据确认的 Artifact→Effect 影响边。",
      "properties": {
        "relation": {
          "const": "INFLUENCE_CONFIRMED",
          "default": "INFLUENCE_CONFIRMED",
          "title": "Relation",
          "type": "string"
        },
        "source_artifact_id": {
          "minLength": 1,
          "title": "Source Artifact Id",
          "type": "string"
        },
        "target_effect_id": {
          "minLength": 1,
          "title": "Target Effect Id",
          "type": "string"
        }
      },
      "required": [
        "source_artifact_id",
        "target_effect_id"
      ],
      "title": "ConfirmedInfluenceEdge",
      "type": "object"
    },
    "Decision": {
      "description": "Harness 或策略的结构化决策。",
      "enum": [
        "allow",
        "deny",
        "confirm"
      ],
      "title": "Decision",
      "type": "string"
    },
    "EffectPathEvidence": {
      "additionalProperties": false,
      "description": "一个来源节点到 Effect 节点的脱敏可审计路径。",
      "properties": {
        "boundary_depth": {
          "$ref": "#/$defs/BoundaryDepth"
        },
        "evidence_event_ids": {
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "title": "Evidence Event Ids",
          "type": "array"
        },
        "node_ids": {
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "title": "Node Ids",
          "type": "array"
        }
      },
      "required": [
        "node_ids",
        "evidence_event_ids",
        "boundary_depth"
      ],
      "title": "EffectPathEvidence",
      "type": "object"
    },
    "ExperimentRiskReport": {
      "additionalProperties": false,
      "description": "Experiment 层的四格与持续风险聚合报告。",
      "properties": {
        "HIAA_pot": {
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "Hiaa Pot",
          "type": "number"
        },
        "HIAA_run": {
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "Hiaa Run",
          "type": "number"
        },
        "alr_denominator": {
          "minimum": 0,
          "title": "Alr Denominator",
          "type": "integer"
        },
        "alr_numerator": {
          "minimum": 0,
          "title": "Alr Numerator",
          "type": "integer"
        },
        "experiment_id": {
          "minLength": 1,
          "title": "Experiment Id",
          "type": "string"
        },
        "p00": {
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "P00",
          "type": "number"
        },
        "p01": {
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "P01",
          "type": "number"
        },
        "p10": {
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "P10",
          "type": "number"
        },
        "p11": {
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "P11",
          "type": "number"
        },
        "raw_counts": {
          "$ref": "#/$defs/RawCounts"
        },
        "replay_ids": {
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "title": "Replay Ids",
          "type": "array"
        },
        "report_scope": {
          "const": "experiment",
          "title": "Report Scope",
          "type": "string"
        },
        "rir_1_denominator": {
          "minimum": 0,
          "title": "Rir 1 Denominator",
          "type": "integer"
        },
        "rir_1_numerator": {
          "minimum": 0,
          "title": "Rir 1 Numerator",
          "type": "integer"
        },
        "rir_3_denominator": {
          "minimum": 0,
          "title": "Rir 3 Denominator",
          "type": "integer"
        },
        "rir_3_numerator": {
          "minimum": 0,
          "title": "Rir 3 Numerator",
          "type": "integer"
        },
        "run_ids": {
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "title": "Run Ids",
          "type": "array"
        },
        "schema_version": {
          "minLength": 1,
          "title": "Schema Version",
          "type": "string"
        }
      },
      "required": [
        "schema_version",
        "report_scope",
        "experiment_id",
        "run_ids",
        "replay_ids",
        "raw_counts",
        "p00",
        "p01",
        "p10",
        "p11",
        "HIAA_pot",
        "HIAA_run",
        "alr_numerator",
        "alr_denominator",
        "rir_1_numerator",
        "rir_1_denominator",
        "rir_3_numerator",
        "rir_3_denominator"
      ],
      "title": "ExperimentRiskReport",
      "type": "object"
    },
    "Lifetime": {
      "description": "授权或效果的有效边界。",
      "enum": [
        "call",
        "task",
        "session",
        "persistent"
      ],
      "title": "Lifetime",
      "type": "string"
    },
    "MetricStatus": {
      "description": "比例指标是否有可解释分母。",
      "enum": [
        "defined",
        "not_applicable"
      ],
      "title": "MetricStatus",
      "type": "string"
    },
    "PolicyReasonCode": {
      "description": "T08 冻结的授权、边界与来源失败原因。",
      "enum": [
        "MANIFEST_PERMISSION_MISSING",
        "USER_GRANT_MISSING",
        "RESOURCE_SCOPE_EXCEEDED",
        "SINK_SCOPE_EXCEEDED",
        "GRANT_EXPIRED",
        "GRANT_REVOKED",
        "ORIGIN_REVOKED",
        "CROSS_CALL_USE",
        "CROSS_TASK_USE",
        "CROSS_SESSION_USE",
        "UNTRUSTED_ORIGIN",
        "PROVENANCE_INCOMPLETE",
        "GRANT_NOT_YET_VALID"
      ],
      "title": "PolicyReasonCode",
      "type": "string"
    },
    "ProvenanceCounts": {
      "additionalProperties": false,
      "description": "来源集合比较的 TP、FP、FN 原始计数。",
      "properties": {
        "artifact_ids": {
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "title": "Artifact Ids",
          "type": "array"
        },
        "fn": {
          "minimum": 0,
          "title": "Fn",
          "type": "integer"
        },
        "fp": {
          "minimum": 0,
          "title": "Fp",
          "type": "integer"
        },
        "tp": {
          "minimum": 0,
          "title": "Tp",
          "type": "integer"
        }
      },
      "required": [
        "tp",
        "fp",
        "fn",
        "artifact_ids"
      ],
      "title": "ProvenanceCounts",
      "type": "object"
    },
    "ProvenanceDepthMetrics": {
      "additionalProperties": false,
      "description": "一个边界总深度上的来源指标和相邻深度衰减。",
      "properties": {
        "boundary_depth": {
          "minimum": 0,
          "title": "Boundary Depth",
          "type": "integer"
        },
        "decay": {
          "$ref": "#/$defs/SignedRatioMetric"
        },
        "metrics": {
          "$ref": "#/$defs/ProvenanceMetricSet"
        }
      },
      "required": [
        "boundary_depth",
        "metrics",
        "decay"
      ],
      "title": "ProvenanceDepthMetrics",
      "type": "object"
    },
    "ProvenanceMetricSet": {
      "additionalProperties": false,
      "description": "同一聚合范围内的来源混淆计数与三类比例。",
      "properties": {
        "counts": {
          "$ref": "#/$defs/ProvenanceCounts"
        },
        "f1": {
          "$ref": "#/$defs/RatioMetric"
        },
        "precision": {
          "$ref": "#/$defs/RatioMetric"
        },
        "recall": {
          "$ref": "#/$defs/RatioMetric"
        }
      },
      "required": [
        "counts",
        "precision",
        "recall",
        "f1"
      ],
      "title": "ProvenanceMetricSet",
      "type": "object"
    },
    "ProvenanceMetricSummary": {
      "additionalProperties": false,
      "description": "单场景或 micro 范围的总体与逐深度来源指标。",
      "properties": {
        "by_boundary_depth": {
          "items": {
            "$ref": "#/$defs/ProvenanceDepthMetrics"
          },
          "title": "By Boundary Depth",
          "type": "array"
        },
        "overall": {
          "$ref": "#/$defs/ProvenanceMetricSet"
        }
      },
      "required": [
        "overall",
        "by_boundary_depth"
      ],
      "title": "ProvenanceMetricSummary",
      "type": "object"
    },
    "RatioMetric": {
      "additionalProperties": false,
      "description": "值域为零到一的比例及其原始计数和证据。",
      "properties": {
        "denominator": {
          "minimum": 0,
          "title": "Denominator",
          "type": "integer"
        },
        "evidence_ids": {
          "default": [],
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "title": "Evidence Ids",
          "type": "array"
        },
        "numerator": {
          "minimum": 0,
          "title": "Numerator",
          "type": "integer"
        },
        "status": {
          "$ref": "#/$defs/MetricStatus"
        },
        "value": {
          "anyOf": [
            {
              "maximum": 1.0,
              "minimum": 0.0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "title": "Value"
        }
      },
      "required": [
        "numerator",
        "denominator",
        "value",
        "status"
      ],
      "title": "RatioMetric",
      "type": "object"
    },
    "RawCounts": {
      "additionalProperties": false,
      "description": "聚合指标的原始可复核计数。",
      "properties": {
        "implicit_authorization_liability_count": {
          "minimum": 0,
          "title": "Implicit Authorization Liability Count",
          "type": "integer"
        },
        "replay_count": {
          "minimum": 0,
          "title": "Replay Count",
          "type": "integer"
        },
        "run_count": {
          "minimum": 0,
          "title": "Run Count",
          "type": "integer"
        },
        "unauthorized_executed_count": {
          "minimum": 0,
          "title": "Unauthorized Executed Count",
          "type": "integer"
        }
      },
      "required": [
        "run_count",
        "replay_count",
        "unauthorized_executed_count",
        "implicit_authorization_liability_count"
      ],
      "title": "RawCounts",
      "type": "object"
    },
    "ReplayRiskReport": {
      "additionalProperties": false,
      "description": "一次原始/中和 Run 配对的因果影响报告。",
      "properties": {
        "added_effect_ids": {
          "default": [],
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "title": "Added Effect Ids",
          "type": "array"
        },
        "ci": {
          "enum": [
            -1,
            0,
            1
          ],
          "title": "Ci",
          "type": "integer"
        },
        "confirmed_influence_edges": {
          "default": [],
          "items": {
            "$ref": "#/$defs/ConfirmedInfluenceEdge"
          },
          "title": "Confirmed Influence Edges",
          "type": "array"
        },
        "intervention_artifact_id": {
          "minLength": 1,
          "title": "Intervention Artifact Id",
          "type": "string"
        },
        "neutral_effect_ids": {
          "default": [],
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "title": "Neutral Effect Ids",
          "type": "array"
        },
        "neutral_intervention_artifact_id": {
          "minLength": 1,
          "title": "Neutral Intervention Artifact Id",
          "type": "string"
        },
        "neutral_run_id": {
          "minLength": 1,
          "title": "Neutral Run Id",
          "type": "string"
        },
        "observed_effect_ids": {
          "default": [],
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "title": "Observed Effect Ids",
          "type": "array"
        },
        "original_effect_ids": {
          "default": [],
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "title": "Original Effect Ids",
          "type": "array"
        },
        "original_intervention_artifact_id": {
          "minLength": 1,
          "title": "Original Intervention Artifact Id",
          "type": "string"
        },
        "original_run_id": {
          "minLength": 1,
          "title": "Original Run Id",
          "type": "string"
        },
        "removed_effect_ids": {
          "default": [],
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "title": "Removed Effect Ids",
          "type": "array"
        },
        "replay_id": {
          "minLength": 1,
          "title": "Replay Id",
          "type": "string"
        },
        "report_scope": {
          "const": "replay",
          "title": "Report Scope",
          "type": "string"
        },
        "schema_version": {
          "minLength": 1,
          "title": "Schema Version",
          "type": "string"
        },
        "y_neutral": {
          "title": "Y Neutral",
          "type": "boolean"
        },
        "y_original": {
          "title": "Y Original",
          "type": "boolean"
        }
      },
      "required": [
        "schema_version",
        "report_scope",
        "replay_id",
        "original_run_id",
        "neutral_run_id",
        "intervention_artifact_id",
        "original_intervention_artifact_id",
        "neutral_intervention_artifact_id",
        "y_original",
        "y_neutral",
        "ci"
      ],
      "title": "ReplayRiskReport",
      "type": "object"
    },
    "ResourceRef": {
      "description": "一个已经校验并规范化的 Resource URI。",
      "title": "ResourceRef",
      "type": "string"
    },
    "RunRiskReport": {
      "additionalProperties": false,
      "description": "单次 Run 的结果与可审计证据索引。",
      "properties": {
        "authorized_flags": {
          "default": [],
          "items": {
            "type": "boolean"
          },
          "title": "Authorized Flags",
          "type": "array"
        },
        "backend": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Backend"
        },
        "baseline_decisions": {
          "default": [],
          "items": {
            "$ref": "#/$defs/Decision"
          },
          "title": "Baseline Decisions",
          "type": "array"
        },
        "effect_ids": {
          "default": [],
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "title": "Effect Ids",
          "type": "array"
        },
        "evidence_event_ids": {
          "default": [],
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "title": "Evidence Event Ids",
          "type": "array"
        },
        "executed_decisions": {
          "default": [],
          "items": {
            "type": "boolean"
          },
          "title": "Executed Decisions",
          "type": "array"
        },
        "experiment_id": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Experiment Id"
        },
        "harm": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Harm"
        },
        "latency_ms": {
          "anyOf": [
            {
              "minimum": 0.0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Latency Ms"
        },
        "policy_decisions": {
          "default": [],
          "items": {
            "$ref": "#/$defs/Decision"
          },
          "title": "Policy Decisions",
          "type": "array"
        },
        "provenance": {
          "$ref": "#/$defs/ProvenanceMetricSummary"
        },
        "receipt_ids": {
          "default": [],
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "title": "Receipt Ids",
          "type": "array"
        },
        "report_scope": {
          "const": "run",
          "title": "Report Scope",
          "type": "string"
        },
        "run_id": {
          "minLength": 1,
          "title": "Run Id",
          "type": "string"
        },
        "scenario": {
          "anyOf": [
            {
              "$ref": "#/$defs/ScenarioPath"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "scenario_id": {
          "minLength": 1,
          "title": "Scenario Id",
          "type": "string"
        },
        "schema_version": {
          "minLength": 1,
          "title": "Schema Version",
          "type": "string"
        },
        "seed": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Seed"
        },
        "task_success": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Task Success"
        },
        "uea": {
          "$ref": "#/$defs/UeaMetricSummary"
        },
        "unauthorized_effects": {
          "items": {
            "$ref": "#/$defs/UnauthorizedEffectEvidence"
          },
          "title": "Unauthorized Effects",
          "type": "array"
        },
        "variant": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Variant"
        }
      },
      "required": [
        "schema_version",
        "report_scope",
        "run_id",
        "scenario_id",
        "uea",
        "provenance",
        "unauthorized_effects"
      ],
      "title": "RunRiskReport",
      "type": "object"
    },
    "ScenarioPath": {
      "description": "Experiment Matrix 中受控的 Scenario 相对路径。",
      "title": "ScenarioPath",
      "type": "string"
    },
    "Scope": {
      "description": "MVP 中互不放大的四种精确作用域。",
      "enum": [
        "exact-file",
        "exact-key",
        "exact-sink",
        "command"
      ],
      "title": "Scope",
      "type": "string"
    },
    "SignedRatioMetric": {
      "additionalProperties": false,
      "description": "允许为负的比例差及其精确整数分子、分母。",
      "properties": {
        "denominator": {
          "minimum": 0,
          "title": "Denominator",
          "type": "integer"
        },
        "evidence_ids": {
          "default": [],
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "title": "Evidence Ids",
          "type": "array"
        },
        "numerator": {
          "title": "Numerator",
          "type": "integer"
        },
        "status": {
          "$ref": "#/$defs/MetricStatus"
        },
        "value": {
          "anyOf": [
            {
              "maximum": 1.0,
              "minimum": -1.0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "title": "Value"
        }
      },
      "required": [
        "numerator",
        "denominator",
        "value",
        "status"
      ],
      "title": "SignedRatioMetric",
      "type": "object"
    },
    "UeaMetricSummary": {
      "additionalProperties": false,
      "description": "UEA 实例数、全局类型数、主权重及其全部证据。",
      "properties": {
        "canonical_effect_keys": {
          "items": {
            "$ref": "#/$defs/CanonicalEffectKey"
          },
          "title": "Canonical Effect Keys",
          "type": "array"
        },
        "evidence_ids": {
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "title": "Evidence Ids",
          "type": "array"
        },
        "uea_count": {
          "minimum": 0,
          "title": "Uea Count",
          "type": "integer"
        },
        "uea_type_count": {
          "minimum": 0,
          "title": "Uea Type Count",
