{
  "$defs": {
    "PricingRates": {
      "additionalProperties": false,
      "description": "每百万 token 的美元估算价格。",
      "properties": {
        "cached_input_per_million_usd": {
          "anyOf": [
            {
              "minimum": 0.0,
              "type": "number"
            },
            {
              "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
              "type": "string"
            }
          ],
          "title": "Cached Input Per Million Usd"
        },
        "input_per_million_usd": {
          "anyOf": [
            {
              "minimum": 0.0,
              "type": "number"
            },
            {
              "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
              "type": "string"
            }
          ],
          "title": "Input Per Million Usd"
        },
        "output_per_million_usd": {
          "anyOf": [
            {
              "minimum": 0.0,
              "type": "number"
            },
            {
              "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
              "type": "string"
            }
          ],
          "title": "Output Per Million Usd"
        },
        "reasoning_per_million_usd": {
          "anyOf": [
            {
              "minimum": 0.0,
              "type": "number"
            },
            {
              "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
              "type": "string"
            }
          ],
          "title": "Reasoning Per Million Usd"
        },
        "status": {
          "$ref": "#/$defs/PricingStatus"
        }
      },
      "required": [
        "status",
        "input_per_million_usd",
        "cached_input_per_million_usd",
        "output_per_million_usd",
        "reasoning_per_million_usd"
      ],
      "title": "PricingRates",
      "type": "object"
    },
    "PricingStatus": {
      "description": "价格是否已冻结到可执行状态。",
      "enum": [
        "fake_zero",
        "live_pending",
        "live_pinned"
      ],
      "title": "PricingStatus",
      "type": "string"
    },
    "ProviderKind": {
      "description": "T16 允许的 Provider 类型。",
      "enum": [
        "fake",
        "live"
      ],
      "title": "ProviderKind",
      "type": "string"
    },
    "ReasoningEffort": {
      "description": "与具体厂商解耦的推理强度记录。",
      "enum": [
        "none",
        "low",
        "medium",
        "high"
      ],
      "title": "ReasoningEffort",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "description": "Fake/Live 共享的静态 Provider 配置。",
  "properties": {
    "kind": {
      "$ref": "#/$defs/ProviderKind"
    },
    "model_id": {
      "minLength": 1,
      "title": "Model Id",
      "type": "string"
    },
    "model_revision": {
      "minLength": 1,
      "title": "Model Revision",
      "type": "string"
    },
    "pricing": {
      "$ref": "#/$defs/PricingRates"
    },
    "reasoning_effort": {
      "$ref": "#/$defs/ReasoningEffort"
    },
    "schema_version": {
      "const": "0.1",
      "default": "0.1",
      "title": "Schema Version",
      "type": "string"
    },
    "temperature": {
      "maximum": 2,
      "minimum": 0,
      "title": "Temperature",
      "type": "number"
    }
  },
  "required": [
    "kind",
    "model_id",
    "model_revision",
    "temperature",
    "reasoning_effort",
    "pricing"
  ],
  "title": "ProviderConfig",
  "type": "object"
}
