{
  "$defs": {
    "AttackDiagnosis": {
      "additionalProperties": false,
      "description": "置信等级是规则的证据充分性，不是假造的概率。",
      "properties": {
        "abstain": {
          "title": "Abstain",
          "type": "boolean"
        },
        "confidence": {
          "enum": [
            "high",
            "medium",
            "low"
          ],
          "title": "Confidence",
          "type": "string"
        },
        "diagnosis_id": {
          "minLength": 1,
          "title": "Diagnosis Id",
          "type": "string"
        },
        "evidence_ids": {
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "title": "Evidence Ids",
          "type": "array"
        },
        "mechanisms": {
          "items": {
            "enum": [
              "privilege",
              "context-tool",
              "memory",
              "authorization"
            ],
            "type": "string"
          },
          "title": "Mechanisms",
          "type": "array"
        },
        "missing_evidence": {
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "title": "Missing Evidence",
          "type": "array"
        },
        "schema_version": {
          "const": "18.0",
          "default": "18.0",
          "title": "Schema Version",
          "type": "string"
        }
      },
      "required": [
        "diagnosis_id",
        "mechanisms",
        "confidence",
        "abstain",
        "evidence_ids",
        "missing_evidence"
      ],
      "title": "AttackDiagnosis",
      "type": "object"
    },
    "AttackSignalVector": {
      "additionalProperties": false,
      "description": "一次工具请求的可信事实；模式、文件名与攻击标签均不在输入面。",
      "properties": {
        "authorization_claim_in_basis": {
          "title": "Authorization Claim In Basis",
          "type": "boolean"
        },
        "candidate_influence": {
          "title": "Candidate Influence",
          "type": "boolean"
        },
        "confirmed_influence": {
          "title": "Confirmed Influence",
          "type": "boolean"
        },
        "cross_session_memory_path": {
          "title": "Cross Session Memory Path",
          "type": "boolean"
        },
        "evidence_availability": {
          "additionalProperties": {
            "type": "boolean"
          },
          "propertyNames": {
            "minLength": 1
          },
          "title": "Evidence Availability",
          "type": "object"
        },
        "evidence_ids": {
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "minItems": 1,
          "title": "Evidence Ids",
          "type": "array"
        },
        "grant_missing": {
          "title": "Grant Missing",
          "type": "boolean"
        },
        "lifetime_mismatch": {
          "title": "Lifetime Mismatch",
          "type": "boolean"
        },
        "receipt_present": {
          "title": "Receipt Present",
          "type": "boolean"
        },
        "request_event_id": {
          "minLength": 1,
          "title": "Request Event Id",
          "type": "string"
        },
        "revoked_origin": {
          "title": "Revoked Origin",
          "type": "boolean"
        },
        "run_id": {
          "minLength": 1,
          "title": "Run Id",
          "type": "string"
        },
        "schema_version": {
          "const": "18.0",
          "default": "18.0",
          "title": "Schema Version",
          "type": "string"
        },
        "scope_mismatch": {
          "title": "Scope Mismatch",
          "type": "boolean"
        },
        "session_id": {
          "minLength": 1,
          "title": "Session Id",
          "type": "string"
        },
        "signal_evidence": {
          "additionalProperties": {
            "items": {
              "minLength": 1,
              "type": "string"
            },
            "type": "array"
          },
          "propertyNames": {
            "minLength": 1
          },
          "title": "Signal Evidence",
          "type": "object"
        },
        "sink_severity": {
          "maximum": 4,
          "minimum": 0,
          "title": "Sink Severity",
          "type": "integer"
        },
        "target_effect_executed": {
          "title": "Target Effect Executed",
          "type": "boolean"
        },
        "target_effect_requested": {
          "title": "Target Effect Requested",
          "type": "boolean"
        },
        "untrusted_context_in_basis": {
          "title": "Untrusted Context In Basis",
          "type": "boolean"
        },
        "untrusted_tool_return_in_basis": {
          "title": "Untrusted Tool Return In Basis",
          "type": "boolean"
        }
      },
      "required": [
        "run_id",
        "session_id",
        "request_event_id",
        "grant_missing",
        "scope_mismatch",
        "lifetime_mismatch",
        "revoked_origin",
        "untrusted_context_in_basis",
        "untrusted_tool_return_in_basis",
        "cross_session_memory_path",
        "authorization_claim_in_basis",
        "candidate_influence",
        "confirmed_influence",
        "target_effect_requested",
        "target_effect_executed",
        "receipt_present",
        "sink_severity",
        "evidence_availability",
        "evidence_ids"
      ],
      "title": "AttackSignalVector",
      "type": "object"
    },
    "CausalAssessment": {
      "additionalProperties": false,
      "description": "由真实隔离重放形成的结果；未评估时不允许带数值。",
      "properties": {
        "ci": {
          "anyOf": [
            {
              "enum": [
                -1,
                0,
                1
              ],
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Ci"
        },
        "evidence_ids": {
          "default": [],
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "title": "Evidence Ids",
          "type": "array"
        },
        "pair_id": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Pair Id"
        },
        "reason": {
          "minLength": 1,
          "title": "Reason",
          "type": "string"
        },
        "status": {
          "enum": [
            "measured",
            "not_applicable",
            "not_available",
            "incomplete"
          ],
          "title": "Status",
          "type": "string"
        },
        "y_neutral": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Y Neutral"
        },
        "y_original": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Y Original"
        }
      },
      "required": [
        "status",
        "reason"
      ],
      "title": "CausalAssessment",
      "type": "object"
    },
    "DefensePlan": {
      "additionalProperties": false,
      "description": "防御选择只可收紧执行，不签发或修改授权。",
      "properties": {
        "action": {
          "enum": [
            "allow",
            "deny",
            "confirm",
            "quarantine",
            "replay_then_decide"
          ],
          "title": "Action",
          "type": "string"
        },
        "estimated_extra_steps": {
          "minimum": 0,
          "title": "Estimated Extra Steps",
          "type": "integer"
        },
        "evidence_ids": {
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "title": "Evidence Ids",
          "type": "array"
        },
        "plan_id": {
          "minLength": 1,
          "title": "Plan Id",
          "type": "string"
        },
        "schema_version": {
          "const": "18.0",
          "default": "18.0",
          "title": "Schema Version",
          "type": "string"
        },
        "selected_defense_ids": {
          "items": {
            "enum": [
              "task-alignment",
              "tdg",
              "drift-isolation",
              "causal"
            ],
            "type": "string"
          },
          "title": "Selected Defense Ids",
          "type": "array"
        },
        "selection_reason_codes": {
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "title": "Selection Reason Codes",
          "type": "array"
        }
      },
      "required": [
        "plan_id",
        "selected_defense_ids",
        "action",
        "evidence_ids",
        "selection_reason_codes",
        "estimated_extra_steps"
      ],
      "title": "DefensePlan",
      "type": "object"
    },
    "GateResult": {
      "additionalProperties": false,
      "description": "一个组件的实际判断及执行开销。",
      "properties": {
        "abstain": {
          "default": false,
          "title": "Abstain",
          "type": "boolean"
        },
        "action": {
          "enum": [
            "allow",
            "deny",
            "confirm",
            "quarantine",
            "replay_then_decide"
          ],
          "title": "Action",
          "type": "string"
        },
        "evidence_ids": {
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "title": "Evidence Ids",
          "type": "array"
        },
        "extra_steps": {
          "default": 1,
          "minimum": 0,
          "title": "Extra Steps",
          "type": "integer"
        },
        "reason": {
          "minLength": 1,
          "title": "Reason",
          "type": "string"
        }
      },
      "required": [
        "action",
        "reason",
        "evidence_ids"
      ],
      "title": "GateResult",
      "type": "object"
    },
    "QuarantineEntry": {
      "additionalProperties": false,
      "description": "记忆键和来源证据的追加隔离记录，不替换授权或数据事实。",
      "properties": {
        "memory_key": {
          "minLength": 1,
          "title": "Memory Key",
          "type": "string"
        },
        "reason": {
          "minLength": 1,
          "title": "Reason",
          "type": "string"
        },
        "request_event_id": {
          "minLength": 1,
          "title": "Request Event Id",
          "type": "string"
        },
        "run_id": {
          "minLength": 1,
          "title": "Run Id",
          "type": "string"
        },
        "source_artifact_ids": {
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "title": "Source Artifact Ids",
          "type": "array"
        }
      },
      "required": [
        "run_id",
        "memory_key",
        "request_event_id",
        "source_artifact_ids",
        "reason"
      ],
      "title": "QuarantineEntry",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "一次请求的实际判断链；最终操作事实另从事件库和回执提取。",
  "properties": {
    "base_authorized": {
      "title": "Base Authorized",
      "type": "boolean"
    },
    "base_executed": {
      "title": "Base Executed",
      "type": "boolean"
    },
    "causal": {
      "anyOf": [
        {
          "$ref": "#/$defs/CausalAssessment"
        },
        {
          "type": "null"
        }
      ]
    },
    "diagnosis": {
      "$ref": "#/$defs/AttackDiagnosis"
    },
    "extra_steps": {
      "title": "Extra Steps",
      "type": "integer"
    },
    "final_authorized": {
      "title": "Final Authorized",
      "type": "boolean"
    },
    "final_executed": {
      "title": "Final Executed",
      "type": "boolean"
    },
    "gates": {
      "items": {
        "$ref": "#/$defs/GateResult"
      },
      "title": "Gates",
      "type": "array"
    },
    "latency_ms": {
      "title": "Latency Ms",
      "type": "number"
    },
    "proposed_plan": {
      "$ref": "#/$defs/DefensePlan"
    },
    "quarantine": {
      "items": {
        "$ref": "#/$defs/QuarantineEntry"
      },
      "title": "Quarantine",
      "type": "array"
    },
    "request_event_id": {
      "minLength": 1,
      "title": "Request Event Id",
      "type": "string"
    },
    "run_id": {
      "minLength": 1,
      "title": "Run Id",
      "type": "string"
    },
    "selected": {
      "items": {
        "enum": [
          "task-alignment",
          "tdg",
          "drift-isolation",
          "causal"
        ],
        "type": "string"
      },
      "title": "Selected",
      "type": "array"
    },
    "signals": {
      "$ref": "#/$defs/AttackSignalVector"
    }
  },
  "required": [
    "run_id",
    "request_event_id",
    "signals",
    "diagnosis",
    "proposed_plan",
    "selected",
    "gates",
    "causal",
    "base_authorized",
    "final_authorized",
    "base_executed",
    "final_executed",
    "extra_steps",
    "latency_ms",
    "quarantine"
  ],
  "title": "DefenseTrace",
  "type": "object"
}
