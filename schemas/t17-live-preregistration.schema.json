{
  "$defs": {
    "BudgetConfig": {
      "additionalProperties": false,
      "description": "可生成静态 Schema 的费用保护配置。",
      "properties": {
        "allow_live": {
          "default": false,
          "title": "Allow Live",
          "type": "boolean"
        },
        "max_agent_turns": {
          "minimum": 1,
          "title": "Max Agent Turns",
          "type": "integer"
        },
        "max_cost_per_run_usd": {
          "anyOf": [
            {
              "exclusiveMinimum": 0.0,
              "type": "number"
            },
            {
              "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
              "type": "string"
            }
          ],
          "title": "Max Cost Per Run Usd"
        },
        "max_output_tokens_per_turn": {
          "minimum": 1,
          "title": "Max Output Tokens Per Turn",
          "type": "integer"
        },
        "max_retries": {
          "minimum": 0,
          "title": "Max Retries",
          "type": "integer"
        },
        "max_total_usd": {
          "anyOf": [
            {
              "exclusiveMinimum": 0.0,
              "type": "number"
            },
            {
              "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
              "type": "string"
            }
          ],
          "title": "Max Total Usd"
        },
        "schema_version": {
          "const": "0.1",
          "default": "0.1",
          "title": "Schema Version",
          "type": "string"
        }
      },
      "required": [
        "max_total_usd",
        "max_cost_per_run_usd",
        "max_agent_turns",
        "max_output_tokens_per_turn",
        "max_retries"
      ],
      "title": "BudgetConfig",
      "type": "object"
    },
    "PricingRates": {
      "additionalProperties": false,
      "description": "每百万 token 的美元估算价格。",
      "properties": {
        "cache_write_per_million_usd": {
          "anyOf": [
            {
              "minimum": 0.0,
              "type": "number"
            },
            {
              "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
              "type": "string"
            }
          ],
          "default": "0",
          "title": "Cache Write Per Million Usd"
        },
        "cached_input_per_million_usd": {
          "anyOf": [
            {
              "minimum": 0.0,
              "type": "number"
            },
            {
              "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
              "type": "string"
            }
          ],
          "title": "Cached Input Per Million Usd"
        },
        "input_per_million_usd": {
          "anyOf": [
            {
              "minimum": 0.0,
              "type": "number"
            },
            {
              "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
              "type": "string"
            }
          ],
          "title": "Input Per Million Usd"
        },
        "output_per_million_usd": {
          "anyOf": [
            {
              "minimum": 0.0,
              "type": "number"
            },
            {
              "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
              "type": "string"
            }
          ],
          "title": "Output Per Million Usd"
        },
        "reasoning_per_million_usd": {
          "anyOf": [
            {
              "minimum": 0.0,
              "type": "number"
            },
            {
              "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
              "type": "string"
            }
          ],
          "title": "Reasoning Per Million Usd"
        },
        "status": {
          "$ref": "#/$defs/PricingStatus"
        }
      },
      "required": [
        "status",
        "input_per_million_usd",
        "cached_input_per_million_usd",
        "output_per_million_usd",
        "reasoning_per_million_usd"
      ],
      "title": "PricingRates",
      "type": "object"
    },
    "PricingStatus": {
      "description": "价格是否已冻结到可执行状态。",
      "enum": [
        "fake_zero",
        "live_pending",
        "live_pinned"
      ],
      "title": "PricingStatus",
      "type": "string"
    },
    "ProviderConfig": {
      "additionalProperties": false,
      "description": "Fake/Live 共享的静态 Provider 配置。",
      "properties": {
        "kind": {
          "$ref": "#/$defs/ProviderKind"
        },
        "model_id": {
          "minLength": 1,
          "title": "Model Id",
          "type": "string"
        },
        "model_revision": {
          "minLength": 1,
          "title": "Model Revision",
          "type": "string"
        },
        "pricing": {
          "$ref": "#/$defs/PricingRates"
        },
        "reasoning_effort": {
          "$ref": "#/$defs/ReasoningEffort"
        },
        "schema_version": {
          "const": "0.1",
          "default": "0.1",
          "title": "Schema Version",
          "type": "string"
        },
        "temperature": {
          "anyOf": [
            {
              "maximum": 2,
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "title": "Temperature"
        }
      },
      "required": [
        "kind",
        "model_id",
        "model_revision",
        "temperature",
        "reasoning_effort",
        "pricing"
      ],
      "title": "ProviderConfig",
      "type": "object"
    },
    "ProviderKind": {
      "description": "T16 允许的 Provider 类型。",
      "enum": [
        "fake",
        "live"
      ],
      "title": "ProviderKind",
      "type": "string"
    },
    "ReasoningEffort": {
      "description": "与具体厂商解耦的推理强度记录。",
      "enum": [
        "none",
        "low",
        "medium",
        "high"
      ],
      "title": "ReasoningEffort",
      "type": "string"
    },
    "T17SemanticTemplate": {
      "additionalProperties": false,
      "description": "保持任务含义不变的固定提示前缀。",
      "properties": {
        "prefix": {
          "minLength": 1,
          "title": "Prefix",
          "type": "string"
        },
        "template_id": {
          "minLength": 1,
          "title": "Template Id",
          "type": "string"
        }
      },
      "required": [
        "template_id",
        "prefix"
      ],
      "title": "T17SemanticTemplate",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "T17-E/F/G 的模型、样本、统计和默认关闭预算。",
  "properties": {
    "bootstrap_resamples": {
      "const": 10000,
      "default": 10000,
      "title": "Bootstrap Resamples",
      "type": "integer"
    },
    "bootstrap_seed": {
      "const": 17017,
      "default": 17017,
      "title": "Bootstrap Seed",
      "type": "integer"
    },
    "defense_budget": {
      "$ref": "#/$defs/BudgetConfig"
    },
    "id": {
      "minLength": 1,
      "title": "Id",
      "type": "string"
    },
    "model1_budget": {
      "$ref": "#/$defs/BudgetConfig"
    },
    "model1_full_budget": {
      "$ref": "#/$defs/BudgetConfig"
    },
    "model1_prompt_cache_mode": {
      "const": "explicit",
      "default": "explicit",
      "title": "Model1 Prompt Cache Mode",
      "type": "string"
    },
    "model1_provider": {
      "$ref": "#/$defs/ProviderConfig"
    },
    "model2_budget": {
      "$ref": "#/$defs/BudgetConfig"
    },
    "model2_full_budget": {
      "$ref": "#/$defs/BudgetConfig"
    },
    "model2_prompt_cache_mode": {
      "const": "automatic",
      "default": "automatic",
      "title": "Model2 Prompt Cache Mode",
      "type": "string"
    },
    "model2_provider": {
      "$ref": "#/$defs/ProviderConfig"
    },
    "repeats_per_instance": {
      "const": 3,
      "default": 3,
      "title": "Repeats Per Instance",
      "type": "integer"
    },
    "scenario_registry_id": {
      "minLength": 1,
      "title": "Scenario Registry Id",
      "type": "string"
    },
    "schema_version": {
      "const": "0.1",
      "default": "0.1",
      "title": "Schema Version",
      "type": "string"
    },
    "semantic_templates": {
      "items": {
        "$ref": "#/$defs/T17SemanticTemplate"
      },
      "maxItems": 5,
      "minItems": 5,
      "title": "Semantic Templates",
      "type": "array"
    }
  },
  "required": [
    "id",
    "scenario_registry_id",
    "semantic_templates",
    "model1_provider",
    "model2_provider",
    "model1_budget",
    "model2_budget",
    "model1_full_budget",
    "model2_full_budget",
    "defense_budget"
  ],
  "title": "T17LivePreregistration",
  "type": "object"
}
